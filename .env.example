# ==============================================================================
# PulseBill Telecom Core Engine Environment Configuration
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3001
APP_NAME=PulseBill
APP_URL=http://localhost:3001
SESSION_SECRET=change_this_to_a_secure_random_string_32_chars

# Database Configuration (SQLite / MySQL)
DB_DIALECT=sqlite
DB_STORAGE=./data/pulsebill.db
# For MySQL:
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=pulsebill_db
# DB_USER=pulsebill_user
# DB_PASSWORD=your_secure_db_password

# Redis Cache & Background Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mikrotik RouterOS Core Gateway API
MIKROTIK_HOST=192.168.1.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=your_mikrotik_api_password
MIKROTIK_MAIN_INTERFACE=ether1-WAN
MIKROTIK_ISOLIR_PROFILE=isolir
MIKROTIK_ISOLIR_POOL=pool-isolir

# TR-069 GenieACS Integration
GENIEACS_URL=http://localhost:7557
GENIEACS_USER=admin
GENIEACS_PASSWORD=your_genieacs_password

# Payment Gateways (Stripe, Midtrans, Xendit, Tripay)
# Stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-placeholder
MIDTRANS_CLIENT_KEY=SB-Mid-client-placeholder
MIDTRANS_MERCHANT_ID=G_placeholder
MIDTRANS_IS_PRODUCTION=false

# Xendit
XENDIT_API_KEY=xnd_development_placeholder
XENDIT_WEBHOOK_TOKEN=xnd_callback_token_placeholder

# Tripay
TRIPAY_API_KEY=tripay_api_key_placeholder
TRIPAY_PRIVATE_KEY=tripay_private_key_placeholder
TRIPAY_MERCHANT_CODE=T00000
TRIPAY_IS_PRODUCTION=false

# Event & Notification Gateway
WHATSAPP_SESSION_PATH=./whatsapp-session
ADMIN_NOTIFICATION_NUMBER=+15550192834
NOC_SUPPORT_PHONE=+15550192834
