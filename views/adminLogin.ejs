<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Gembok Radius Infrastructure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        /* Konfigurasi Tema Seragam */
        :root {
            --bg-overlay: rgba(240, 242, 245, 0.85); 
            --card-bg: #ffffff;
            --text-main: #333333;
            --input-bg: #f8f9fa;
            --border-purple: #6f42c1;
        }

        [data-theme="dark"] {
            --bg-overlay: rgba(15, 23, 42, 0.9); 
            --card-bg: #1e293b;
            --text-main: #f1f5f9;
            --input-bg: #0f172a;
            --border-purple: #a855f7; /* Ungu lebih terang untuk dark mode */
        }

        body { 
            background-image: url('/img/bg-login.jpg'); 
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            transition: all 0.5s ease;
        }

        .overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: var(--bg-overlay);
            z-index: 1;
            transition: all 0.5s ease;
        }

        /* KARTU LOGIN DENGAN PEMBATAS UNGU */
        .login-card {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 420px;
            background: var(--card-bg);
            padding: 45px 30px;
            border: 2px solid var(--border-purple); 
            border-radius: 30px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
            text-align: center;
            transition: all 0.5s ease;
        }

        /* Logo Bulat Pop-Out */
        .logo-box {
            width: 130px;
            height: 130px;
            background: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: -110px auto 30px; 
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            border: 6px solid white;
            z-index: 5;
        }

        .logo-box img { width: 80%; height: auto; }

        /* Tombol Ganti Tema */
        .theme-toggle {
            position: absolute; top: 20px; right: 25px;
            cursor: pointer; font-size: 1.3rem; color: var(--text-main);
            opacity: 0.6; transition: 0.3s;
        }
        .theme-toggle:hover { opacity: 1; transform: rotate(15deg); }

        /* Input Group Seragam */
        .input-group-custom {
            background: var(--input-bg);
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 15px;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            padding: 12px 20px;
            transition: 0.3s;
        }

        .input-group-custom:focus-within {
            border-color: var(--border-purple);
            box-shadow: 0 0 0 4px rgba(111, 66, 193, 0.1);
        }

        .input-group-custom i { color: var(--border-purple); font-size: 1.2rem; margin-right: 15px; }

        .input-group-custom input {
            border: none; outline: none; width: 100%;
            background: transparent; color: var(--text-main); font-size: 16px;
        }

        /* Tombol Ungu */
        .btn-purple {
            background-color: var(--border-purple);
            color: white; border: none; border-radius: 12px;
            padding: 15px; width: 100%; font-size: 17px;
            font-weight: 700; text-transform: uppercase;
            letter-spacing: 1px; transition: 0.3s;
        }

        .btn-purple:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(111, 66, 193, 0.3);
        }

        .footer-text { margin-top: 25px; font-size: 12px; color: var(--text-main); opacity: 0.6; }
    </style>
</head>
<body data-theme="grey">
    <div class="overlay"></div>

    <div class="login-card">
        <div class="theme-toggle" onclick="switchTheme()">
            <i id="theme-icon" class="bi bi-moon-stars-fill"></i>
        </div>

        <div class="logo-box">
            <img src="/img/<%= (settings && settings.logo_filename) ? settings.logo_filename : 'logo.png' %>" alt="Logo">
        </div>

        <h4 class="fw-bold mb-4" style="color: var(--text-main);">ADMIN LOGIN</h4>

        <form id="loginForm">
            <div class="input-group-custom">
                <i class="bi bi-person-badge-fill"></i>
                <input type="text" id="username" name="username" placeholder="Username Admin" required autofocus>
            </div>

            <div class="input-group-custom">
                <i class="bi bi-shield-lock-fill"></i>
                <input type="password" id="password" name="password" placeholder="Password" required>
            </div>

            <button type="submit" class="btn-purple" id="loginBtn">
                <span class="btn-text">MASUK SISTEM</span>
                <span class="spinner-border spinner-border-sm d-none" id="loadingIcon"></span>
            </button>
        </form>

        <div class="footer-text">
            &copy; <%= new Date().getFullYear() %> <strong>PULSEBILL NETWORKS</strong><br>
            Radius Management v3.0
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script>
        // --- LOGIKA TEMA (SAMA DENGAN SEBELUMNYA) ---
        const savedTheme = localStorage.getItem('admin-theme') || 'grey';
        document.body.setAttribute('data-theme', savedTheme);
        updateIcon(savedTheme);

        function switchTheme() {
            let theme = document.body.getAttribute('data-theme');
            let newTheme = (theme === 'grey') ? 'dark' : 'grey';
            document.body.setAttribute('data-theme', newTheme);
            localStorage.setItem('admin-theme', newTheme);
            updateIcon(newTheme);
        }

        function updateIcon(theme) {
            const icon = document.getElementById('theme-icon');
            if(theme === 'dark') {
                icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
            } else {
                icon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
            }
        }

        // --- AJAX LOGIN (REAL & BERSIH) ---
        $('#loginForm').on('submit', function(e) {
            e.preventDefault();
            const $btn = $('#loginBtn');
            $btn.prop('disabled', true);
            $('.btn-text').addClass('d-none');
            $('#loadingIcon').removeClass('d-none');

            $.ajax({
                url: '/admin/login',
                method: 'POST',
                data: $(this).serialize(),
                success: function(res) {
                    window.location.href = '/admin/dashboard';
                },
                error: function(xhr) {
                    alert(xhr.responseJSON?.message || 'Akses Ditolak!');
                    $btn.prop('disabled', false);
                    $('.btn-text').removeClass('d-none');
                    $('#loadingIcon').addClass('d-none');
                }
            });
        });
    </script>
</body>
</html>