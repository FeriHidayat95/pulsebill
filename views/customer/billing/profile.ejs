<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %> - <%= appSettings.companyHeader %></title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
    :root {
      --primary-color: #4361ee;
      --secondary-color: #3f37c9;
      --accent-color: #4895ef;
      --success-color: #10b981;
      --card-border-radius: 20px;
      --transition-speed: 0.3s;
      --bg-color: #f8f9fa;
      --surface-color: #ffffff;
      --text-main: #212529;
      --text-muted: #6c757d;
      --border-color: rgba(0,0,0,0.08);
      font-family: 'Inter', sans-serif;
    }

    [data-bs-theme="dark"] {
      --bg-color: #0f172a;
      --surface-color: #1e293b;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --border-color: rgba(255,255,255,0.1);
      --primary-color: #3b82f6;
    }

    body { background-color: var(--bg-color); color: var(--text-main); font-family: var(--font-family); transition: background-color 0.3s ease; }
    
    /* Desktop Styles */
    .desktop-layout .navbar { background: rgba(var(--surface-color), 0.9) !important; backdrop-filter: blur(10px); border-bottom: 1px solid var(--border-color); box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
    .desktop-layout .navbar-brand { font-weight: 800; color: var(--primary-color) !important; }
    .desktop-layout .card { background-color: var(--surface-color); border: 1px solid var(--border-color); border-radius: var(--card-border-radius); box-shadow: 0 10px 30px rgba(0,0,0,0.02); transition: all var(--transition-speed); margin-bottom: 25px; }
    .desktop-layout .card-header-gradient { background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); color: white; border: none; padding: 20px 25px; }
    .desktop-layout .profile-avatar-desk { width: 80px; height: 80px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); display: flex; align-items: center; justify-content: center; font-size: 36px; color: white; margin: -60px auto 20px auto; border: 4px solid var(--surface-color); box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
    .desktop-layout .info-row { border-bottom: 1px solid var(--border-color); padding: 15px 0; }
    .desktop-layout .info-row:last-child { border-bottom: none; }

    /* ========================================== */
    /* MASTER STYLE KHUSUS MOBILE APP             */
    /* ========================================== */
    @media (max-width: 767.98px) {
        /* KUNCI LAYAR ANTI BOCOR SAMPING */
        html, body {
            overflow-x: hidden !important; 
            width: 100% !important;
            max-width: 100vw !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        body { padding-bottom: 90px; min-height: 100vh; }
        html[data-bs-theme="dark"] body { background: #1e1e2d !important; }
        html[data-bs-theme="light"] body { background: #f9fbfd !important; }
        
        .mobile-layout { 
            color: var(--text-main); 
            width: 100% !important;
            max-width: 100vw !important;
            box-sizing: border-box !important;
            overflow-x: hidden !important;
        }
        .mobile-layout[data-theme="dark"] { background: #1e1e2d !important; color: #f8fafc; --card-bg: #2a2a3c; --border-color: #3b3b54; --text-muted: #a1a1aa; }
        .mobile-layout[data-theme="light"] { --card-bg: #ffffff; --border-color: #f1f5f9; --text-muted: #64748b; }
        
        .mob-top-footer { display: none !important; }
        
        /* HEADER MELAYANG (STICKY) */
        .mob-header { 
            position: sticky !important; 
            top: 0; 
            left: 0;
            width: 100%;
            z-index: 1020; 
            padding: 15px 20px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            background-color: #f9fbfd; 
            box-sizing: border-box !important;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03); 
            transition: background-color 0.3s ease;
            margin-bottom: 10px; /* Dikecilin dikit biar gradien ungu nyambung rapi */
        }

        html[data-bs-theme="dark"] .mob-header,
        .mobile-layout[data-theme="dark"] .mob-header {
            background-color: #1e1e2d !important;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }

        .mob-wifi-icon { background: var(--card-bg); color: #4361ee; border-radius: 12px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 4px 15px rgba(67, 97, 238, 0.15); border: 1px solid var(--border-color); }
        
        /* Elemen Spesifik Profil */
        .mob-profile-header { background: linear-gradient(135deg, #4361ee 0%, #7209b7 100%); padding: 40px 20px 60px 20px; border-radius: 20px; margin: 0 20px; position: relative; text-align: center; color: white; box-shadow: 0 10px 25px rgba(67, 97, 238, 0.2); overflow: hidden; }
        .mob-profile-header::after { content: ''; position: absolute; left: -20px; top: -20px; width: 100px; height: 100px; background: rgba(255,255,255,0.1); border-radius: 50%; }
        
        .mob-profile-card { background: var(--card-bg); border-radius: 20px; padding: 25px 20px; margin: -40px 30px 20px 30px; position: relative; z-index: 10; box-shadow: 0 5px 20px rgba(0,0,0,0.05); border: 1px solid var(--border-color); }
        .mob-avatar { width: 70px; height: 70px; border-radius: 50%; background: linear-gradient(135deg, #f72585, #4361ee); display: flex; align-items: center; justify-content: center; font-size: 30px; color: white; margin: -60px auto 15px auto; border: 4px solid var(--card-bg); box-shadow: 0 5px 15px rgba(0,0,0,0.1); transition: border-color 0.3s ease; }
        
        .mob-info-item { display: flex; align-items: flex-start; gap: 15px; padding: 15px 0; border-bottom: 1px solid var(--border-color); }
        .mob-info-item:last-child { border-bottom: none; padding-bottom: 5px; }
        .mob-info-icon { background: rgba(67, 97, 238, 0.08); color: #4361ee; width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
        html[data-bs-theme="dark"] .mob-info-icon { background: rgba(67, 97, 238, 0.2); }
        
        /* Bottom Nav */
        .mob-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: var(--card-bg); display: flex; justify-content: space-around; align-items: center; padding: 10px 5px 15px 5px; box-shadow: 0 -5px 25px rgba(0,0,0,0.05); z-index: 1000; border-top: 1px solid var(--border-color); }
        .mob-nav-item { display: flex; flex-direction: column; align-items: center; color: var(--text-muted); font-size: 10px; text-decoration: none; flex: 1; font-weight: 500; transition: color 0.3s; }
        .mob-nav-item.active { color: #4361ee; font-weight: 700; }
        .mob-nav-fab { background: linear-gradient(135deg, #4361ee 0%, #3f37c9 100%); color: white; width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; transform: translateY(-22px); box-shadow: 0 8px 20px rgba(67, 97, 238, 0.4); border: 5px solid #f9fbfd; transition: border-color 0.3s ease; }
        .mobile-layout[data-theme="dark"] .mob-nav-fab { border-color: #1e1e2d; }
    }
    </style>
</head>
<body>

  <div class="desktop-layout d-none d-md-block">
    <nav class="navbar navbar-expand-lg shadow-sm">
      <div class="container d-flex justify-content-between align-items-center py-1">
        <span class="navbar-brand">
          <i class="bi bi-wifi me-2"></i>
          <span class="ms-1"><%= typeof settings !== 'undefined' && settings.companyHeader ? settings.companyHeader : 'Portal Pelanggan' %></span>
        </span>
        <div class="d-flex align-items-center gap-2">
          <button class="btn btn-outline-secondary btn-sm" onclick="toggleTheme()" style="border-radius: 10px; width: 36px; height: 36px;" title="Ganti Mode">
              <i class="bi bi-moon-stars-fill" id="themeIconDesk"></i>
          </button>
          <a href="/customer/dashboard" class="btn btn-outline-primary btn-sm" style="border-radius: 10px;">
            <i class="bi bi-house me-1"></i> Dashboard
          </a>
          <form method="POST" action="/customer/logout" class="d-inline m-0">
            <button type="submit" class="btn btn-danger btn-sm" style="border-radius: 10px; width: 36px; height: 36px;" title="Logout">
              <i class="bi bi-box-arrow-right fs-6"></i>
            </button>
          </form>
        </div>
      </div>
    </nav>

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-7">
                <div class="card border-0 mt-4">
                    <div class="card-header-gradient rounded-top text-center pb-5">
                        <h5 class="mb-0 fw-bold" style="position: relative; z-index: 2;">Profil Pelanggan</h5>
                    </div>
                    <div class="card-body p-4 p-md-5 pt-0">
                        <div class="profile-avatar-desk">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <h4 class="text-center fw-bold mb-1"><%= customer.name %></h4>
                        <p class="text-center text-muted mb-4">Member / Klien</p>

                        <div class="info-row d-flex justify-content-between align-items-center">
                            <div class="text-muted"><i class="bi bi-fingerprint me-2"></i>Username</div>
                            <div class="fw-bold"><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6"><%= customer.username %></span></div>
                        </div>
                        <div class="info-row d-flex justify-content-between align-items-center">
                            <div class="text-muted"><i class="bi bi-whatsapp me-2"></i>Nomor WhatsApp</div>
                            <div class="fw-semibold"><%= customer.phone %></div>
                        </div>
                        <div class="info-row d-flex flex-column align-items-start">
                            <div class="text-muted mb-2"><i class="bi bi-geo-alt me-2"></i>Alamat Pemasangan</div>
                            <div class="fw-medium px-3 py-2 bg-body-tertiary rounded-3 w-100" style="border: 1px solid var(--border-color);"><%= customer.address || '-' %></div>
                        </div>

                        <div class="d-flex gap-3 mt-5">
                            <a href="/customer/dashboard" class="btn btn-outline-secondary rounded-pill flex-grow-1 fw-semibold py-2">
                                <i class="bi bi-arrow-left me-1"></i> Kembali
                            </a>
                            <a href="https://wa.me/<%= typeof appSettings !== 'undefined' ? appSettings.contact_whatsapp : '6281234567890' %>" class="btn btn-success rounded-pill flex-grow-1 fw-semibold py-2 shadow-sm" target="_blank">
                                <i class="bi bi-whatsapp me-1"></i> Hubungi Admin
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
  </div>

  <div class="mobile-layout d-block d-md-none" data-theme="light">
      
      <div class="mob-header">
          <div class="d-flex align-items-center gap-3">
              <div class="mob-wifi-icon"><i class="bi bi-person-badge"></i></div>
              <div>
                  <div class="mob-text-muted" style="font-size: 10px;">Portal Pelanggan</div>
                  <div style="font-weight: 800; font-size: 14px; letter-spacing: 0.5px;">PROFIL SAYA</div>
              </div>
          </div>
          <div class="d-flex align-items-center gap-3">
              <button onclick="toggleTheme()" style="background:none; border:none; color:inherit; position: relative; z-index: 9999; cursor: pointer; padding: 5px;">
                  <i class="bi bi-moon-stars-fill fs-5" id="themeIconMob"></i>
              </button>
              <form method="POST" action="/customer/logout" class="m-0">
                  <button type="submit" style="background:none; border:none; color:#dc3545; position: relative; z-index: 9999; cursor: pointer; padding: 5px;"><i class="bi bi-box-arrow-right fs-4"></i></button>
              </form>
          </div>
      </div>

      <div class="mob-profile-header">
          <h4 class="fw-bold mb-1"><%= customer.name %></h4>
          <div style="font-size: 12px; opacity: 0.8;"><i class="bi bi-patch-check-fill text-warning me-1"></i>Member Terverifikasi</div>
      </div>

      <div class="mob-profile-card">
          <div class="mob-avatar">
              <i class="bi bi-person"></i>
          </div>

          <div class="mt-2">
              <div class="mob-info-item">
                  <div class="mob-info-icon"><i class="bi bi-fingerprint"></i></div>
                  <div>
                      <div style="font-size: 10px; color: var(--text-muted); margin-bottom: 2px;">Username ID</div>
                      <div class="fw-bold" style="font-size: 14px; color: var(--primary-color); letter-spacing: 0.5px;"><%= customer.username %></div>
                  </div>
              </div>

              <div class="mob-info-item">
                  <div class="mob-info-icon"><i class="bi bi-whatsapp"></i></div>
                  <div>
                      <div style="font-size: 10px; color: var(--text-muted); margin-bottom: 2px;">Nomor Telepon / WA</div>
                      <div class="fw-bold" style="font-size: 13px;"><%= customer.phone %></div>
                  </div>
              </div>

              <div class="mob-info-item">
                  <div class="mob-info-icon"><i class="bi bi-geo-alt"></i></div>
                  <div class="w-100">
                      <div style="font-size: 10px; color: var(--text-muted); margin-bottom: 4px;">Alamat Pemasangan</div>
                      <div style="font-size: 12px; line-height: 1.5; background: rgba(0,0,0,0.02); padding: 10px; border-radius: 8px; border: 1px solid var(--border-color);"><%= customer.address || '-' %></div>
                  </div>
              </div>
          </div>

          <div class="mt-4 pt-3 d-flex flex-column gap-2" style="border-top: 1px dashed var(--border-color);">
              <a href="https://wa.me/<%= typeof appSettings !== 'undefined' ? appSettings.contact_whatsapp : '6281234567890' %>" class="btn w-100 rounded-pill py-2 text-white fw-bold shadow-sm" style="background: #10b981; font-size: 13px;">
                  <i class="bi bi-whatsapp me-1"></i> Chat Admin Sekarang
              </a>
              <a href="/customer/dashboard" class="btn btn-outline-secondary w-100 rounded-pill py-2 fw-semibold" style="font-size: 13px;">
                  Kembali ke Beranda
              </a>
          </div>
      </div>

      <div style="height: 100px; opacity: 0; pointer-events: none;"></div>

      <div class="mob-nav">
          <a href="/customer/dashboard" class="mob-nav-item"><i class="bi bi-house-door fs-4 mb-1"></i>Home</a>
          <a href="/customer/billing/invoices" class="mob-nav-item"><i class="bi bi-ticket-perforated fs-4 mb-1"></i>Tagihan</a>
          <a href="#" data-bs-toggle="modal" data-bs-target="#qrisModal" class="mob-nav-item" style="flex: 0.8; text-decoration: none;">
              <div class="mob-nav-fab"><i class="bi bi-qr-code-scan"></i></div>
          </a>
          <a href="/customer/trouble/report" class="mob-nav-item"><i class="bi bi-hdd-network fs-4 mb-1"></i>Komplain</a>
          <a href="/customer/billing/profile" class="mob-nav-item active"><i class="bi bi-person-fill fs-4 mb-1"></i>Profil</a>
      </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
      const htmlEl = document.documentElement;
      const mobLayout = document.querySelector('.mobile-layout');
      const savedTheme = localStorage.getItem('appTheme') || 'light';
      
      // Jalankan tema pertama kali load
      setTheme(savedTheme);

      // Fungsi global ini dipanggil dari tombol di Desktop maupun Mobile
      window.toggleTheme = function() {
          const currentTheme = htmlEl.getAttribute('data-bs-theme');
          setTheme(currentTheme === 'light' ? 'dark' : 'light');
      };

      function setTheme(theme) {
          // Ganti warna kanvas utama
          htmlEl.setAttribute('data-bs-theme', theme);
          
          // Ganti variabel khusus mobile
          if (mobLayout) mobLayout.setAttribute('data-theme', theme);
          
          // Simpan memori
          localStorage.setItem('appTheme', theme);
          
          // Sinkronisasi Ikon Desktop
          const iconDesk = document.getElementById('themeIconDesk');
          if(iconDesk) iconDesk.className = theme === 'dark' ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars-fill text-secondary';
          
          // Sinkronisasi Ikon Mobile
          const iconMob = document.getElementById('themeIconMob');
          if(iconMob) iconMob.className = theme === 'dark' ? 'bi bi-sun-fill text-warning fs-5' : 'bi bi-moon-stars-fill fs-5';
      }
  </script>
  
  <div class="modal fade" id="qrisModal" tabindex="-1" aria-labelledby="qrisModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content border-0 shadow-lg rounded-4" style="background-color: var(--surface-color, #fff);">
        <div class="modal-header border-bottom-0 pb-0">
          <h6 class="modal-title fw-bold text-primary" id="qrisModalLabel"><i class="bi bi-qr-code-scan me-2"></i>Scan QRIS</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center pt-2 pb-4">
            
            <div class="bg-white p-3 rounded-4 border d-inline-block shadow-sm mb-3 mt-2">
                <img src="/img/ewallet.jpg" onerror="this.onerror=null; this.src='/img/logo.png';" alt="QR Code Pembayaran" class="img-fluid rounded-3" style="max-width: 180px;">
            </div>
            
            <h6 class="fw-bold mb-1">A/N: <%= typeof appSettings !== 'undefined' ? appSettings.payment_account_holder : 'PulseBill Technologies Inc.' %></h6>
            <p class="small text-muted mb-0" style="font-size: 11px;">Gunakan aplikasi M-Banking atau E-Wallet (DANA, OVO, GoPay) untuk scan kode di atas.</p>
        </div>
      </div>
    </div>
  </div>
  
</body>
</html>