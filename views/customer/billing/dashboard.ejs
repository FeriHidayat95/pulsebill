        const themeIconMob = document.getElementById('themeIconMob');
        const savedMobTheme = localStorage.getItem('mobTheme') || 'light';
        setThemeMob(savedMobTheme);

        function toggleThemeMob() {
            const currentTheme = mobLayout.getAttribute('data-theme');
            setThemeMob(currentTheme === 'light' ? 'dark' : 'light');
        }

        function setThemeMob(theme) {
            mobLayout.setAttribute('data-theme', theme);
            localStorage.setItem('mobTheme', theme);
            if(theme === 'dark') {
                themeIconMob.className = 'bi bi-sun-fill text-warning fs-5';
            } else {
                themeIconMob.className = 'bi bi-moon-fill fs-5';
            }
        }
      </script>
  </div>

  <!-- DataTables JS -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
  <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
  <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
  $(document).ready(function() {
    // Initialize DataTable for invoices if table exists
    if ($('#invoicesTable').length) {
      $('#invoicesTable').DataTable({
        responsive: true,
        language: {
          url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/id.json'
        },
        dom: '<"top"f>rt<"bottom"lip><"clear">',
        ordering: true,
        info: true,
        paging: true,
        pageLength: 10,
        lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "Semua"]],
        columnDefs: [{
          targets: '_all',
          className: 'align-middle'
        }]
      });
    }

    // Auto refresh logo
    function refreshLogo() {
      const logo = document.getElementById('logoImage');
      if (logo) {
        const timestamp = new Date().getTime();
        const src = logo.src.split('?')[0];
        logo.src = `${src}?v=${timestamp}`;
      }
    }

    // Refresh logo every 5 seconds
    setInterval(refreshLogo, 5000);
  });

  // QR Code toggle function
  function toggleQRCode() {
    const qrContainer = document.getElementById('qr-container');
    const showBtn = document.getElementById('show-qr-btn');
    const hideBtn = document.getElementById('hide-qr-btn');
    
    if (qrContainer.style.display === 'none') {
      // Show QR Code image
      qrContainer.style.display = 'block';
      showBtn.style.display = 'none';
      hideBtn.style.display = 'inline-block';
    } else {
      // Hide QR Code image
      qrContainer.style.display = 'none';
      showBtn.style.display = 'inline-block';
      hideBtn.style.display = 'none';
    }
  }
    </script>
</body>
