<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Billing Dashboard | Portal Pelanggan</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
  <link href="https://cdn.datatables.net/responsive/2.5.0/css/dataTables.responsive.min.css" rel="stylesheet">
  <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
    <style>
    :root {
      --primary-color: #4361ee;
      --secondary-color: #3f37c9;
      --accent-color: #4895ef;
      --success-color: #4cc9f0;
      --warning-color: #f72585;
      --info-color: #560bad;
      --light-color: #f8f9fa;
      --dark-color: #212529;
      --card-border-radius: 16px;
      --btn-border-radius: 50px;
      --transition-speed: 0.3s;
    }
    
    body {
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      min-height: 100vh;
      color: var(--dark-color);
      line-height: 1.6;
    }
    
    .navbar {
      background: rgba(255, 255, 255, 0.95) !important;
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
    }
    
    .navbar-brand {
      font-weight: 700;
      color: var(--primary-color) !important;
      letter-spacing: -0.5px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    
    .navbar-brand img {
      height: 40px;
      max-width: 80px;
      border-radius: 10px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      transition: transform var(--transition-speed);
    }
    
    .main-container {
      padding: 30px 0;
    }
    
    .card {
      border: none;
      border-radius: var(--card-border-radius);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
      transition: all var(--transition-speed) ease;
      overflow: hidden;
      margin-bottom: 25px;
    }
    
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
    }
    
    .card-header {
      background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
      color: white;
      border: none;
      padding: 25px;
      position: relative;
      overflow: hidden;
    }
    
    .stats-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 20px;
      margin-bottom: 30px;
      width: 100%;
    }
    
    .stat-card {
      background: white;
      border-radius: var(--card-border-radius);
      padding: 20px;
      text-align: left;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
      transition: all var(--transition-speed) ease;
      display: flex;
      align-items: center;
      gap: 15px;
      position: relative;
      overflow: hidden;
      border-left: 4px solid transparent;
    }
    
    .stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }
    
    .stat-icon {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      color: white;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
      transition: all var(--transition-speed) ease;
      flex-shrink: 0;
    }
    
          .stat-icon.billing { background: linear-gradient(135deg, #4895ef, #3f37c9); }
    .stat-icon.paid { background: linear-gradient(135deg, #4cc9f0, #4895ef); }
    .stat-icon.unpaid { background: linear-gradient(135deg, #f72585, #b5179e); }
    .stat-icon.overdue { background: linear-gradient(135deg, #dc3545, #c82333); }
    

    
    .stat-label {
      font-size: 12px;
      color: #6c757d;
      margin-bottom: 5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    
    .stat-value {
      font-size: 16px;
      font-weight: 700;
      color: var(--dark-color);
      margin: 0;
      line-height: 1.2;
    }
    
    .table-container {
      background: white;
      border-radius: var(--card-border-radius);
      padding: 25px;
      margin-bottom: 25px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03);
      transition: all var(--transition-speed) ease;
      position: relative;
      overflow: hidden;
    }
    
    .table-container:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }
    
    .table-container h6 {
      color: var(--dark-color);
      font-weight: 700;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 16px;
    }
    
    .table-container h6 i {
      color: var(--accent-color);
      font-size: 18px;
    }
    
    .alert {
      border-radius: 12px;
      border: none;
      padding: 15px 20px;
    }
    
    .alert-info {
      background: rgba(102, 126, 234, 0.1);
      color: #2c3e50;
      border-left: 4px solid #667eea;
    }
    
    .alert-danger {
      background: rgba(220, 53, 69, 0.1);
      color: #721c24;
      border-left: 4px solid #dc3545;
    }
    
    .footer {
      text-align: center;
      color: #6c757d;
      font-size: 12px;
      margin-top: 30px;
      padding: 20px 0;
    }
    
    @media (max-width: 768px) {
      .main-container {
        padding: 15px 0;
      }
      .stats-grid {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 15px !important;
      }
      .stat-card {
        padding: 15px 12px !important;
        font-size: 13px;
        text-align: center !important;
        display: flex !important;
        flex-direction: column !important;
        min-height: 130px;
      }
      .stat-icon {
        width: 40px;
        height: 40px;
        font-size: 18px;
        margin: 0 auto 8px !important;
      }
      .stat-content {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .stat-value {
        font-size: 16px !important;
        font-weight: 700 !important;
      }
      .stat-label {
        font-size: 11px !important;
        margin-bottom: 5px;
      }
      .table-container {
        padding: 15px;
        margin-bottom: 15px;
      }
      .navbar-brand {
        font-size: 14px;
      }
      .navbar-brand img {
        height: 30px;
      }
      .btn {
        font-size: 12px;
        padding: 6px 12px;
      }
      .card-body {
        padding: 15px;
      }
      .alert {
        padding: 10px 15px;
        font-size: 14px;
      }
    }
    
    @media (max-width: 576px) {
      .stats-grid {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 12px !important;
      }
      .stat-card {
        padding: 15px 8px !important;
        text-align: center !important;
        flex-direction: column !important;
        display: flex !important;
        min-height: 120px;
      }
      .stat-card .stat-icon {
        margin: 0 auto 8px !important;
        width: 35px;
        height: 35px;
        font-size: 16px;
      }
      .stat-content {
        width: 100% !important;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }
      .stat-value {
        font-size: 14px !important;
        font-weight: 700 !important;
      }
      .stat-label {
        font-size: 10px !important;
        margin-bottom: 5px;
      }
      .container {
        padding-left: 10px;
        padding-right: 10px;
      }
      .navbar-brand span {
        font-size: 12px;
      }
    }
    
    @media (max-width: 480px) {
      .stats-grid {
        display: grid !important;
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 10px !important;
      }
      .stat-card {
        padding: 12px 6px !important;
        text-align: center !important;
        min-height: 110px;
      }
      .stat-card .stat-icon {
        margin: 0 auto 6px !important;
        width: 32px;
        height: 32px;
        font-size: 14px;
      }
      .stat-value {
        font-size: 13px !important;
      }
      .stat-label {
        font-size: 9px !important;
      }
    }
    </style>
    
    <style id="mobile-ui-styles">
        @media (max-width: 767.98px) {
            body { background: #f4f7fe !important; padding-bottom: 90px; }
            .mobile-layout { color: #1e293b; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
            .mobile-layout[data-theme="dark"] { 
                background: #0f172a !important; color: #f8fafc; 
                --card-bg: #1e293b; --border-color: rgba(255,255,255,0.05); --text-muted: #94a3b8;
            }
            .mobile-layout[data-theme="light"] { 
                --card-bg: #ffffff; --border-color: rgba(0,0,0,0.05); --text-muted: #64748b;
            }

            .mob-header { display: flex; justify-content: space-between; align-items: center; padding: 15px 20px; }
            .mob-wifi-icon { background: var(--card-bg); color: #4361ee; border-radius: 12px; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 4px 15px rgba(67, 97, 238, 0.15); border: 1px solid var(--border-color); }
            
            .mob-hero { background: linear-gradient(135deg, #3f37c9 0%, #4895ef 100%); color: white; border-radius: 20px; padding: 22px; margin: 0 20px 20px 20px; position: relative; overflow: hidden; box-shadow: 0 12px 25px rgba(63, 55, 201, 0.25); }
            .mob-hero::after { content: ''; position: absolute; right: -30px; bottom: -30px; width: 120px; height: 120px; background: rgba(255,255,255,0.1); border-radius: 50%; }
            .mob-hero-badge { background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); font-size: 10px; padding: 4px 10px; border-radius: 12px; font-weight: 600; }
            
            .mob-search { margin: 0 20px 25px 20px; display: flex; background: var(--card-bg); border-radius: 12px; padding: 4px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-color); }
            .mob-search input { border: none; background: transparent; outline: none; padding: 8px 15px; font-size: 12px; width: 100%; color: inherit; }
            .mob-search button { background: #4361ee; color: white; border: none; border-radius: 10px; padding: 0 20px; font-size: 12px; font-weight: 600; }

            .mob-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 0 20px 25px 20px; }
            .mob-grid-item { background: var(--card-bg); border-radius: 16px; padding: 15px 5px; text-align: center; text-decoration: none; color: inherit; border: 1px solid var(--border-color); box-shadow: 0 4px 10px rgba(0,0,0,0.02); display: flex; flex-direction: column; align-items: center; }
            .mob-grid-icon { font-size: 22px; color: #4361ee; margin-bottom: 6px; }
            .mob-grid-text { font-size: 10px; font-weight: 600; }

            .mob-card { background: var(--card-bg); border-radius: 16px; padding: 18px; margin: 0 20px 20px 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid var(--border-color); }
            .mob-payment-box { border: 1px solid var(--border-color); border-radius: 14px; padding: 15px; display: flex; align-items: center; gap: 15px; margin-bottom: 15px; background: rgba(0,0,0,0.02); }
            
            .mob-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: var(--card-bg); display: flex; justify-content: space-around; align-items: center; padding: 10px 5px 15px 5px; box-shadow: 0 -5px 25px rgba(0,0,0,0.05); z-index: 1000; border-top: 1px solid var(--border-color); border-radius: 20px 20px 0 0; }
            .mob-nav-item { display: flex; flex-direction: column; align-items: center; color: var(--text-muted); font-size: 10px; text-decoration: none; flex: 1; font-weight: 600; }
            .mob-nav-item.active { color: #4361ee; }
            .mob-nav-fab { background: linear-gradient(135deg, #4361ee 0%, #3f37c9 100%); color: white; width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; transform: translateY(-22px); box-shadow: 0 8px 20px rgba(67, 97, 238, 0.4); border: 5px solid #f4f7fe; }
            /* --- CSS STATUS MODERN ELEGAN --- */
            .status-pill { padding: 4px 12px; border-radius: 20px; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; border: 1px solid transparent; display: inline-block; }
            .status-lunas { background: rgba(16, 185, 129, 0.15); color: #10b981; border-color: rgba(16, 185, 129, 0.3); }
            .status-belum { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border-color: rgba(245, 158, 11, 0.3); }
            .status-telat { background: rgba(239, 68, 68, 0.15); color: #ef4444; border-color: rgba(239, 68, 68, 0.3); }
            .status-baru  { background: rgba(100, 116, 139, 0.15); color: #64748b; border-color: rgba(100, 116, 139, 0.3); }      
      
        }
    </style>
    
</head>
<body>
<div class="desktop-layout d-none d-md-block">
  <nav class="navbar navbar-light shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
      <span class="navbar-brand">
        <img id="logoImage" src="/img/<%= typeof settings !== 'undefined' && settings.logo_filename ? settings.logo_filename : 'logo.png' %>?v=<%= new Date().getTime() %>" alt="Logo" style="height: 40px; max-width: 80px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);"> 
        <span class="d-none d-sm-inline">Portal Pelanggan</span>
        <span class="d-inline d-sm-none">Billing</span>
      </span>
      <div class="d-flex align-items-center gap-1 gap-sm-2">
        <a href="/customer/dashboard" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-house"></i> <span class="d-none d-sm-inline">Dashboard</span>
        </a>
        <a href="/customer/trouble/report" class="btn btn-outline-warning btn-sm">
          <i class="bi bi-exclamation-triangle"></i> <span class="d-none d-sm-inline">Laporan</span>
        </a>
        <form method="POST" action="/customer/logout" class="d-inline">
          <button type="submit" class="btn btn-outline-danger btn-sm" title="Logout">
            <i class="bi bi-box-arrow-right"></i>
          </button>
        </form>
      </div>
    </div>
  </nav>

  <div class="main-container">
    <div class="container">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
      <% } %>

      <% if (customer) { %>
      <div class="card">
        <div class="card-header">
          <h5 class="mb-0">
            <i class="bi bi-receipt me-2"></i>
            Informasi Tagihan - <%= customer.name %>
          </h5>
        </div>
          <div class="card-body p-4">
            <div class="stats-grid">
              <div class="stat-card">
                <div class="stat-icon billing">
                  <i class="bi bi-receipt"></i>
                </div>
                <div class="stat-content">
                  <div class="stat-label">Total Tagihan</div>
                  <div class="stat-value"><%= invoices.length %></div>
            </div>
        </div>

              <div class="stat-card">
                <div class="stat-icon paid">
                  <i class="bi bi-check-circle"></i>
                </div>
                <div class="stat-content">
                  <div class="stat-label">Tagihan Lunas</div>
                  <div class="stat-value">
                    <%= invoices.filter(inv => inv.status === 'paid').length %>
                    </div>
                </div>
            </div>
              
              <div class="stat-card">
                <div class="stat-icon unpaid">
                  <i class="bi bi-clock"></i>
                </div>
                <div class="stat-content">
                  <div class="stat-label">Belum Lunas</div>
                  <div class="stat-value">
                    <%= invoices.filter(inv => inv.status === 'unpaid').length %>
                    </div>
                </div>
            </div>
              
              <div class="stat-card">
                <div class="stat-icon overdue">
                  <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div class="stat-content">
                  <div class="stat-label">Terlambat</div>
                  <div class="stat-value">
                    <%= invoices.filter(inv => inv.status === 'unpaid' && new Date(inv.due_date) < new Date()).length %>
                    </div>
                </div>
            </div>
        </div>

            <div class="row">
              <div class="col-md-6">
                <div class="card border-0 bg-light">
                    <div class="card-body">
                    <h6 class="card-title text-primary">
                      <i class="bi bi-person-circle me-2"></i>Data Pelanggan
                    </h6>
                    <% if (customer) { %>
                    <div class="mb-2">
                      <strong>Nama:</strong> <%= customer.name %>
                    </div>
                    <div class="mb-2">
                      <strong>Username:</strong> <%= customer.username %>
                    </div>
                    <div class="mb-2">
                      <strong>Telepon:</strong> <%= customer.phone %>
                    </div>
                    <div class="mb-2">
                      <strong>Paket:</strong> 
                      <% if (customer.package_name) { %>
                        <span class="badge bg-info">
                          <%= customer.package_name %> - Rp <%= parseFloat(customer.package_price).toLocaleString('id-ID') %>
                        </span>
                      <% } else { %>
                        <span class="text-muted">Belum ada paket</span>
                      <% } %>
                    </div>
                    <div class="mb-2">
                      <strong>Status Pembayaran:</strong>
                      <% if (customer.payment_status === 'paid') { %>
                        <span class="badge bg-success">Lunas</span>
                      <% } else if (customer.payment_status === 'unpaid') { %>
                        <span class="badge bg-warning">Belum Lunas</span>
                      <% } else if (customer.payment_status === 'overdue') { %>
                        <span class="badge bg-danger">Terlambat</span>
                      <% } else { %>
                        <span class="badge bg-secondary">Belum Ada Tagihan</span>
                      <% } %>
                    </div>
                    <% } else { %>
                    <div class="mb-2">
                      <strong>Nomor Telepon:</strong> <%= phone || 'Tidak diketahui' %>
                    </div>
                    <div class="mb-2">
                      <strong>Status:</strong> 
                      <span class="badge bg-warning">Belum Terdaftar di Sistem Billing</span>
                    </div>
                    <div class="alert alert-info mt-3">
                      <i class="bi bi-info-circle me-2"></i>
                      <strong>Informasi:</strong> Nomor telepon Anda belum terdaftar dalam sistem billing. 
                      Silakan hubungi admin untuk mendaftarkan layanan billing.
                    </div>
                    <% } %>
                    </div>
                </div>
            </div>
              <div class="col-md-6">
                <div class="card border-0 bg-light">
                    <div class="card-body">
                    <h6 class="card-title text-primary">
                      <i class="bi bi-calculator me-2"></i>Ringkasan Keuangan
                    </h6>
                    <div class="mb-2">
                      <strong>Total Tagihan:</strong> 
                      <span class="fw-bold">
                        Rp <%= invoices.reduce((sum, inv) => sum + parseFloat(inv.amount), 0).toLocaleString('id-ID') %>
                      </span>
                    </div>
                    <div class="mb-2">
                      <strong>Sudah Dibayar:</strong> 
                      <span class="text-success fw-bold">
                        Rp <%= invoices.filter(inv => inv.status === 'paid').reduce((sum, inv) => sum + parseFloat(inv.amount), 0).toLocaleString('id-ID') %>
                      </span>
                    </div>
                    <div class="mb-2">
                      <strong>Belum Dibayar:</strong> 
                      <span class="text-danger fw-bold">
                        Rp <%= invoices.filter(inv => inv.status === 'unpaid').reduce((sum, inv) => sum + parseFloat(inv.amount), 0).toLocaleString('id-ID') %>
                      </span>
                    </div>
                    <div class="mb-2">
                      <strong>Terlambat:</strong> 
                      <span class="text-danger fw-bold">
                        Rp <%= invoices.filter(inv => inv.status === 'unpaid' && new Date(inv.due_date) < new Date()).reduce((sum, inv) => sum + parseFloat(inv.amount), 0).toLocaleString('id-ID') %>
                      </span>
                    </div>
                  </div>
                </div>
                    </div>
                </div>
            </div>

            <!-- Tagihan Belum Lunas (Quick Payment) -->
            <% 
            const unpaidInvoices = invoices.filter(inv => inv.status === 'unpaid');
            if (unpaidInvoices.length > 0) { 
            %>
            <div class="row mt-4">
              <div class="col-md-12">
                <div class="card border-0 bg-warning bg-opacity-10 border-warning">
                  <div class="card-body">
                    <h6 class="card-title text-warning">
                      <i class="bi bi-exclamation-triangle-fill me-2"></i>Tagihan Belum Lunas - Segera Bayar!
                    </h6>
                    <div class="row">
                      <% unpaidInvoices.slice(0, 3).forEach(function(invoice) { %>
                        <div class="col-md-4 mb-3">
                          <div class="card border-0 bg-white">
                            <div class="card-body">
                              <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                  <h6 class="card-title text-dark mb-1"><%= invoice.invoice_number %></h6>
                                  <p class="text-muted mb-1"><%= invoice.package_name %></p>
                                </div>
                                <% if (new Date(invoice.due_date) < new Date()) { %>
                                  <span class="badge bg-danger">Terlambat</span>
                                <% } else { %>
                                  <span class="badge bg-warning">Belum Lunas</span>
                                <% } %>
                              </div>
                              <div class="mb-2">
                                <strong class="text-primary fs-5">Rp <%= parseFloat(invoice.amount).toLocaleString('id-ID') %></strong>
                              </div>
                              <div class="mb-3">
                                <small class="text-muted">
                                  Jatuh tempo: <%= new Date(invoice.due_date).toLocaleDateString('id-ID') %>
                                </small>
                              </div>
                              <a href="/customer/billing/invoices/<%= invoice.id %>" class="btn btn-primary btn-sm w-100">
                                <i class="bi bi-credit-card me-1"></i> Bayar Sekarang
                              </a>
                            </div>
                          </div>
                        </div>
                      <% }); %>
                      <% if (unpaidInvoices.length > 3) { %>
                        <div class="col-12 text-center">
                          <a href="/customer/billing/invoices" class="btn btn-outline-warning">
