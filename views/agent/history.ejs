<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Riwayat Transaksi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-light">
<div class="container py-4">
    <a href="/agent/dashboard" class="btn btn-outline-secondary mb-3"><i class="fas fa-arrow-left"></i> Kembali</a>
    
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h5 class="mb-0">Mutasi Saldo (50 Terakhir)</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Tanggal</th>
                        <th>Tipe</th>
                        <th>Nominal / Modal</th>
                        <th>Keterangan</th>
                    </tr>
                </thead>
                <tbody>
                    <% logs.forEach(l => { %>
                    <tr>
                        <td><%= moment(l.created_at).format('DD/MM/YY HH:mm') %></td>
                        <td>
                            <% if(l.type == 'Isi Saldo') { %>
                                <span class="badge bg-success">Isi Saldo</span>
                            <% } else { %>
                                <span class="badge bg-danger">Beli Voucher</span>
                            <% } %>
                        </td>
                        <td class="<%= l.type == 'Isi Saldo' ? 'text-success' : 'text-danger' %> fw-bold">
                            Rp <%= parseInt(l.amount).toLocaleString('id-ID') %>
                        </td>
                        <td><%= l.info %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>
</body>
</html>
