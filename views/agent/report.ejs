<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Laporan Cuan</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-light">
<div class="container py-4">
    <a href="/agent/dashboard" class="btn btn-outline-secondary mb-3"><i class="fas fa-arrow-left"></i> Kembali</a>
    
    <h4 class="mb-4">Laporan Keuangan Agen</h4>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card bg-primary text-white border-0 shadow">
                <div class="card-body">
                    <h6>Total Omset Penjualan</h6>
                    <h2>Rp <%= parseInt(stats.total_omset || 0).toLocaleString('id-ID') %></h2>
                    <small>Dari <%= stats.total_qty || 0 %> Voucher terjual</small>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card bg-success text-white border-0 shadow">
                <div class="card-body">
                    <h6>Total Cuan Bersih (Profit)</h6>
                    <h2>Rp <%= parseInt(stats.total_cuan || 0).toLocaleString('id-ID') %></h2>
                    <small>Masuk ke kantong sendiri</small>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-light mt-4 shadow-sm">
        <i class="fas fa-info-circle text-primary"></i> Data ini dihitung dari seluruh riwayat penjualan voucher Anda sejak awal.
    </div>
</div>
</body>
</html>
