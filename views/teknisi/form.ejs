<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Input Pelanggan Baru | Pasukan Lapangan</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/socket.io/socket.io.js"></script>
    <style>
        /* --- KONFIGURASI TEMA (VARIABLE) --- */
        :root {
            --bg-body: #f3f4f6;        
            --bg-card: #ffffff;        
            --input-bg: #f9fafb;       
            --text-main: #1f2937;      
            --text-muted: #6b7280;     
            --accent: #2563eb;         
            --border: #e5e7eb;
            --shadow: rgba(0, 0, 0, 0.1);
            --glow-opacity: 0.5;
        }
        [data-theme="dark"] {
            --bg-body: #0f172a;        
            --bg-card: #1e293b;        
            --input-bg: #334155;       
            --text-main: #f8fafc;      
            --text-muted: #94a3b8;     
            --accent: #60a5fa;         
            --border: #475569;
            --shadow: rgba(0, 0, 0, 0.4);
            --glow-opacity: 0.8;
        }
        * { box-sizing: border-box; outline: none; transition: background-color 0.3s ease, color 0.3s ease; }
        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            margin: 0;
            padding: 20px;
            min-height: 100vh;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 480px;
            padding-bottom: 80px;
            position: relative;
        }
        .theme-toggle {
            position: absolute;
            top: 0;
            right: 0;
            background: var(--bg-card);
            border: 1px solid var(--border);
            width: 40px; height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 4px 10px var(--shadow);
            z-index: 10;
        }
        .theme-toggle i { font-size: 18px; color: var(--text-main); }
        .header {
            text-align: center;
            margin-bottom: 30px;
            padding-top: 20px;
        }
        .header .user-badge {
            background: rgba(37, 99, 235, 0.1);
            color: var(--accent);
            padding: 6px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: 15px;
            border: 1px solid var(--border);
        }
        .header h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 800;
            background: linear-gradient(to right, #2563eb, #8b5cf6);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .header p { color: var(--text-muted); font-size: 13px; margin-top: 5px; }
        .form-card {
            background: var(--bg-card);
            padding: 25px;
            border-radius: 24px;
            box-shadow: 0 20px 50px var(--shadow);
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
        }
        .form-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 5px;
            background: linear-gradient(90deg, #3b82f6, #8b5cf6);
            opacity: var(--glow-opacity);
        }
        .form-group { margin-bottom: 20px; position: relative; }
        .form-group label {
            display: block; margin-bottom: 8px; font-size: 12px; font-weight: 700;
            color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;
        }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            background: var(--input-bg);
            border: 1px solid var(--border);
            color: var(--text-main);
            padding: 14px 15px 14px 45px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .form-group textarea { padding-left: 15px; }
        .form-group i {
            position: absolute; left: 15px; top: 42px;
            color: var(--text-muted); font-size: 16px; transition: 0.3s;
            z-index: 5;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            background: var(--bg-card);
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
        }
        .form-group input:focus + i, .form-group select:focus + i { color: var(--accent); }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .btn-submit {
            width: 100%;
            background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            color: white; border: none; padding: 16px; border-radius: 14px;
            font-size: 16px; font-weight: 800; text-transform: uppercase;
            letter-spacing: 1px; cursor: pointer; transition: all 0.3s;
            box-shadow: 0 10px 20px -5px rgba(37, 99, 235, 0.4);
            margin-top: 10px;
        }
        .btn-submit:active { transform: scale(0.98); }
        .footer-actions {
            margin-top: 30px; text-align: center;
            border-top: 1px solid var(--border); padding-top: 20px;
        }
        .btn-logout {
            background: transparent; color: #ef4444; border: 1px solid #ef4444;
            padding: 8px 20px; border-radius: 20px; font-size: 12px; font-weight: 700;
            text-decoration: none; transition: 0.3s;
        }
        .btn-logout:hover { background: #ef4444; color: white; }
        .history-section { margin-top: 40px; }
        .history-title { 
            font-size: 12px; font-weight: 800; color: var(--text-muted); 
            text-transform: uppercase; margin-bottom: 15px; letter-spacing: 1px;
        }
        .history-item {
            background: var(--bg-card); padding: 15px; border-radius: 12px;
            margin-bottom: 10px; border-left: 4px solid var(--border);
            display: flex; justify-content: space-between; align-items: center;
            box-shadow: 0 2px 5px var(--shadow);
            cursor: pointer; transition: 0.2s;
        }
        .history-item:hover { transform: translateX(5px); box-shadow: 0 5px 15px var(--shadow); }
        
        .status-pending { border-left-color: #f59e0b; }
        .status-validated { border-left-color: #10b981; }
        .status-rejected { border-left-color: #ef4444; }
        .h-name { font-weight: 700; font-size: 14px; display: block; color: var(--text-main); }
        .h-date { font-size: 11px; color: var(--text-muted); }
        .h-badge { font-size: 10px; padding: 4px 8px; border-radius: 6px; font-weight: 800; text-transform: uppercase; }
        .badge-pending { background: rgba(245, 158, 11, 0.1); color: #d97706; }
        .badge-validated { background: rgba(16, 185, 129, 0.1); color: #059669; }
        .badge-rejected { background: rgba(239, 68, 68, 0.1); color: #dc2626; }
        
        [data-theme="dark"] .badge-pending { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
        [data-theme="dark"] .badge-validated { background: rgba(16, 185, 129, 0.2); color: #34d399; }
        [data-theme="dark"] .badge-rejected { background: rgba(239, 68, 68, 0.2); color: #f87171; }
        /* Style Kolom Pencarian Riwayat */
        .search-wrapper { position: relative; margin-bottom: 15px; }
        .search-wrapper input {
            width: 100%; background: var(--bg-card); border: 1px solid var(--border);
            color: var(--text-main); padding: 12px 15px 12px 40px; border-radius: 12px;
            font-size: 13px; font-weight: 600;
        }
        .search-wrapper i { position: absolute; left: 15px; top: 14px; color: var(--text-muted); }
        /* ========================================================== */
        /* ========================================================== */
        .select2-container--default .select2-selection--single {
            background-color: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 12px;
            height: 48px;
            padding: 8px 15px 8px 40px; /* Jarak untuk ikon box */
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
        }
        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: var(--text-main);
            font-weight: 600;
            font-size: 14px;
            padding-left: 0;
            line-height: normal;
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 46px;
            right: 15px;
        }
        /* Style list pop-up */
        .select2-dropdown {
            background-color: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 15px 30px var(--shadow);
            overflow: hidden;
            z-index: 9999;
        }
        /* Style kotak ngetik (Search) */
        .select2-search--dropdown .select2-search__field {
            background-color: var(--input-bg);
            border: 1px solid var(--border);
            color: var(--text-main);
            border-radius: 8px;
            padding: 10px 12px;
            outline: none;
        }
        .select2-search--dropdown .select2-search__field:focus {
            border-color: var(--accent);
        }
        /* Style baris paket */
        .select2-results__option {
            color: var(--text-main);
            font-weight: 600;
            font-size: 13px;
            padding: 12px 15px;
            border-bottom: 1px solid var(--border);
        }
        .select2-container--default .select2-results__option--highlighted[aria-selected] {
            background-color: var(--accent);
            color: white;
        }
        .select2-container--default .select2-results__option[aria-selected=true] {
            background-color: rgba(37, 99, 235, 0.1);
            color: var(--accent);
        }
    </style>
</head>
<body data-theme="dark"> 
<div class="container">
    
    <div class="theme-toggle" onclick="switchTheme()" title="Ganti Tema">
        <i id="theme-icon" class="fas fa-sun"></i>
    </div>
    <div class="header">
        <div class="user-badge"><i class="fas fa-user-astronaut me-2"></i> <%= teknisi.name %></div>
        <h2>PULSEBILL NETWORKS</h2>
        <p>Formulir Pendaftaran Pelanggan Baru</p>
    </div>
    <div class="form-card">
        <form id="formInput">
            
            <div class="form-group">
                <label>Nama Pelanggan (Sesuai KTP)</label>
                <input type="text" name="customer_name" placeholder="Contoh: Budi Santoso" required>
                <i class="fas fa-user"></i>
            </div>
            <div class="form-group">
                <label>Nomor WhatsApp</label>
                <input type="number" name="whatsapp_no" placeholder="Contoh: 0812xxxx" required>
                <i class="fab fa-whatsapp"></i>
            </div>
            <div class="grid-2">
                <div class="form-group">
                    <label>User PPPoE</label>
                    <input type="text" name="pppoe_user" placeholder="Username" required>
                    <i class="fas fa-at"></i>
                </div>
                <div class="form-group">
                    <label>Password PPPoE</label>
                    <input type="text" name="pppoe_pass" placeholder="Password" required>
                    <i class="fas fa-key"></i>
                </div>
            </div>
            <div class="form-group">
                <label>Pilih Paket Internet</label>
                <select name="package_name" id="paketSearchable" required style="width: 100%;">
                    <option value="">-- KETIK / PILIH PAKET --</option>
                    <% paketList.forEach(p => { %>
                        <option value="<%= p.name %>"><%= p.name %> - Rp <%= p.price.toLocaleString() %></option>
                    <% }) %>
                </select>
                <i class="fas fa-box-open"></i>
            </div>
            <div class="grid-2">
                <div class="form-group">
                    <label>Data ODP</label>
                    <input type="text" name="odp_data" placeholder="Contoh: ODP-SMG-01" required>
                    <i class="fas fa-network-wired"></i>
                </div>
                <div class="form-group">
                    <label>Port ODP</label>
                    <input type="number" name="port_data" placeholder="1-16" min="1" max="16" required>
                    <i class="fas fa-door-open"></i>
                </div>
            </div>
            <div class="form-group">
                <label>Alamat Pemasangan</label>
                <textarea name="address" rows="3" placeholder="Jalan, RT/RW, Desa, Kecamatan..." required></textarea>
            </div>
            <button type="submit" class="btn-submit">
                <i class="fas fa-paper-plane" style="margin-right: 8px;"></i> KIRIM DATA
            </button>
        </form>
    </div>
    <div class="history-section">
        <div class="history-title">Riwayat Input Terakhir</div>
        
        <div class="search-wrapper">
            <i class="fas fa-search"></i>
            <input type="text" id="historySearch" placeholder="Cari nama atau paket...">
        </div>
        
        <div id="historyList">
            <% if(history.length === 0) { %>
                <div class="text-center text-muted small py-3" style="border: 1px dashed var(--border); border-radius: 12px;">Belum ada data.</div>
            <% } %>
            <% history.forEach(h => { %>
                <div class="history-item status-<%= h.status %>" 
                     onclick="showDetail('<%= h.customer_name %>', '<%= h.whatsapp_no %>', '<%= h.pppoe_user %>', '<%= h.package_name %>', '<%= h.odp_data || '-' %>', '<%= h.port_data || '-' %>', '<%= h.address.replace(/\n/g, ' ') %>', '<%= h.status %>')">
                    <div>
                        <span class="h-name"><%= h.customer_name %></span>
                        <span class="h-date"><%= h.package_name %> &bull; <%= new Date(h.created_at).toLocaleDateString('id-ID') %></span>
                    </div>
                    <div>
                        <span class="h-badge badge-<%= h.status %>"><%= h.status %></span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    <div class="footer-actions">
        <a href="/teknisi/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        <div style="margin-top: 15px; font-size: 11px; color: var(--text-muted);">&copy; 2026 PulseBill Telecom Technologies Inc.</div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    // --- 1. LOGIKA GANTI TEMA ---
    const savedTheme = localStorage.getItem('teknisi-form-theme') || 'dark';
    document.body.setAttribute('data-theme', savedTheme);
    updateIcon(savedTheme);
    function switchTheme() {
        let theme = document.body.getAttribute('data-theme');
        let newTheme = (theme === 'dark') ? 'light' : 'dark';
        document.body.setAttribute('data-theme', newTheme);
        localStorage.setItem('teknisi-form-theme', newTheme);
        updateIcon(newTheme);
    }
    function updateIcon(theme) {
        const icon = document.getElementById('theme-icon');
        if(theme === 'dark') {
            icon.className = 'fas fa-sun';
        } else {
            icon.className = 'fas fa-moon';
        }
    }
    // --- 2. LOGIKA PENCARIAN RIWAYAT ---
    $('#historySearch').on('keyup', function() {
        const value = $(this).val().toLowerCase();
        $('#historyList .history-item').filter(function() {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    });
    // --- 3. LOGIKA DETAIL RIWAYAT ---
    function showDetail(nama, wa, user, paket, odp, port, alamat, status) {
        const isDark = document.body.getAttribute('data-theme') === 'dark';
        const swalBg = isDark ? '#1e293b' : '#ffffff';
        const swalColor = isDark ? '#ffffff' : '#333333';
        Swal.fire({
            title: '<span style="font-size:18px; font-weight:800;">DETAIL PELANGGAN</span>',
            html: `
                <div style="text-align:left; font-size:13px; line-height:1.6;">
                    <div style="margin-bottom:10px; padding:10px; background:rgba(0,0,0,0.05); border-radius:10px;">
                        <strong style="color:var(--accent);">Nama:</strong><br>${nama}
                    </div>
                    <div style="margin-bottom:10px; padding:10px; background:rgba(0,0,0,0.05); border-radius:10px;">
                        <strong style="color:var(--accent);">WhatsApp:</strong><br>${wa}
                    </div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
                        <div style="padding:10px; background:rgba(0,0,0,0.05); border-radius:10px;">
                            <strong style="color:var(--accent);">User PPPoE:</strong><br>${user}
                        </div>
                        <div style="padding:10px; background:rgba(0,0,0,0.05); border-radius:10px;">
                            <strong style="color:var(--accent);">Paket:</strong><br>${paket}
                        </div>
                    </div>
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;">
                        <div style="padding:10px; background:rgba(0,0,0,0.05); border-radius:10px;">
                            <strong style="color:var(--accent);">ODP:</strong><br>${odp}
                        </div>
                        <div style="padding:10px; background:rgba(0,0,0,0.05); border-radius:10px;">
                            <strong style="color:var(--accent);">Port:</strong><br>${port}
                        </div>
                    </div>
                    <div style="margin-bottom:10px; padding:10px; background:rgba(0,0,0,0.05); border-radius:10px;">
                        <strong style="color:var(--accent);">Alamat:</strong><br>${alamat}
                    </div>
                    <div style="text-align:center; padding:5px;">
                        <span class="h-badge badge-${status}">${status}</span>
                    </div>
                </div>
            `,
            background: swalBg,
            color: swalColor,
            confirmButtonText: 'TUTUP',
            confirmButtonColor: '#3b82f6',
            showClass: { popup: 'animate-fade-in' }
        });
    }
    
    $(document).ready(function() {
        
        // INISIALISASI PENCARIAN DROPDOWN (SELECT2)
        $('#paketSearchable').select2({
            placeholder: "-- KETIK NAMA PAKET --",
            allowClear: true,
            width: '100%'
        });
        $('input[name="customer_name"]').on('input', function() {
            $('input[name="pppoe_user"]').val($(this).val());
        });
        $('input[name="pppoe_user"]').prop('readonly', true).css({
            'background-color': 'var(--input-bg)', 
            'cursor': 'not-allowed',
            'opacity': '0.6' 
        });
    });
    // --- 4. LOGIKA SUBMIT FORM ---
    $('#formInput').submit(function(e) {
        e.preventDefault();
        
        const isDark = document.body.getAttribute('data-theme') === 'dark';
        const swalBg = isDark ? '#1e293b' : '#ffffff';
        const swalColor = isDark ? '#ffffff' : '#333333';
        Swal.fire({
            title: 'Kirim Data?',
            text: "Pastikan data pelanggan & ODP sudah benar!",
            icon: 'question',
            background: swalBg,
            color: swalColor,
            showCancelButton: true,
            confirmButtonColor: '#3b82f6',
            cancelButtonColor: '#475569',
            confirmButtonText: 'Ya, Kirim!',
            cancelButtonText: 'Cek Lagi'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({ 
                    title: 'Mengirim...', 
                    background: swalBg, color: swalColor,
                    allowOutsideClick: false, 
                    didOpen: () => { Swal.showLoading() } 
                });
                
                $.post('/teknisi/submit', $(this).serialize(), function(res) {
                    if(res.success) {
                        Swal.fire({
                            title: 'Berhasil!',
                            text: 'Data & Lokasi ODP sudah masuk ke Admin.',
                            icon: 'success',
                            background: swalBg, color: swalColor,
                            confirmButtonColor: '#10b981'
                        }).then(() => location.reload());
                    } else {
                        Swal.fire({
                            title: 'Gagal',
                            text: res.message,
                            icon: 'error',
                            background: swalBg, color: swalColor
                        });
                    }
                });
            }
        });
    });
    // =========================================================================
    // =========================================================================
    const socket = io();
    
    let myTechIdRaw = "<%= teknisi.id %>";
    const myTechId = parseInt(myTechIdRaw) || 0; 
    
    console.log("?? RADAR AKTIF | ID Teknisi Saya:", myTechId);
    // Cek apakah Socket berhasil konek ke Server
    socket.on('connect', () => {
        console.log("?? BATTREY FULL: Terhubung ke Server Socket.io!");
    });
    // Pasang Telinga untuk Sinyal Alarm
    socket.on('alarm_teknisi', function(data) {
        console.log("?? ADA SINYAL MASUK DARI ADMIN:", data); 
        
        // Kita cocokan ID!
        if(parseInt(data.technician_id) === myTechId) {
            console.log("?? SINYAL COCOK! MENYALAKAN ALARM...");
            
            // A. BUNYIKAN ALARM! ?? (Pakai URL Absolut agar tidak error path)
            let audioAlarm = new Audio(window.location.origin + '/sounds/alert.mp3');
            audioAlarm.loop = true;
            
            // Paksa Bunyi!
            let playPromise = audioAlarm.play();
            if (playPromise !== undefined) {
                playPromise.catch(error => {
                    console.log("?? Browser blokir suara (Teknisi belum sentuh layar):", error);
                    Swal.fire({ toast: true, position: 'top-end', icon: 'warning', title: 'Klik layar agar alarm bisa bunyi!', showConfirmButton: false, timer: 3000 });
                });
            }
            // B. MUNCULKAN POP-UP RAKSASA ??
            const isDark = document.body.getAttribute('data-theme') === 'dark';
            const swalBg = isDark ? '#1e293b' : '#ffffff';
            const swalColor = isDark ? '#ffffff' : '#333333';
            Swal.fire({
                icon: 'success',
                title: data.title,
                text: data.message,
                background: swalBg,
                color: swalColor,
                confirmButtonColor: '#10b981',
                confirmButtonText: 'SIAP, LAKSANAKAN! ??',
                allowOutsideClick: false 
            }).then((result) => {
                if (result.isConfirmed) {
                    audioAlarm.pause();
                    audioAlarm.currentTime = 0;
                    location.reload(); // Refresh Halaman!
                }
            });
        } else {
            console.log(`?? Sinyal diabaikan. Sinyal untuk ID: ${data.technician_id}, ID saya: ${myTechId}.`);
        }
    });
</script>
<style>
    @keyframes fade-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in { animation: fade-in 0.4s ease-out forwards; }
</style>
</body>
</html>
