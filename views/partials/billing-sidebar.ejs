<style>
   /* Transisi Global Tetap Utuh */
   #logo-sidebar { transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important; }
   main, footer { transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important; }
   #logo-sidebar a, #logo-sidebar button { overflow: hidden; white-space: nowrap; }
   .sidebar-text, .chevron-icon { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); transform: translateX(0); opacity: 1; visibility: visible; }
   
   body.sidebar-mini #logo-sidebar { width: 5rem !important; }
   body.sidebar-mini .sidebar-text, body.sidebar-mini .chevron-icon { opacity: 0; width: 0; margin-left: 0 !important; visibility: hidden; transform: translateX(-15px); }
   body.sidebar-mini ul[id^="dropdown-"] { display: none !important; }
   body.sidebar-mini #logo-sidebar a, body.sidebar-mini #logo-sidebar button { justify-content: center; padding-left: 0.5rem; padding-right: 0.5rem; }
   
   @media (min-width: 640px) {
       body.sidebar-mini main, body.sidebar-mini footer { margin-left: 5rem !important; }
   }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('btnToggleSidebar');
    const body = document.body;

    if (localStorage.getItem('miniSidebar') === 'true') {
        body.classList.add('sidebar-mini');
    }

    if (toggleBtn) {
        const newToggleBtn = toggleBtn.cloneNode(true);
        toggleBtn.parentNode.replaceChild(newToggleBtn, toggleBtn);
        
        newToggleBtn.addEventListener('click', (e) => {
            if (window.innerWidth >= 640) {
                e.preventDefault();
                e.stopPropagation();
                
                body.classList.toggle('sidebar-mini');
                localStorage.setItem('miniSidebar', body.classList.contains('sidebar-mini'));
            }
        });
    }
});
</script>