<style>
   /* Transisi Global Tetap Utuh */
   #logo-sidebar { transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important; }
   main, footer { transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important; }
   
   /* Animasi default untuk teks (saat sidebar terbuka) */
   #logo-sidebar span, #logo-sidebar i.bi-chevron-down { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); transform: translateX(0); opacity: 1; visibility: visible; }
   #logo-sidebar a, #logo-sidebar button { overflow: hidden; white-space: nowrap; }
   
   /* STATE: MINI SIDEBAR */
   body.sidebar-mini #logo-sidebar { width: 5rem !important; }
   
   /* Efek Teks Menghilang: Transparan, Lebar 0, dan Geser ke kiri (Slide out) */
   body.sidebar-mini #logo-sidebar span,
   body.sidebar-mini #logo-sidebar i.bi-chevron-down { opacity: 0; width: 0; margin-left: 0 !important; visibility: hidden; transform: translateX(-15px); }
   
   /* Paksa Sembunyikan Dropdown jika Sidebar Mini */
   body.sidebar-mini ul[id^="dropdown-"] { display: none !important; }
   
   /* Sentralisasi icon saat mode mini */
   body.sidebar-mini #logo-sidebar a, body.sidebar-mini #logo-sidebar button { justify-content: center; padding-left: 0.5rem; padding-right: 0.5rem; }
   
   /* Geser Konten Utama dan Footer agar melebar memenuhi layar */
   @media (min-width: 640px) {
       body.sidebar-mini main, body.sidebar-mini footer { margin-left: 5rem !important; }
   }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('btnToggleSidebar');
    const body = document.body;
    const sidebar = document.getElementById('logo-sidebar');
    const dropdownParents = document.querySelectorAll('[data-collapse-toggle]');

    // 1. Cek memory (localStorage)
    if (localStorage.getItem('miniSidebar') === 'true') {
        body.classList.add('sidebar-mini');
    }

    // 2. Logika klik tombol garis tiga (JURUS CLONE ANTI-NABRAK)
    if (toggleBtn) {
        // Hapus paksa event listener bawaan template dengan cara diclone
        const newToggleBtn = toggleBtn.cloneNode(true);
        toggleBtn.parentNode.replaceChild(newToggleBtn, toggleBtn);
        
        newToggleBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            if (window.innerWidth >= 640) {
                // LOGIKA DESKTOP: Bikin Sidebar Minimalis
                body.classList.toggle('sidebar-mini');
                localStorage.setItem('miniSidebar', body.classList.contains('sidebar-mini'));
            } else {
                // LOGIKA MOBILE (HP): Geser Sidebar Masuk/Keluar
                if (sidebar) {
                    sidebar.classList.toggle('-translate-x-full');
                }
            }
        });
    }

    // 3. Logika Pintar: Buka sidebar otomatis jika ikon dropdown diklik saat mode mini
    dropdownParents.forEach(btn => {
        btn.addEventListener('click', () => {
            if (body.classList.contains('sidebar-mini')) {
                body.classList.remove('sidebar-mini');
                localStorage.setItem('miniSidebar', 'false');
                // Flowbite akan otomatis membuka dropdownnya
            }
        });
    });
});
</script>
