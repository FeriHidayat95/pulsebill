              </ul>
            </div>
        </div>
    </div>

  </div>
</nav>

<style>
    /* ?? ANIMASI BELL RADAR ?? */
    @keyframes ring {
        0% { transform: rotate(0); }
        10% { transform: rotate(30deg); }
        30% { transform: rotate(-28deg); }
        50% { transform: rotate(34deg); }
        70% { transform: rotate(-32deg); }
        100% { transform: rotate(0); }
    }
    .ringing { 
        animation: ring 0.8s infinite ease-in-out; 
        display: inline-block; 
        color: #00ff00 !important; /* Hijau Neon */
        text-shadow: 0 0 15px rgba(0, 255, 0, 0.5);
    }
    .text-neon-green { color: #00ff00 !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const notificationSound = new Audio('/sounds/alert.mp3'); 
    let isRadarOn = (localStorage.getItem('globalRadarStatus') === 'ON');
    let radarInterval = null;
    let lastSoundTime = 0;
    const CEREWET_INTERVAL = 60000; 

    window.toggleGlobalRadar = function() {
        isRadarOn = !isRadarOn;
        localStorage.setItem('globalRadarStatus', isRadarOn ? 'ON' : 'OFF');
        updateBellUI();
        if (isRadarOn) {
            startRadar();
            notificationSound.play().catch(e => console.log("User Interaction Required"));
        } else {
            stopRadar();
        }
    }

    function updateBellUI() {
        const btn = document.getElementById('globalRadarBtnHeader');
        if(!btn) return;
        if (isRadarOn) {
            btn.innerHTML = '<i class="bi bi-bell-fill text-neon-green text-xl"></i>';
            btn.classList.add('border-green-500/50');
            btn.classList.remove('border-slate-700');
        } else {
            btn.innerHTML = '<i class="bi bi-bell-slash-fill text-red-500 text-lg"></i>';
            btn.classList.remove('border-green-500/50');
            btn.classList.add('border-slate-700');
        }
    }

    async function checkTickets() {
        if (!isRadarOn) return;
        try {
            const [resTrouble, resReg] = await Promise.all([
                fetch('/admin/trouble/api/unresolved-count').then(r => r.json()),
                fetch('/admin/pendaftaran/api/check-pending').then(r => r.json())
            ]);
            
            const total = (resTrouble.count || 0) + (resReg.count || 0);
            const bellIcon = document.querySelector('#globalRadarBtnHeader i');

            if (total > 0) {
                if(bellIcon) bellIcon.classList.add('ringing');
                if (Date.now() - lastSoundTime >= CEREWET_INTERVAL) {
                    notificationSound.play();
                    lastSoundTime = Date.now();
                }
            } else {
                if(bellIcon) bellIcon.classList.remove('ringing');
            }
        } catch (e) { console.error("Radar sync failed"); }
    }

    function startRadar() {
        if (radarInterval) clearInterval(radarInterval);
        radarInterval = setInterval(checkTickets, 10000); 
        checkTickets();
    }

    function stopRadar() {
        if (radarInterval) clearInterval(radarInterval);
        const bellIcon = document.querySelector('#globalRadarBtnHeader i');
        if(bellIcon) bellIcon.classList.remove('ringing');
    }

    updateBellUI();
    if(isRadarOn) startRadar();
});
</script>