  <div class="px-4 w-full flex items-center justify-between">
    
    <div class="flex items-center">
      <button id="btnToggleSidebar" data-drawer-target="logo-sidebar" data-drawer-toggle="logo-sidebar" aria-controls="logo-sidebar" type="button" class="inline-flex items-center p-2 text-sm text-slate-400 rounded-lg hover:bg-slate-800 focus:outline-none transition-all">
          <i class="bi bi-list text-2xl"></i>
      </button>
      
      <a href="/admin/dashboard" class="flex ms-2 md:me-24 items-center no-underline group">
        <img src="/img/<%= typeof settings !== 'undefined' && settings.logo_filename ? settings.logo_filename : 'logo.png' %>?ts=<%= Date.now() %>" 
