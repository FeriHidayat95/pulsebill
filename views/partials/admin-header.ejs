            PULSEBILL <span class="text-blue-500">NETWORK</span>
        </span>
      </a>
    </div>

    <div class="flex items-center gap-3">
        
        <button id="globalRadarBtnHeader" onclick="toggleGlobalRadar()" 
                class="flex items-center justify-center w-11 h-11 rounded-full bg-slate-800 border border-slate-700 hover:border-blue-500/50 transition-all duration-300 shadow-xl group" 
                title="Global Radar Alarm">
            <i class="bi bi-bell-slash-fill text-red-500 text-xl group-hover:scale-110"></i>
        </button>

        <div class="h-8 w-[1px] bg-slate-800 mx-2 hidden md:block"></div>

        <div class="flex items-center">
            <button type="button" class="flex items-center gap-3 bg-slate-800 p-1 pr-3 rounded-full border border-slate-700 focus:ring-4 focus:ring-slate-700 transition-all" aria-expanded="false" data-dropdown-toggle="dropdown-user">
                <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-blue-600 to-blue-800 flex items-center justify-center text-white font-black shadow-lg border border-slate-600 text-xs">
                    <%= typeof user !== 'undefined' && user.name ? user.name.substring(0,3).toUpperCase() : 'ADM' %>
                </div>
                <span class="text-slate-200 text-xs font-bold uppercase tracking-widest hidden md:block">
                    <%= typeof user !== 'undefined' && user.name ? user.name : 'Administrator' %>
                </span>
            </button>
            
            <div class="z-50 hidden my-4 text-base list-none bg-slate-800 divide-y divide-slate-700 rounded-2xl shadow-2xl border border-slate-700 overflow-hidden" id="dropdown-user">
              <div class="px-5 py-4" role="none">
                <p class="text-sm font-black text-white uppercase tracking-tighter" role="none">
                    <%= typeof user !== 'undefined' && user.name ? user.name : 'Administrator' %>
                </p>
                <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mt-1" role="none">
                  <span class="<%= typeof user !== 'undefined' && user.role === 'superadmin' ? 'text-blue-400' : 'text-emerald-400' %>">
                      <%= typeof user !== 'undefined' && user.role === 'superadmin' ? '?? SUPERADMIN' : '?? KASIR' %> 
                  </span>
                  � <%= typeof settings !== 'undefined' ? settings.company_name : 'Control Panel' %>
                </p>
              </div>
              <ul class="py-1" role="none">
                
                <% if (typeof user !== 'undefined' && user.role === 'superadmin') { %>
                <li>
                  <a href="/admin/users" class="flex items-center px-4 py-3 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors border-b border-slate-700/50" role="menuitem">
                    <i class="bi bi-shield-lock-fill me-3 text-purple-400 text-lg"></i> Manajemen Hak Akses
                  </a>
                </li>
                <% } %>

                <% if (typeof user !== 'undefined' && user.role === 'superadmin') { %>
                <li>
                  <a href="/admin/setting" class="flex items-center px-4 py-3 text-sm text-slate-300 hover:bg-slate-700 hover:text-white transition-colors" role="menuitem">
                    <i class="bi bi-gear-fill me-3 text-blue-400"></i> Pengaturan
                  </a>
                </li>
                <% } %>

                <li>
                  <a href="/admin/logout" class="flex items-center px-4 py-3 text-sm text-red-400 hover:bg-red-500/10 transition-colors font-bold" role="menuitem">
