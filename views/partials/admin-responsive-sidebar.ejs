<style>
/* PAKSA CSS DARK UNTUK SIDEBAR */
.mobile-navbar { background: #111827 !important; border-bottom: 1px solid #374151; }
.sidebar { background: #111827 !important; color: #d1d5db !important; }

.sidebar a { 
    color: #9ca3af; 
    text-decoration: none; 
    display: flex; 
    align-items: center;
    padding: 10px 20px; 
    border-radius: 12px; 
    margin: 4px 10px; 
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s ease; 
}

.sidebar a i { font-size: 1.1rem; margin-right: 12px; width: 20px; text-align: center; }

/* Menu Aktif & Hover */
.sidebar a.active { 
    background: #2563eb !important; 
    color: #ffffff !important; 
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
}

.sidebar a:hover:not(.active) { 
    background: #1f2937; 
    color: #ffffff; 
    transform: translateX(5px);
}

.no-scrollbar::-webkit-scrollbar { display: none; }

/* Animasi Lonceng Radar */
@keyframes ring {
    0% { transform: rotate(0); }
    10% { transform: rotate(30deg); }
    30% { transform: rotate(-28deg); }
    50% { transform: rotate(34deg); }
    70% { transform: rotate(-32deg); }
    90% { transform: rotate(30deg); }
    100% { transform: rotate(0); }
}
.ringing { animation: ring 1s infinite ease-in-out; }
.text-neon-green { color: #00ff00 !important; text-shadow: 0 0 10px #00ff00; }

@media (max-width: 767.98px) {
    .sidebar { width: 280px; transform: translateX(-100%); position: fixed; height: 100vh; top: 0; left: 0; z-index: 1050; transition: transform 0.3s; }
    .sidebar.show { transform: translateX(0); }
}
</style>

<script>
    // Logic JS sama seperti aslinya, hanya merapikan pemanggilan
    document.addEventListener('DOMContentLoaded', function() {
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebarClose = document.getElementById('sidebarClose');
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');

        if (sidebarToggle) {
            sidebarToggle.addEventListener('click', () => {
                sidebar.classList.add('show');
                overlay.classList.add('show');
            });
        }
        
        function closeSidebar() {
            sidebar.classList.remove('show');
            overlay.classList.remove('show');
        }

        if (sidebarClose) sidebarClose.addEventListener('click', closeSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);

        // Radar Alarm System (Cerewet Mode)
        const notificationSound = new Audio('/sounds/alert.mp3'); 
        let isRadarOn = (localStorage.getItem('globalRadarStatus') === 'ON');
        let radarInterval = null;
        let lastSoundTime = 0;
        const CEREWET_INTERVAL = 60000;

        window.toggleGlobalRadar = function() {
            isRadarOn = !isRadarOn;
            localStorage.setItem('globalRadarStatus', isRadarOn ? 'ON' : 'OFF');
            updateBellUI(isRadarOn);
            if(isRadarOn) {
                notificationSound.play().catch(e => console.log("Audio playback permitted"));
                startRadar();
            } else {
                stopRadar();
            }
        }

        function updateBellUI(isOn) {
            const icons = document.querySelectorAll('#globalRadarBtnDesktop i, #globalRadarBtnMobile i');
            icons.forEach(icon => {
                if(isOn) {
                    icon.className = 'bi bi-bell-fill text-neon-green';
                } else {
                    icon.className = 'bi bi-bell-slash-fill text-red-500';
                    icon.classList.remove('ringing');
                }
            });
        }

        async function checkNewTickets() {
            if (!isRadarOn) return;
            try {
                const [resTrouble, resReg] = await Promise.all([
                    fetch('/admin/trouble/api/unresolved-count').then(r => r.json()),
                    fetch('/admin/pendaftaran/api/check-pending').then(r => r.json())
                ]);
                const total = (resTrouble.count || 0) + (resReg.count || 0);
                const icons = document.querySelectorAll('#globalRadarBtnDesktop i, #globalRadarBtnMobile i');
                
                if (total > 0) {
                    icons.forEach(i => i.classList.add('ringing'));
                    if (Date.now() - lastSoundTime > CEREWET_INTERVAL) {
                        notificationSound.play().catch(e => {});
                        lastSoundTime = Date.now();
                    }
                } else {
                    icons.forEach(i => i.classList.remove('ringing'));
                }
            } catch (e) {}
        }

        function startRadar() { checkNewTickets(); radarInterval = setInterval(checkNewTickets, 15000); }
        function stopRadar() { clearInterval(radarInterval); }

        if(isRadarOn) { updateBellUI(true); startRadar(); }

        // Restart Mikrotik
        document.getElementById('restartMikrotikBtn')?.addEventListener('click', (e) => {
            e.preventDefault();
            if(confirm('Reboot Mikrotik Sekarang?')) {
                fetch('/admin/mikrotik/restart', {method:'POST'}).then(r => r.json()).then(d => alert(d.message));
            }
        });
    });
</script>