<%- include('partials/header') %>
<%- include('partials/admin-header') %>
<%- include('partials/admin-sidebar', { page: 'setting', settings: settings }) %>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<style>
    /* ========================================= */
    /* ?? BATMAN V7.2 - ACS CORE INTEGRATION ??  */
    /* ========================================= */
    :root {
        --bg-deep: #0b1120; 
        --bg-card: #151e2e; 
        --border-color: #334155;
        --accent-emerald: #10b981; 
        --accent-blue: #3b82f6; 
        --accent-red: #ef4444;
        --sidebar-w: 260px;
    }
    body { background-color: var(--bg-deep) !important; color: #cbd5e1 !important; font-family: 'Inter', sans-serif; font-size: 13px; }
    /* --- LAYOUT FIX (Main Content Minggir Kanan) --- */
    .content-wrapper, .main-content {
        margin-left: var(--sidebar-w) !important; /* Minggir 260px */
        width: calc(100% - var(--sidebar-w)) !important;
        padding: 30px 40px !important;
        position: relative; z-index: 1;
        min-height: 100vh;
        overflow-x: hidden;
    }
    
    /* Fix Mobile */
    @media (max-width: 991px) { 
        .content-wrapper, .main-content { margin-left: 0 !important; width: 100% !important; padding: 80px 20px !important; } 
    }
    /* --- INPUT STYLE (Fix Kotak Putih) --- */
    .form-control, .form-select, input {
        background-color: rgba(11, 17, 32, 0.8) !important;
        border: 1px solid #334155 !important;
        color: #ffffff !important;
        border-radius: 8px !important;
        height: 40px !important;
        box-shadow: none !important;
    }
    .form-control:focus { border-color: var(--accent-blue) !important; }
    
    /* Anti Autofill Putih */
    input:-webkit-autofill {
        -webkit-text-fill-color: #fff;
        -webkit-box-shadow: 0 0 0px 1000px #0b1120 inset;
        transition: background-color 5000s ease-in-out 0s;
    }
    /* --- GRID SYSTEM --- */
    .top-grid-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
    
    .notif-card {
        background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 16px; padding: 20px;
        height: 100%; min-height: 260px; display: flex; flex-direction: column; justify-content: space-between;
        position: relative; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }
    /* Border Colors */
    .b-wa { border-top: 4px solid var(--accent-emerald); }
    .b-support { border-top: 4px solid #f59e0b; }
    .b-brand { border-top: 4px solid var(--accent-blue); }
    .b-gen { border-top: 4px solid #8b5cf6; }
    /* UI Elements */
    .card-head { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #94a3b8; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }
    
    .wa-display {
        background: rgba(16, 185, 129, 0.15); border: 1px solid var(--accent-emerald);
        padding: 12px; border-radius: 8px; color: #fff; text-align: center; font-family: monospace; font-weight: bold; margin-bottom: 10px; font-size: 14px;
    }
    /* Badge Status */
    .status-badge {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        width: 100%; padding: 8px; border-radius: 6px;
        font-weight: 800; font-size: 11px; letter-spacing: 0.5px; text-transform: uppercase; margin-bottom: 15px;
    }
    .status-online { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); }
    .status-offline { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    /* Parameter Grid */
    .param-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px; }
    .param-box { background: rgba(30, 41, 59, 0.5); padding: 15px; border-radius: 10px; border: 1px solid var(--border-color); }
    .param-box label { font-size: 10px; text-transform: uppercase; color: #94a3b8; font-weight: bold; display: block; margin-bottom: 5px; }
    .btn-action { font-weight: bold; text-transform: uppercase; font-size: 11px; border-radius: 6px; padding: 8px 15px; }
    @media (max-width: 1200px) { .top-grid-row { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 768px) { .top-grid-row { grid-template-columns: 1fr; } }
    #qrPopupOverlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(11, 17, 32, 0.9);
        backdrop-filter: blur(8px);
        z-index: 99999;
        display: none;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }
    #qrPopupBox {
        background: #ffffff;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        border: 4px solid var(--accent-emerald);
        text-align: center;
    }
    #qrPopupTitle {
        color: var(--bg-deep);
        font-weight: 900;
        font-size: 18px;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }
</style>
<div class="content-wrapper main-content">
    <div class="d-flex justify-content-between align-items-center mb-4 animate__animated animate__fadeInDown">
        <div>
            <h3 class="text-white fw-bold m-0 tracking-tight">SYSTEM CONFIG</h3>
            <p class="text-secondary small fw-bold m-0">Master Control Panel</p>
        </div>
        <button onclick="location.reload()" class="btn btn-outline-light btn-action border-secondary hover-zoom">
            <i class="bi bi-arrow-clockwise me-1"></i> REFRESH
        </button>
    </div>
    <div class="top-grid-row">
        <div class="notif-card b-wa animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
            <div>
                <div class="card-head text-success"><i class="bi bi-whatsapp"></i> Gateway Status</div>
                <div id="wa-status">
                    <div class="status-badge status-offline"><i class="bi bi-hourglass-split"></i> Loading...</div>
                </div>
                <div id="wa-qr-container" class="d-none text-center mb-3">
                    <p class="text-[10px] text-slate-400 fw-bold mb-2">QR Code Siap di Layar Besar!</p>
                    <button class="btn btn-sm btn-success btn-action w-100" onclick="$('#qrPopupOverlay').css('display', 'flex')">
                        <i class="bi bi-qr-code-scan me-1"></i> TAMPILKAN QR
                    </button>
                </div>
            </div>
            <div class="mt-auto">
                <div class="wa-display" id="wa-display-num">...</div>
                <div class="d-flex gap-2">
                    <button class="btn btn-dark btn-action flex-grow-1 border-secondary" id="btnRefreshQR">Request QR</button>
                    <button class="btn btn-danger btn-action flex-grow-1" id="btnDeleteSession">Logout</button>
                </div>
            </div>
        </div>
        <div class="notif-card b-support animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
            <div class="card-head text-success"><i class="bi bi-shield-check"></i> System Engine</div>
            <div class="text-center flex-grow-1 d-flex flex-column align-items-center justify-content-center p-3">
                <span class="badge bg-success mb-2 px-3 py-2">Operational</span>
                <p class="text-secondary small m-0">PulseBill Engine v1.0.0 (Node 20 LTS)</p>
            </div>
            <p class="text-center text-secondary small m-0 mt-2">Zero-leak audited.</p>
        </div>
        <div class="notif-card b-brand animate__animated animate__fadeInUp" style="animation-delay: 0.3s;">
            <div class="card-head text-primary"><i class="bi bi-brush-fill"></i> Branding</div>
            
            <div class="text-center p-3 rounded border border-secondary mb-3 d-flex align-items-center justify-content-center" style="background-color: #0f172a; min-height: 80px;">
                <img id="logoPreview" src="/img/<%= typeof settings !== 'undefined' && settings.logo_filename ? settings.logo_filename : 'logo.png' %>" style="max-height: 55px; object-fit: contain;">
            </div>
            
            <div class="mt-auto">
                <form id="logoUploadForm" enctype="multipart/form-data">
                    
                    <style>
                        .file-custom::file-selector-button {
                            background-color: #334155; color: #fff; border: none;
                            padding: 6px 12px; border-radius: 6px; font-weight: bold;
                            font-size: 11px; cursor: pointer; margin-right: 10px; text-transform: uppercase;
                            transition: all 0.3s ease;
                        }
                        .file-custom::file-selector-button:hover { background-color: #475569; }
                    </style>
                    
                    <input type="file" name="logo" class="form-control form-control-sm mb-3 file-custom text-secondary" style="background-color: #0b1120 !important; border: 1px solid #334155 !important; border-radius: 8px;">
                    
                    <button type="submit" class="btn w-100 text-white fw-bold btn-action" style="background-color: #3b82f6; border: none; padding: 10px; border-radius: 8px;">
                        <i class="bi bi-upload me-1"></i> UPDATE LOGO
                    </button>
                    
                </form>
            </div>
        </div>
        <div class="notif-card b-gen animate__animated animate__fadeInUp" style="animation-delay: 0.4s;">
            <div class="card-head text-info"><i class="bi bi-cpu-fill"></i> Tools</div>
            <div class="d-flex flex-column flex-grow-1 justify-content-end">
                <input type="text" id="vpsPublicIp" class="form-control mb-2" placeholder="IP VPS Server...">
                <div class="d-flex gap-2 mb-2">
                    <button id="generateMikrotikScript" class="btn btn-primary btn-action w-100">MT</button>
                    <button id="generateBurstLimit" class="btn btn-warning btn-action w-100">Burst</button>
                </div>
                <div id="generatedScript" class="bg-black text-success p-2 rounded small font-monospace overflow-hidden border border-secondary" style="height: 35px; line-height: 1.5;"># Ready...</div>
            </div>
        </div>
    </div>
    <div class="row mb-4 animate__animated animate__fadeIn" style="animation-delay: 0.5s;">
        <div class="col-12">
            <div class="notif-card h-auto p-4" style="border-top: 4px solid var(--accent-red);">
                <div class="card-head text-danger m-0 border-0 p-0 mb-4"><i class="bi bi-database-fill"></i> Backup & Recovery</div>
                
                <div class="d-flex gap-4 align-items-end flex-wrap">
                    <div>
                        <label class="text-[10px] text-slate-400 font-bold mb-2 d-block uppercase tracking-widest">Buat Backup</label>
                        <button id="createBackupBtn" type="button" class="btn btn-action px-4 py-2 text-white" style="background-color: #ef4444; border: 1px solid #b91c1c;">
                            <i class="bi bi-cloud-arrow-down-fill me-2"></i> INSTANT BACKUP
                        </button>
                    </div>
                    
                    <div class="flex-grow-1" style="max-width: 400px;">
                        <label class="text-[10px] text-slate-400 font-bold mb-2 d-block uppercase tracking-widest">Pilih File Restore</label>
                        <div class="d-flex gap-2">
                            <select id="backupFile" class="form-control form-select flex-grow-1 text-white" style="background-color: #0f172a; border-color: #334155;"></select>
                            <button id="restoreBackupBtn" type="button" class="btn btn-action px-4 py-2 text-dark" style="background-color: #f59e0b; border: 1px solid #d97706;" disabled>
                                <i class="bi bi-arrow-counterclockwise me-1"></i> RESTORE
                            </button>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-3 border-top border-secondary">
                    <label class="text-[10px] text-slate-400 font-bold mb-2 d-block uppercase tracking-widest">Daftar File Server</label>
                    <div class="rounded border border-secondary p-2 w-100" style="max-height: 150px; overflow-y: auto; background-color: #0b1120;">
                        <table class="table table-borderless table-sm mb-0 small text-info w-100" id="backupTable">
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row animate__animated animate__fadeIn" style="animation-delay: 0.6s;">
        <div class="col-12">
            <div class="notif-card h-auto p-4" style="border-top: 4px solid var(--accent-blue);">
                <div class="card-head text-primary border-0 p-0 mb-3"><i class="bi bi-sliders"></i> Global Settings</div>
                <form id="settingsForm">
                    <div id="settingsFields" class="param-grid"></div>
                    <div class="mt-4 pt-3 border-top border-secondary text-end">
                        <button type="submit" class="btn btn-primary btn-action px-5 py-2 fs-6">Save Configuration</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div id="notif-container" class="position-fixed top-0 end-0 p-4" style="z-index: 11000;"></div>
<div id="qrPopupOverlay">
    <div id="qrPopupBox" class="animate__animated animate__zoomIn">
        <div id="qrPopupTitle"><i class="bi bi-whatsapp text-success me-2"></i>SCAN QR WHATSAPP</div>
        <div id="qrBesarContainer" class="p-2 bg-white d-inline-block rounded shadow"></div>
        <div class="mt-4">
            <button class="btn btn-danger btn-action w-100" onclick="$('#qrPopupOverlay').fadeOut()">TUTUP</button>
        </div>
    </div>
</div>
<script>
$(document).ready(function() {
    // 1. Toast Notification
    function notify(type, msg) {
        const id = Date.now();
        const html = `<div id="toast-${id}" class="toast show align-items-center text-white bg-${type==='success'?'success':'danger'} border-0 mb-2 shadow" role="alert">
            <div class="d-flex"><div class="toast-body fw-bold">${msg}</div></div>
        </div>`;
        $('#notif-container').append(html);
        setTimeout(() => $(`#toast-${id}`).fadeOut(() => $(`#toast-${id}`).remove()), 3000);
    }
    // 2. Load Settings
    function loadSettings() {
        $.get('/admin/setting/data', function(data) {
            let html = '';
            if (!data || Object.keys(data).length === 0) {
                $('#settingsFields').html('<div class="text-danger">Gagal memuat parameter.</div>');
                return;
            }
            const blacklist = ['secret_key','tripay','monitorInterval','session_path','logo_filename'];
            const traverse = (obj, prefix = '') => {
                Object.keys(obj).forEach(k => {
                    const fullKey = prefix ? `${prefix}.${k}` : k;
                    if(blacklist.some(b => fullKey.includes(b))) return;
                    if(typeof obj[k] === 'object' && obj[k] !== null) traverse(obj[k], fullKey);
                    else {
                        html += `
                        <div class="param-box">
                            <label>${fullKey.replace(/_/g, ' ')}</label>
                            <input type="text" class="form-control" name="${fullKey}" value="${obj[k]}">
                        </div>`;
                    }
                });
            };
            traverse(data); $('#settingsFields').html(html);
        }).fail(() => $('#settingsFields').html('<div class="text-danger">Error Connection.</div>'));
    }
    loadSettings();
    // 3. WA Status & QR Raksasa
    let lastQrText = ''; // Simpan QR text terakhir biar ga render ulang kalau sama
    
    function loadWA() {
        $.get('/admin/setting/wa-status', (res) => {
            const statusDiv = $('#wa-status');
            const numDiv = $('#wa-display-num');
            
            if(res.connected) {
                statusDiv.html(`<div class="status-badge status-online"><i class="bi bi-wifi me-2"></i>SYSTEM ONLINE</div>`);
                numDiv.text(res.phoneNumber).css({'color': '#34d399', 'text-shadow': '0 0 10px #10b981'});
                $('#wa-qr-container').addClass('d-none');
                $('#qrPopupOverlay').fadeOut(); // Otomatis tutup pop-up jika sukses connect
            } else {
                statusDiv.html(`<div class="status-badge status-offline"><i class="bi bi-x-circle me-2"></i>OFFLINE</div>`);
                numDiv.text("SCAN QR").css('color', '#ef4444');
                
                if(res.qr && res.qr !== lastQrText) {
                    lastQrText = res.qr;
                    $('#wa-qr-container').removeClass('d-none'); 
                    
                    // Render ke Pop-up Besar (Lebih HD)
                    $('#qrBesarContainer').empty();
                    new QRCode($('#qrBesarContainer')[0], { 
                        text: res.qr, 
                        width: 250,  // ?? Ukuran Jumbo
                        height: 250, // ?? Ukuran Jumbo
                        colorDark : "#000000",
                        colorLight : "#ffffff",
                        correctLevel : QRCode.CorrectLevel.H
                    });
                    
                    // Otomatis Munculkan Popup saat QR pertama kali didapat
                    $('#qrPopupOverlay').css('display', 'flex');
                }
            }
        });
    }
    loadWA(); setInterval(loadWA, 5000); // ?? Interval dipercepat jadi 5 detik biar QR cepat muncul
    // 4. Backup Logic (SUDAH DIPERBAIKI)
    function loadBackups() {
        $.get('/admin/setting/backups', (res) => {
            if(!res.success) return;
            const tbody = $('#backupTable tbody').empty();
            const select = $('#backupFile').empty().append('<option value="">-- Pilih File Untuk Restore --</option>');
            
            res.backups.slice(0, 5).forEach(b => { // Tampilkan 5 file terakhir
                tbody.append(`<tr><td class="text-info font-monospace ps-2">${b.filename}</td><td class="text-end pe-3"><a href="/admin/setting/download-backup/${b.filename}" class="text-white hover-zoom d-inline-block"><i class="bi bi-download"></i></a></td></tr>`);
                select.append(`<option value="${b.filename}">${b.filename}</option>`);
            });
        });
    }
    loadBackups();
    // Trigger Backup
    $('#createBackupBtn').click(() => {
        const btn = $('#createBackupBtn');
        btn.html('<i class="bi bi-hourglass-split animate-spin me-2"></i> Proses...');
        $.post('/admin/setting/backup', () => { 
            notify('success', 'Backup Selesai'); 
            loadBackups(); 
            btn.html('<i class="bi bi-cloud-arrow-down-fill me-2"></i> INSTANT BACKUP');
        });
    });
    // Deteksi Pilihan File
    $('#backupFile').change(function() { 
        $('#restoreBackupBtn').prop('disabled', !$(this).val()); 
    });
    // Logika Restore yang Benar (Mengirim Nama File)
    $('#restoreBackupBtn').click(() => {
        const fileName = $('#backupFile').val();
        if(confirm('YAKIN RESTORE KE: ' + fileName + '? Semua data saat ini akan tertimpa!')) {
            const btn = $('#restoreBackupBtn');
            btn.prop('disabled', true).html('<i class="bi bi-hourglass-split me-1"></i> Restoring...');
            
            $.post('/admin/setting/restore', { filename: fileName }, function(res) {
                notify('success', 'Restore berjalan! Server akan dimuat ulang.');
                setTimeout(() => location.reload(), 3000);
            }).fail(function() {
                notify('danger', 'Gagal merestore database.');
                btn.prop('disabled', false).html('<i class="bi bi-arrow-counterclockwise me-1"></i> RESTORE');
            });
        }
    });
    $('#settingsForm').submit(function(e) {
        e.preventDefault();
        const formData = {}; $(this).find('input').each(function() { formData[$(this).attr('name')] = $(this).val(); });
        $.post('/admin/setting/save', formData, (res) => notify('success', 'Disimpan!'));
    });
    $('#btnRefreshQR').click(() => {
        lastQrText = ''; // Reset histori QR
        $.post('/admin/setting/wa-refresh', () => {
            notify('success', 'Meminta QR Baru...');
            loadWA();
        });
    });
    
    $('#btnDeleteSession').click(() => confirm('Logout?') && $.post('/admin/setting/wa-delete', loadWA));
    
    $('#logoUploadForm').submit(function(e) {
        e.preventDefault();
        $.ajax({ url: '/admin/setting/upload-logo', type: 'POST', data: new FormData(this), contentType: false, processData: false, success: () => location.reload() });
    });
});
</script>
