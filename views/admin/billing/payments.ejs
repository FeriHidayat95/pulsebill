<%- include('../../partials/header') %>
<body class="bg-[#05080f] text-slate-300 font-sans antialiased selection:bg-blue-500 selection:text-white no-scrollbar">
<%- include('../../partials/admin-header') %>
<%- include('../../partials/billing-sidebar', { page: 'payments', settings: typeof settings !== 'undefined' ? settings : {} }) %>
<style>
    /* =========================================================
       ?? TEMA GEMBOK RADIUS (ELEGANT V4 - FIX POLOS & NUMPUK)
       ========================================================= */
    :root { 
        --bg-deep: #05080f; 
        --card-bg: #111827; 
        --border-color: #1e293b; 
    }
    
    .gembok-card { 
        background: var(--card-bg); 
        border-radius: 12px; 
        border: 1px solid var(--border-color); 
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2); 
        overflow: hidden; 
        position: relative; 
    }
    
    .gembok-input { 
        background-color: #020617 !important; 
        border: 1px solid var(--border-color) !important; 
        color: #f1f5f9 !important; 
        border-radius: 8px !important; 
        outline: none; 
        transition: 0.3s; 
    }
    .gembok-input:focus-within { border-color: #3b82f6 !important; box-shadow: 0 0 0 1px #3b82f6; }
    
    /* Supaya Icon Kalender jadi putih dan bisa di-klik */
    ::-webkit-calendar-picker-indicator { filter: invert(1); opacity: 0.5; cursor: pointer; }
    /* Tabel Gembok Style */
    .gembok-table th { color: #64748b; font-size: 0.7rem; font-weight: 800; padding: 0.8rem 1rem; border-bottom: 1px solid var(--border-color); text-transform: uppercase; letter-spacing: 0.05em; }
    .gembok-table td { color: #94a3b8; font-size: 0.75rem; padding: 0.8rem 1rem; border-bottom: 1px solid var(--border-color); vertical-align: middle; }
    .gembok-table tr:hover td { background-color: rgba(255,255,255,0.02); }
    // Schema definition
    .dataTables_wrapper .dataTables_filter, .dataTables_wrapper .dataTables_length { display: none; }
    .dataTables_wrapper .dataTables_paginate { display: flex; gap: 4px; justify-content: flex-end; padding-top: 15px;}
    .dataTables_wrapper .dataTables_paginate .paginate_button { color: #94a3b8 !important; border: 1px solid var(--border-color) !important; padding: 4px 12px !important; margin: 0 !important; border-radius: 6px !important; font-size: 0.75rem; font-weight: bold; background: #020617 !important; cursor: pointer; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current, 
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover { background: #3b82f6 !important; color: white !important; border-color: #3b82f6 !important; }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover { background: #1e293b !important; color: white !important; }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled { opacity: 0.4; cursor: not-allowed; }
    .dataTables_info { color: #64748b !important; font-size: 0.7rem !important; padding-top: 15px !important; font-weight: bold; text-transform: uppercase;}
    .no-scrollbar::-webkit-scrollbar { display: none; }
</style>
<main class="p-4 sm:ml-64 pt-24 min-h-screen transition-all duration-300">
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-black text-white tracking-tighter uppercase">Riwayat <span class="text-blue-500">Transaksi</span></h1>
            <div class="flex items-center gap-2 mt-1">
                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full animate-pulse"></span>
                <p class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Financial Ledger Engine</p>
            </div>
        </div>
        
        <div class="flex flex-wrap gap-2">
            <button onclick="location.reload()" class="px-4 py-2 text-[10px] font-black text-slate-400 bg-slate-900 border border-slate-700 rounded-lg hover:bg-slate-800 hover:text-white transition-all uppercase tracking-wider">
                <i class="bi bi-arrow-clockwise me-1"></i> Refresh
            </button>
            <a href="/admin/billing/export/payments" class="px-4 py-2 text-[10px] font-black text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-lg hover:bg-emerald-500 hover:text-white transition-all uppercase tracking-wider flex items-center">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export
            </a>
            <button onclick="openModalBayar()" class="px-5 py-2 text-[10px] font-black text-white bg-blue-600 rounded-lg hover:bg-blue-700 shadow-lg shadow-blue-500/20 transition-all uppercase tracking-wider flex items-center">
                <i class="bi bi-plus-lg me-1"></i> Catat Transaksi
            </button>
        </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="gembok-card p-5 pl-6 relative">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-blue-500"></div>
            <div class="text-blue-400 font-black text-[10px] uppercase tracking-widest mb-1.5">Total Transaksi</div>
            <div class="text-white font-black text-2xl tracking-tight leading-none"><%= payments ? payments.length : 0 %> <span class="text-xs text-slate-500 ml-1">TRX</span></div>
        </div>
        <div class="gembok-card p-5 pl-6 relative">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-emerald-500"></div>
            <div class="text-emerald-500 font-black text-[10px] uppercase tracking-widest mb-1.5">Total Uang Masuk</div>
            <div class="text-emerald-400 font-black text-2xl tracking-tight leading-none">Rp <%= payments ? payments.reduce((sum, p) => sum + parseFloat(p.amount || 0), 0).toLocaleString('id-ID') : '0' %></div>
        </div>
        <div class="gembok-card p-5 pl-6 relative">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-cyan-500"></div>
            <div class="text-cyan-500 font-black text-[10px] uppercase tracking-widest mb-1.5">Metode Tunai</div>
            <div class="text-white font-black text-2xl tracking-tight leading-none"><%= payments ? payments.filter(p => (p.payment_method || '').toLowerCase().includes('cash')).length : 0 %> <span class="text-xs text-slate-500 ml-1">TRX</span></div>
        </div>
        <div class="gembok-card p-5 pl-6 relative">
            <div class="absolute left-0 top-0 bottom-0 w-1.5 bg-purple-500"></div>
            <div class="text-purple-400 font-black text-[10px] uppercase tracking-widest mb-1.5">Metode Digital</div>
            <div class="text-white font-black text-2xl tracking-tight leading-none"><%= payments ? payments.filter(p => !(p.payment_method || '').toLowerCase().includes('cash')).length : 0 %> <span class="text-xs text-slate-500 ml-1">TRX</span></div>
        </div>
    </div>
    <div class="gembok-card p-3 mb-4 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
            <div class="text-slate-500 text-[10px] font-black uppercase tracking-widest me-1"><i class="bi bi-funnel-fill text-blue-500"></i> Filter:</div>
            
            <div class="flex items-center gembok-input px-3 py-1.5 gap-2">
                <i class="bi bi-calendar3 text-slate-500"></i>
                <input type="date" id="startDate" class="bg-transparent border-none text-[11px] font-bold text-slate-300 outline-none w-28 cursor-pointer">
                <span class="text-slate-600">-</span>
                <input type="date" id="endDate" class="bg-transparent border-none text-[11px] font-bold text-slate-300 outline-none w-28 cursor-pointer">
            </div>
            <select id="filterMethod" class="gembok-input px-3 py-1.5 text-[11px] font-bold w-auto cursor-pointer">
                <option value="">Semua Metode</option>
                <option value="CASH">Tunai (Cash)</option>
                <option value="TRANSFER">Transfer / Digital</option>
            </select>
        </div>
        <div class="flex items-center gembok-input px-3 py-1.5 gap-2 w-full md:w-64">
            <i class="bi bi-search text-slate-500 text-xs"></i>
            <input type="text" id="customSearch" class="bg-transparent border-none outline-none text-[11px] font-bold text-slate-300 w-full" placeholder="Cari transaksi...">
        </div>
    </div>
    <div class="gembok-card p-4">
        <div class="overflow-x-auto">
            <table id="paymentsTable" class="w-full text-left gembok-table">
                <thead class="bg-[#020617]">
                    <tr>
                        <th class="text-center w-10">No</th>
                        <th>Tanggal & Waktu</th>
                        <th>Item / Pelanggan</th>
                        <th>Type</th>
                        <th>Admin / Kasir</th>
                        <th class="text-center">Metode</th>
                        <th class="text-right">Nominal (Rp)</th>
                        <th class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
</main>
<div id="modalBayar" class="fixed inset-0 z-[100] hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-4">
    <div class="gembok-card w-full max-w-md shadow-2xl overflow-hidden rounded-[2rem]">
        <div class="bg-[#020617] p-5 border-b border-[#1e293b] flex justify-between items-center">
            <h3 class="text-white font-black uppercase tracking-tighter text-sm flex items-center gap-2"><i class="bi bi-wallet2 text-blue-500"></i> Catat Pembukuan</h3>
            <button onclick="closeModal()" class="text-slate-500 hover:text-white transition-all text-xl">&times;</button>
        </div>
        
        <form id="formProsesBayar" class="p-6 space-y-5 bg-[#0f172a]">
            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Deskripsi / Keterangan</label>
                <input type="text" name="description" class="gembok-input w-full font-bold uppercase text-white px-3 py-2" placeholder="Cth: BAYAR PLN / JUAL ROUTER" required>
            </div>
            
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Tipe Transaksi</label>
                    <select name="type" class="gembok-input w-full px-3 py-2 font-bold">
                        <option value="income">PEMASUKAN (+)</option>
                        <option value="expense">PENGELUARAN (-)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Metode</label>
                    <select name="payment_method" class="gembok-input w-full px-3 py-2 font-bold">
                        <option value="CASH">TUNAI (CASH)</option>
                        <option value="TRANSFER">TRANSFER BANK</option>
                    </select>
                </div>
            </div>
            
            <div>
                <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2">Jumlah (Rp)</label>
                <input type="number" name="amount" class="gembok-input w-full px-3 py-2 text-emerald-400 font-black" placeholder="0" required min="1">
            </div>
            
            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black py-3.5 mt-2 rounded-xl transition-all uppercase text-[10px] tracking-widest shadow-lg shadow-blue-500/20">
                Simpan Ke Pembukuan
            </button>
        </form>
    </div>
</div>
<%- include('../../partials/footer') %>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Tangkap data role dari server EJS agar JS tahu siapa yang login
    const userRole = '<%= typeof user !== "undefined" && user.role ? user.role : "" %>';
    $(document).ready(function() {
        // ==============================================================
        // INISIALISASI DATATABLES SERVER-SIDE (AJAX) TRANSAKSI
        // ==============================================================
        var table = $('#paymentsTable').DataTable({
            responsive: true,
            processing: true,
            serverSide: true,
            pageLength: 10,
            order: [[1, 'desc']], // Urutkan dari Tanggal & Waktu terbaru (kolom ke-1)
            dom: '<"min-h-[300px]"t><"flex flex-col md:flex-row justify-between items-center mt-2"ip>',
            language: {
                search: "",
                zeroRecords: "Tidak ada transaksi ditemukan.",
                info: "SHOWING _START_ TO _END_ OF _TOTAL_ ENTRIES",
                paginate: { next: ">", previous: "<" },
                processing: "<div class='text-blue-500 font-black uppercase tracking-widest p-4 bg-[#111827] rounded-xl border border-slate-700 shadow-xl'><i class='bi bi-arrow-repeat animate-spin text-xl inline-block me-2'></i> Memuat Data Kas...</div>"
            },
            ajax: {
                url: '/admin/billing/payments/datatable',
                type: 'POST',
                // ?? KIRIM DATA FILTER DARI INPUT HTML KE BACKEND ??
                data: function(d) {
                    d.filterMethod = $('#filterMethod').val();
                    d.startDate = $('#startDate').val();
                    d.endDate = $('#endDate').val();
                }
            },
            columns: [
                { 
                    data: null, 
                    orderable: false, 
                    searchable: false,
                    className: 'text-center font-bold text-slate-600',
                    render: function(data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1; // Penomoran Otomatis
                    }
                },
                {
                    data: 'payment_date',
                    name: 'payment_date',
                    render: function(data, type, row) {
                        const d = new Date(row.payment_date);
                        const dateStr = d.toLocaleDateString('id-ID', {day:'2-digit', month:'short', year:'numeric'});
                        const timeStr = d.toLocaleTimeString('id-ID', {hour:'2-digit', minute:'2-digit'});
                        return `
                            <div class="text-white font-bold">${dateStr}</div>
                            <div class="text-slate-500 text-[9px] mt-0.5 font-bold uppercase tracking-wider">${timeStr} WIB</div>
                        `;
                    }
                },
                {
                    data: 'customer_name',
                    name: 'customer_name',
                    render: function(data, type, row) {
                        const custName = row.customer_name || 'TRANSAKSI UMUM';
                        let linkHtml = '';
                        if (row.invoice_number && row.invoice_number.startsWith('TRX-')) {
                            linkHtml = `<span class="text-slate-500 text-[10px] font-mono font-bold uppercase">${row.notes || 'Catatan Transaksi'}</span>`;
                        } else {
                            linkHtml = `
                                <a href="/admin/billing/invoices/${row.invoice_id}" class="text-blue-500 hover:text-blue-400 text-[10px] font-mono font-bold uppercase">
                                    INV-${row.invoice_number || 'MANUAL'}
                                </a>
                            `;
                        }
                        return `
                            <div class="text-white font-black text-[11px] uppercase tracking-wide mb-0.5">${custName}</div>
                            ${linkHtml}
                        `;
                    }
                },
                {
                    data: 'amount',
                    name: 'amount',
                    render: function(data, type, row) {
                        if (parseFloat(row.amount) < 0) {
                            return `<span class="text-red-500 font-black text-[9px] uppercase tracking-widest">Expense</span>`;
                        } else {
                            return `<span class="text-emerald-500 font-black text-[9px] uppercase tracking-widest">Revenue</span>`;
                        }
                    }
                },
                {
                    data: 'admin_name',
                    name: 'admin_name',
                    className: 'text-blue-400 font-bold text-[10px] uppercase tracking-widest',
                    render: function(data, type, row) {
                        return row.admin_name || row.admin || 'SYSTEM';
                    }
                },
                {
                    data: 'payment_method',
                    name: 'payment_method',
                    className: 'text-center',
                    render: function(data, type, row) {
                        const method = row.payment_method || 'UNKNOWN';
                        const isCash = method.toLowerCase().includes('cash');
                        const cssClass = isCash ? 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20' : 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20';
                        return `<span class="px-2.5 py-1 rounded text-[9px] font-black uppercase tracking-widest border ${cssClass}">${method}</span>`;
                    }
                },
                {
                    data: 'amount',
                    name: 'amount',
                    className: 'text-right text-white font-black font-mono text-[11px]',
                    render: function(data, type, row) {
                        return parseFloat(row.amount || 0).toLocaleString('id-ID');
                    }
                },
                {
                    data: 'id', // Default pakai id pembayaran
                    orderable: false,
                    searchable: false,
                    className: 'text-center',
                    render: function(data, type, row) {
                        const pid = row.id || row.payment_id;
                        let buttons = '<div class="flex justify-center gap-2">';
                        
                        // Tampilkan tombol PRINT khusus jika bukan TRX Pengeluaran
                        if (!row.invoice_number || !row.invoice_number.startsWith('TRX-')) {
                            buttons += `
                                <button onclick="window.open('/admin/billing/invoices/${row.invoice_id}/print', '_blank')" class="w-7 h-7 rounded-lg bg-slate-800 text-slate-400 hover:text-white hover:bg-blue-600 transition-all flex items-center justify-center border border-slate-700" title="Cetak">
                                    <i class="bi bi-printer text-xs"></i>
                                </button>
                            `;
                        }
                        // Proteksi Hapus: Hanya muncul jika BUKAN kasir
                        if (userRole !== 'kasir') {
                            buttons += `
                                <button onclick="voidTransaction('${pid}')" class="w-7 h-7 rounded-lg bg-red-500/10 text-red-500 hover:bg-red-600 hover:text-white transition-all flex items-center justify-center border border-red-500/20" title="Batalkan/Hapus">
                                    <i class="bi bi-trash text-xs"></i>
                                </button>
                            `;
                        }
                        buttons += '</div>';
                        return buttons;
                    }
                }
            ]
        });
        // ==============================================================
        // LOGIKA FITUR FILTER AJAX
        // ==============================================================
        $('#customSearch').on('keyup', function() {
            table.search(this.value).draw();
        });
        // Trigger tabel reload ketika filter Dropdown / Tanggal diubah
        $('#filterMethod, #startDate, #endDate').on('change', function() {
            table.ajax.reload();
        });
    });
    function openModalBayar() { $('#modalBayar').removeClass('hidden').addClass('flex'); }
    function closeModal() { $('#modalBayar').addClass('hidden').removeClass('flex'); }
    $('#formProsesBayar').submit(function(e) {
        e.preventDefault();
        const btn = $(this).find('button[type="submit"]');
        const originalText = btn.text();
        btn.prop('disabled', true).text('PROCESSING...');
        $.post('/admin/billing/custom-transaction', $(this).serialize())
        .done(function(res) {
            if(res.success) {
                Swal.fire({ icon: 'success', title: 'BERHASIL!', background: '#0a0f1e', color: '#fff', timer: 2000, showConfirmButton: false })
                .then(() => location.reload());
            } else {
                Swal.fire({ icon: 'error', title: 'GAGAL', text: res.message, background: '#0a0f1e', color: '#fff' });
                btn.prop('disabled', false).text(originalText);
            }
        }).fail(function() {
            Swal.fire({ icon: 'error', title: 'ERROR', text: 'Koneksi terputus atau Rute belum dipasang!', background: '#0a0f1e', color: '#fff' });
            btn.prop('disabled', false).text(originalText);
        });
    });
    function voidTransaction(paymentId) {
        if (!paymentId) return;
        Swal.fire({
            title: 'Hapus Transaksi?', text: "Transaksi akan dibatalkan permanen!", icon: 'warning',
            showCancelButton: true, confirmButtonColor: '#ef4444', background: '#0a0f1e', color: '#fff',
            confirmButtonText: 'YA, HAPUS!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/admin/billing/void-payment', method: 'POST', data: { id: paymentId },
                    success: function(res) {
                        if (res.success) {
                            Swal.fire({ icon: 'success', title: 'Dihapus!', background: '#0a0f1e', color: '#fff', timer: 1500, showConfirmButton: false }).then(() => location.reload());
                        } else {
                            Swal.fire({ icon: 'error', title: 'Gagal', text: res.message, background: '#0a0f1e', color: '#fff' });
                        }
                    }
                });
            }
        });
    }
</script>
</body>
</html>
