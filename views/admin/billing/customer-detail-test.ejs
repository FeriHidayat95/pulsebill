<%- include('../../partials/header') %>

<body class="bg-[#0f172a] text-slate-300 font-sans antialiased">

<%- include('../../partials/admin-header') %>
<%- include('../../partials/billing-sidebar', { page: 'customers', settings: {} }) %>

<main class="p-4 sm:ml-64 pt-24 min-h-screen">
    
    <div class="mb-6">
        <h1 class="text-2xl font-black text-white uppercase tracking-tight">Detail Pelanggan <span class="text-amber-500">(DEBUG MODE)</span></h1>
        <p class="text-xs font-bold text-slate-500 uppercase mt-1">Halaman ini hanya untuk developer checking data JSON</p>
    </div>

    <div class="bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-700 bg-[#111827]/50 flex justify-between items-center">
            <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center gap-2">
                <i class="bi bi-bug-fill text-red-500 text-lg"></i> JSON RAW DATA
            </h3>
        </div>
        <div class="p-0">
            <pre class="text-xs font-mono text-emerald-400 bg-[#0f172a] p-6 overflow-x-auto whitespace-pre-wrap"><%= JSON.stringify({ customer, invoices, packages }, null, 2) %></pre>
        </div>
    </div>

</main>

<%- include('../../partials/footer') %>
</body>
</html>