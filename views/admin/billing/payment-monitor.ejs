<%- include('../../partials/header') %>
<body class="bg-[#0f172a] text-slate-300 font-sans antialiased selection:bg-blue-500 selection:text-white">

<%- include('../../partials/admin-header') %>

<%- include('../../partials/billing-sidebar', { page: 'payment-monitor', settings: settings }) %>

<main class="p-4 sm:ml-64 pt-20 min-h-screen">

    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tighter uppercase leading-none">
                Payment <span class="text-blue-500">Monitor</span>
            </h1>
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[4px] mt-2">Real-time Gateway & Transaction Tracking</p>
        </div>
        
        <button onclick="refreshData()" class="group relative inline-flex items-center justify-center px-5 py-2.5 text-xs font-black text-white bg-slate-800 border border-slate-700 rounded-xl hover:bg-slate-700 transition-all uppercase tracking-widest">
            <i class="bi bi-arrow-clockwise me-2 group-hover:rotate-180 transition-transform duration-500"></i> Refresh Data
        </button>
    </div>

    <div class="bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden mb-8 group hover:border-blue-500/30 transition-all">
        <div class="px-6 py-4 border-b border-slate-700 bg-[#111827]/50">
            <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center gap-2">
                <i class="bi bi-hdd-network text-cyan-400"></i> Status Gateway Pembayaran
            </h3>
        </div>
        <div class="p-6">
            <div id="gatewayStatus" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="col-span-3 text-center py-6 text-slate-500 flex flex-col items-center gap-3">
                    <div class="animate-spin w-8 h-8 border-4 border-blue-500 border-t-transparent rounded-full"></div>
                    <span class="text-[10px] font-black uppercase tracking-widest">Menghubungkan ke API Gateway...</span>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden mb-8 group hover:border-red-500/30 transition-all">
        <div class="px-6 py-4 border-b border-slate-700 bg-[#111827]/50 flex justify-between items-center">
            <h3 class="text-xs font-black text-red-500 uppercase tracking-widest flex items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill"></i> Pembayaran Gagal (Web)
            </h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-slate-400">
                <thead class="text-[10px] text-slate-500 uppercase bg-[#111827]/30 border-b border-slate-700">
                    <tr>
                        <th class="px-6 py-4 font-black tracking-wider">Invoice</th>
                        <th class="px-6 py-4 font-black tracking-wider">Pelanggan</th>
                        <th class="px-6 py-4 font-black tracking-wider">Jumlah</th>
                        <th class="px-6 py-4 font-black tracking-wider">Gateway</th>
                        <th class="px-6 py-4 font-black tracking-wider text-center">Status</th>
                        <th class="px-6 py-4 font-black tracking-wider">Waktu</th>
                        <th class="px-6 py-4 font-black tracking-wider text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody id="failedPaymentsTable" class="divide-y divide-slate-700/50">
                    <tr><td colspan="7" class="px-6 py-12 text-center text-slate-600 font-bold uppercase text-[10px] tracking-widest italic">Tidak ada log kegagalan terdeteksi</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden mb-10 group hover:border-emerald-500/30 transition-all">
        <div class="px-6 py-4 border-b border-slate-700 bg-[#111827]/50">
            <h3 class="text-xs font-black text-emerald-500 uppercase tracking-widest flex items-center gap-2">
                <i class="bi bi-clock-history"></i> Transaksi Terbaru (Lunas)
            </h3>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-slate-400">
                <thead class="text-[10px] text-slate-500 uppercase bg-[#111827]/30 border-b border-slate-700">
                    <tr>
                        <th class="px-6 py-4 font-black tracking-wider">Invoice</th>
                        <th class="px-6 py-4 font-black tracking-wider">Pelanggan</th>
                        <th class="px-6 py-4 font-black tracking-wider">Jumlah</th>
                        <th class="px-6 py-4 font-black tracking-wider">Metode</th>
                        <th class="px-6 py-4 font-black tracking-wider text-center">Status</th>
                        <th class="px-6 py-4 font-black tracking-wider">Tanggal</th>
                        <th class="px-6 py-4 font-black tracking-wider text-right">Detail</th>
                    </tr>
                </thead>
                <tbody id="transactionsTable" class="divide-y divide-slate-700/50">
                    <tr><td colspan="7" class="px-6 py-12 text-center text-slate-600 font-bold uppercase text-[10px] tracking-widest">Sedang menyisir riwayat lunas...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

</main>

<%- include('../../partials/footer') %>

<div id="manualPaymentModal" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-[calc(100%-1rem)] max-h-full bg-black/80 backdrop-blur-sm transition-opacity">
    <div class="relative w-full max-w-md max-h-full mx-auto mt-20">
        <div class="relative bg-[#1e293b] rounded-2xl shadow-2xl border border-slate-700">
            <div class="flex items-center justify-between p-5 border-b border-slate-700 bg-[#111827] rounded-t-2xl">
                <h3 class="text-lg font-black text-white uppercase tracking-tight flex items-center gap-2">
                    <i class="bi bi-credit-card-fill text-blue-500"></i> Proses Bayar Manual
                </h3>
                <button onclick="closeModal('manualPaymentModal')" type="button" class="text-slate-400 hover:text-white"><i class="bi bi-x-lg text-lg"></i></button>
            </div>
            <form id="manualPaymentForm" class="p-6 space-y-4">
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">INVOICE ID</label>
                    <input type="text" id="manualInvoiceId" readonly class="w-full bg-[#0f172a] border border-slate-700 text-slate-400 text-sm rounded-xl p-3 font-mono font-bold cursor-not-allowed">
                </div>
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">METODE PEMBAYARAN</label>
                    <select id="manualPaymentMethod" required class="w-full bg-[#111827] border border-slate-700 text-white text-sm rounded-xl p-3 font-bold uppercase tracking-tighter focus:ring-blue-500 appearance-none">
                        <option value="">-- Pilih Metode --</option>
                        <option value="cash">Tunai (Cash)</option>
                        <option value="bank_transfer">Transfer Bank</option>
                        <option value="e_wallet">E-Wallet</option>
                        <option value="qris">QRIS</option>
                        <option value="other">Lainnya</option>
                    </select>
                </div>
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">REFERENSI (OPSIONAL)</label>
                    <input type="text" id="manualReference" placeholder="Contoh: REF123456" class="w-full bg-[#111827] border border-slate-700 text-white text-sm rounded-xl p-3 font-mono font-bold focus:ring-blue-500">
                </div>
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">CATATAN TAMBAHAN</label>
                    <textarea id="manualNotes" rows="2" class="w-full bg-[#111827] border border-slate-700 text-white text-sm rounded-xl p-3 focus:ring-blue-500 font-medium"></textarea>
                </div>
                <div class="pt-4 border-t border-slate-700">
                    <button type="button" onclick="processManualPayment()" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white text-xs font-black rounded-xl transition-all uppercase tracking-widest shadow-lg shadow-blue-500/20 active:scale-95">
                        <i class="bi bi-check-circle me-2"></i> Konfirmasi Pelunasan
                    </button>
                    <button type="button" onclick="closeModal('manualPaymentModal')" class="w-full mt-2 py-2 text-[10px] font-black text-slate-500 hover:text-white uppercase tracking-widest">Batal</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    // --- UTILS (FORMAT ASLI) ---
    const formatRp = (num) => 'Rp ' + parseFloat(num).toLocaleString('id-ID');
    const formatDate = (dateStr) => new Date(dateStr).toLocaleString('id-ID');

    // --- MODAL CONTROLLER (TAILWIND MANUAL) ---
    function openModal(id) {
        const m = document.getElementById(id);
        m.classList.remove('hidden'); m.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(id) {
        const m = document.getElementById(id);
        m.classList.add('hidden'); m.classList.remove('flex');
        document.body.style.overflow = '';
    }

    // --- 1. LOAD GATEWAY STATUS (HTML Updated to Tailwind) ---
    async function loadGatewayStatus() {
        try {
            const response = await fetch('/payment/gateway-status'); 
            const data = await response.json();
            
            if (data.success) {
                const html = data.gateways.map(gw => {
                    const bgClass = gw.initialized ? 'border-emerald-500/30 bg-emerald-500/5' : 'border-red-500/30 bg-red-500/5';
                    const badgeClass = gw.initialized ? 'bg-emerald-500 text-white' : 'bg-red-500 text-white';
                    const iconClass = gw.initialized ? 'bi-check-circle-fill text-emerald-400' : 'bi-x-circle-fill text-red-500';

                    return `
                    <div class="group">
                        <div class="p-4 border rounded-2xl transition-all duration-300 ${bgClass}">
                            <div class="flex justify-between items-center mb-3">
                                <h6 class="m-0 font-black text-white uppercase tracking-tighter">${gw.name}</h6>
                                <span class="text-[9px] font-black px-2 py-0.5 rounded-full ${badgeClass} uppercase">${gw.initialized ? 'AKTIF' : 'OFF'}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <i class="bi ${iconClass} text-lg"></i>
                                <span class="text-[10px] font-bold ${gw.initialized ? 'text-slate-300' : 'text-slate-600'} uppercase tracking-widest">
                                    ${gw.initialized ? 'Siap Digunakan' : 'Belum Konfigurasi'}
                                </span>
                            </div>
                        </div>
                    </div>
                    `;
                }).join('');
                document.getElementById('gatewayStatus').innerHTML = html;
            }
        } catch (e) {
            document.getElementById('gatewayStatus').innerHTML = '<div class="col-span-3 text-center text-slate-600 font-bold py-4 uppercase text-[10px]">API Status Offline</div>';
        }
    }

    // --- 2. LOAD FAILED PAYMENTS (Table Style Tailwind) ---
    async function loadFailedPayments() {
        try {
            const response = await fetch('/payment/failed-payments');
            const data = await response.json();
            const tbody = document.getElementById('failedPaymentsTable');
            
            if (data.success && data.payments.length > 0) {
                tbody.innerHTML = data.payments.map(p => `
                    <tr class="hover:bg-slate-800/50 transition-colors group">
                        <td class="px-6 py-4 font-mono text-xs font-black text-blue-400 group-hover:text-white underline underline-offset-4">#${p.invoice_id}</td>
                        <td class="px-6 py-4 font-bold text-white text-sm">${p.customer_name || '-'}</td>
                        <td class="px-6 py-4 font-mono text-xs font-black text-red-400">${formatRp(p.amount)}</td>
                        <td class="px-6 py-4"><span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-[10px] font-bold text-slate-400 uppercase">${p.gateway}</span></td>
                        <td class="px-6 py-4 text-center"><span class="px-2 py-0.5 rounded-full bg-red-500/10 text-red-500 text-[9px] font-black border border-red-500/20 uppercase">${p.status}</span></td>
                        <td class="px-6 py-4 text-[10px] font-bold text-slate-500">${formatDate(p.created_at)}</td>
                        <td class="px-6 py-4 text-right">
                            <button class="p-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow-lg shadow-blue-500/20 transition-all" onclick="showManualPaymentModal('${p.invoice_id}')">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-12 text-center text-slate-600 font-bold uppercase text-[10px] tracking-widest"><i class="bi bi-check2-circle text-emerald-500 me-2"></i> Tidak ada pembayaran gagal terdeteksi</td></tr>';
            }
        } catch (e) { console.log('API Failed Payments not ready'); }
    }

    // --- 3. LOAD RECENT TRANSACTIONS (Table Style Tailwind) ---
    async function loadTransactions() {
        try {
            const response = await fetch('/payment/recent-transactions'); 
            const data = await response.json();
            const tbody = document.getElementById('transactionsTable');

            if (data.success && data.transactions.length > 0) {
                tbody.innerHTML = data.transactions.map(t => `
                    <tr class="hover:bg-slate-800/50 transition-colors">
                        <td class="px-6 py-4 font-mono text-xs font-black text-blue-400 underline underline-offset-4 cursor-pointer">#${t.invoice_id}</td>
                        <td class="px-6 py-4 font-bold text-white text-sm">${t.customer_name}</td>
                        <td class="px-6 py-4 font-mono text-xs font-black text-emerald-400">${formatRp(t.amount)}</td>
                        <td class="px-6 py-4 text-[10px] font-black text-slate-400 uppercase tracking-widest">${t.payment_method}</td>
                        <td class="px-6 py-4 text-center"><span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500 text-[9px] font-black border border-emerald-500/20 uppercase animate-pulse">LUNAS</span></td>
                        <td class="px-6 py-4 text-[10px] font-bold text-slate-500">${formatDate(t.payment_date)}</td>
                        <td class="px-6 py-4 text-right">
                            <span class="text-slate-700 opacity-20"><i class="bi bi-check-all text-xl"></i></span>
                        </td>
                    </tr>
                `).join('');
            } else {
                tbody.innerHTML = '<tr><td colspan="7" class="px-6 py-12 text-center text-slate-600 font-bold uppercase text-[10px] tracking-widest">Belum ada transaksi tervalidasi hari ini</td></tr>';
            }
        } catch (e) {
            document.getElementById('transactionsTable').innerHTML = '<tr><td colspan="7" class="px-6 py-12 text-center text-slate-600 font-bold uppercase text-[10px]">Data transaksi tidak tersedia</td></tr>';
        }
    }

    // --- 4. MANUAL PAYMENT LOGIC (Original Logic Preserved) ---
    window.showManualPaymentModal = function(invoiceId) {
        document.getElementById('manualInvoiceId').value = invoiceId;
        document.getElementById('manualReference').value = 'MANUAL-' + Date.now();
        openModal('manualPaymentModal');
    }

    async function processManualPayment() {
        const btn = document.querySelector('#manualPaymentForm').nextElementSibling.querySelector('.btn-primary');
        const originalText = btn.innerHTML;
        
        if (!document.getElementById('manualPaymentMethod').value) {
            alert("Pilih metode pembayaran!"); return;
        }

        btn.disabled = true;
        btn.innerHTML = '<i class="bi bi-arrow-repeat animate-spin"></i> Memproses...';

        const data = {
            invoice_id: document.getElementById('manualInvoiceId').value,
            payment_method: document.getElementById('manualPaymentMethod').value,
            reference_number: document.getElementById('manualReference').value,
            notes: document.getElementById('manualNotes').value
        };

        try {
            const response = await fetch('/admin/billing/payments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            
            if(result.success) {
                alert("? SUKSES! Tagihan telah ditandai lunas secara manual.");
                location.reload();
            } else {
                alert("? GAGAL: " + result.message);
                btn.disabled = false; btn.innerHTML = originalText;
            }
        } catch (e) {
            alert("? ERROR: Gagal lapor ke server.");
            btn.disabled = false; btn.innerHTML = originalText;
        }
    }

    // --- 5. REFRESH CONTROLLER ---
    function refreshData() {
        loadGatewayStatus();
        loadFailedPayments();
        loadTransactions();
    }

    // INIT ON LOAD
    document.addEventListener('DOMContentLoaded', () => {
        refreshData();
        setInterval(refreshData, 30000); // Auto refresh 30 detik
    });
</script>

<style>
    /* Custom Scrollbar for Batman Theme */
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
    ::-webkit-scrollbar-thumb:hover { background: #3b82f6; }
</style>

</body>
</html>