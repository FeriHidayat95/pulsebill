<script>
    $(document).ready(function() {
        
        // ==============================================================
        // MENGAKTIFKAN DATATABLES SERVER-SIDE (AJAX) UNTUK INVOICES
        // ==============================================================
        const table = $('#invoicesTable').DataTable({
            responsive: true,
            pageLength: 20,
            processing: true, 
            serverSide: true, // AKTIF MODE BACKEND!
            ajax: {
                // ?? PASTIKAN ROUTE INI DIBUAT DI BACKEND ??
                url: '/admin/billing/invoices/datatable', 
                type: 'POST'
            },
            order: [[4, 'desc']], // Default: Urutkan dari Jatuh Tempo terbaru
            dom: '<"min-h-[400px]"tr><"flex flex-col md:flex-row justify-between items-center p-5 bg-[#111827]/50 border-t border-slate-700/50"ip>',
            language: { 
                search: "", 
                zeroRecords: "Tidak ada tagihan ditemukan.",
                processing: "<div class='text-blue-500 font-black uppercase tracking-widest p-4 bg-[#111827] rounded-xl border border-slate-700 shadow-2xl'><i class='bi bi-arrow-repeat animate-spin text-xl inline-block me-2'></i> Memuat Tagihan...</div>"
            },
            columns: [
                { 
                    data: 'invoice_number', 
                    name: 'invoice_number',
                    className: 'px-6 py-4 align-middle whitespace-nowrap',
                    render: function(data, type, row) {
                        return `
                            <span onclick="viewInvoice('${row.id}')" class="font-mono text-xs md:text-sm font-bold text-blue-400 hover:text-white transition-colors underline-offset-4 hover:underline cursor-pointer tracking-wider">
                                ${row.invoice_number}
                            </span>
                        `;
                    }
                },
                { 
                    data: 'customer_name', 
                    name: 'customer_name',
                    className: 'px-6 py-4 align-middle whitespace-nowrap',
                    render: function(data, type, row) {
                        return `<div class="font-black text-white text-sm md:text-base">${row.customer_name || 'Pelanggan Dihapus'}</div>`;
                    }
                },
                { 
                    data: 'package_name', 
                    name: 'package_name',
                    className: 'px-6 py-4 align-middle whitespace-nowrap',
                    render: function(data, type, row) {
                        return `
                            <span class="px-2 py-1 rounded-md bg-[#111827] border border-slate-700/80 text-[10px] font-bold text-slate-300 uppercase tracking-tight shadow-inner">
                                ${row.package_name || 'Custom'}
                            </span>
                        `;
                    }
                },
                { 
                    data: 'amount', 
                    name: 'amount',
                    className: 'px-6 py-4 align-middle text-right whitespace-nowrap',
                    render: function(data, type, row) {
                        let displayAmt = row.amount;
                        if (displayAmt >= 100000000) { displayAmt = displayAmt / 100; }
                        return `<div class="font-mono text-xs md:text-sm font-black text-emerald-400">Rp ${parseFloat(displayAmt).toLocaleString('id-ID')}</div>`;
                    }
                },
                { 
                    data: 'due_date', 
                    name: 'due_date',
                    className: 'px-6 py-4 align-middle whitespace-nowrap',
                    render: function(data, type, row) {
                        const tgl = row.due_date ? new Date(row.due_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';
                        return `
                            <div class="flex items-center gap-2">
                                <div class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400/80"><i class="bi bi-calendar2-week"></i></div>
                                <span class="text-xs font-bold text-slate-300">${tgl}</span>
                            </div>
                        `;
                    }
                },
                { 
                    data: 'status', 
                    name: 'status',
                    className: 'px-6 py-4 align-middle text-center whitespace-nowrap',
                    render: function(data, type, row) {
                        if (row.status === 'paid') {
                            return `<span class="inline-flex items-center px-3 py-1.5 rounded-full text-[9px] font-black bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase tracking-widest">LUNAS</span>`;
                        } else {
                            return `<span class="inline-flex items-center px-3 py-1.5 rounded-full text-[9px] font-black bg-amber-500/10 text-amber-400 border border-amber-500/20 uppercase tracking-widest">BELUM</span>`;
                        }
                    }
                },
                { 
                    data: 'id', 
                    orderable: false, 
                    searchable: false, 
                    className: 'px-6 py-4 align-middle text-right whitespace-nowrap',
                    render: function(data, type, row) {
                        const safeNotes = (row.notes || '').replace(/[\\']/g, '\\$&').replace(/\r?\n|\r/g, ' ');
                        const rawDueDate = row.due_date ? new Date(row.due_date).toISOString().split('T')[0] : '';
                        
                        let buttons = `
                            <div class="flex items-center justify-end gap-1.5">
                                <button onclick="resendWA('${row.id}', '${row.customer_name}')" class="p-2 rounded-xl text-emerald-400 bg-emerald-500/5 hover:bg-emerald-500 hover:text-white transition-all border border-transparent hover:border-emerald-400/50" title="Kirim WA"><i class="bi bi-whatsapp text-lg"></i></button>
                                <a href="/admin/billing/invoices/${row.id}/print" target="_blank" class="p-2 rounded-xl text-blue-400 bg-blue-500/5 hover:bg-blue-500 hover:text-white transition-all border border-transparent hover:border-blue-400/50" title="Cetak"><i class="bi bi-printer-fill text-lg"></i></a>
                                <button onclick="editInvoice('${row.id}', '${row.customer_id}', '${row.invoice_number}', '${row.amount}', '${rawDueDate}', '${row.status}', '${safeNotes}')" class="p-2 rounded-xl text-amber-400 bg-amber-500/5 hover:bg-amber-500 hover:text-white transition-all border border-transparent hover:border-amber-400/50" title="Edit"><i class="bi bi-pencil-square text-lg"></i></button>
                        `;

                        if (row.status === 'unpaid') {
                            buttons += `<button onclick="openPaymentModal('${row.id}', '${row.customer_name}')" class="p-2 rounded-xl text-cyan-400 bg-cyan-500/5 hover:bg-cyan-500 hover:text-white transition-all border border-transparent hover:border-cyan-400/50" title="Bayar"><i class="bi bi-wallet2 text-lg"></i></button>`;
                        } else {
                            buttons += `<button onclick="refundInvoice('${row.id}')" class="p-2 rounded-xl text-rose-500 bg-rose-500/5 hover:bg-rose-500 hover:text-white transition-all border border-transparent hover:border-rose-400/50" title="Batal Bayar (Refund)"><i class="bi bi-arrow-counterclockwise text-lg font-black"></i></button>`;
                        }

                        buttons += `
                                <button onclick="deleteInvoice('${row.id}')" class="p-2 rounded-xl text-red-400 bg-red-500/5 hover:bg-red-500 hover:text-white transition-all border border-transparent hover:border-red-400/50" title="Hapus"><i class="bi bi-trash3-fill text-lg"></i></button>
                            </div>
                        `;
                        return buttons;
                    }
                }
            ],
            createdRow: function(row, data, dataIndex) {
                $(row).addClass('hover:bg-slate-800/50 transition-colors group');
            }
        });

        // Hubungkan Input Kolom Custom Pencarian
        $('#customSearch').on('keyup', function() { 
            table.search(this.value).draw(); 
        });

        // ==============================================================

        // INISIALISASI SELECT2 SULTAN
        $('#customer_id').select2({
            placeholder: "-- Ketik Nama atau Username --",
            allowClear: true,
            width: '100%',
            dropdownParent: $('#addInvoiceModal') // Mencegah dropdown sembunyi di balik modal
        });

        $('#customer_id').change(function() {
            let pkgId = $(this).find(':selected').data('package');
            if(pkgId) $('#package_id').val(pkgId).trigger('change');
        });
        
        $('#package_id').change(function() {
            let price = $(this).find(':selected').data('price');
            if(price) $('#amount').val(price);
        });

        $('#addInvoiceForm').submit(function(e) {
            e.preventDefault();
            $.post('/admin/billing/invoices/create', $(this).serialize()).done((res) => {
                if (res.success) location.reload();
                else Swal.fire('Gagal', res.message, 'warning');
            });
        });

        $('#editInvoiceForm').submit(function(e) {
            e.preventDefault();
            $.post('/admin/billing/invoices/update', $(this).serialize()).done((res) => {
                if(res.success) location.reload();
                else Swal.fire('Gagal', res.message, 'error');
            });
        });
    });

    function openModal(id) { $('#' + id).removeClass('hidden').addClass('flex'); }
    function closeModal(id) { $('#' + id).addClass('hidden').removeClass('flex'); }

    function editInvoice(id, customer_id, number, amount, date, status, notes) {
        $('#edit_inv_id_asli').val(id);
        $('#edit_inv_customer_id').val(customer_id);
        $('#edit_inv_number').val(number);
        $('#edit_inv_amount').val(amount);
        $('#edit_inv_date').val(date);
        $('#edit_inv_status').val(status);
        $('#edit_inv_notes').val(notes);
        openModal('editInvoiceModal');
    }

    function viewInvoice(id) {
        window.location.href = '/admin/billing/invoices/' + id;
    }

    function openPaymentModal(id, name) {
        $('#target_inv_id').val(id);
        $('#target_name').text(name);
        openModal('paymentChoiceModal');
    }

    function payManual() {
        const invId = $('#target_inv_id').val();
        
        $.post('/payment/manual-process', { 
            invoice_id: invId, 
            payment_method: 'Cash/Manual' 
        })
        .done((res) => {
            if (res.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'PEMBAYARAN LUNAS!',
                    text: res.message || 'Tagihan berhasil diverifikasi.',
                    background: '#1e293b',
                    color: '#fff',
                    timer: 2000,
                    showConfirmButton: false,
                    allowOutsideClick: false
                }).then(() => location.reload());
            } else {
                Swal.fire({ icon: 'error', title: 'GAGAL', text: res.message, background: '#1e293b', color: '#fff' });
            }
        })
        .fail((xhr) => {
            Swal.fire({ icon: 'error', title: 'SERVER ERROR', text: 'Gagal lapor ke database. Cek rute /payment/manual-process!', background: '#1e293b', color: '#fff' });
        });
    }

    async function generateLinkManual(btn) {
        const invId = $('#target_inv_id').val();
        const response = await fetch(`/admin/billing/invoices/${invId}/generate-tripay`, { method: 'POST' });
        const res = await response.json();
        if (res.success && res.pay_url) window.open(res.pay_url, '_blank');
        else Swal.fire('Gagal', res.message, 'error');
    }

    function resendWA(id, name) {
        $.post(`/admin/billing/invoices/${id}/resend-wa`).done(function(res) {
            if (res.success) Swal.fire('Terkirim!', res.message, 'success');
            else Swal.fire('Gagal!', res.message, 'error');
        });
    }

    function deleteInvoice(id) {
        Swal.fire({
            title: 'Hapus?', text: "Data hilang selamanya!", icon: 'warning',
            background: '#1e293b', color: '#fff', showCancelButton: true, confirmButtonText: 'Ya, Hapus'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({ url: '/admin/billing/invoices/' + id, type: 'DELETE', success: (res) => location.reload() });
            }
        });
    }
    
    function refundInvoice(id) {
        Swal.fire({
            title: 'Batal Bayar?',
            text: "Tagihan akan kembali BELUM LUNAS dan riwayat uang masuk dihapus dari buku kas!",
            icon: 'warning',
            background: '#1e293b', color: '#fff',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            cancelButtonColor: '#475569',
            confirmButtonText: 'Ya, Batalkan!'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/admin/billing/invoices/' + id + '/refund')
                .done((res) => {
                    if (res.success) {
                        Swal.fire({
                            icon: 'success', title: 'REFUND SUKSES!',
                            text: res.message, background: '#1e293b', color: '#fff',
                            timer: 2000, showConfirmButton: false
                        }).then(() => location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'GAGAL', text: res.message, background: '#1e293b', color: '#fff' });
                    }
                }).fail(() => {
                    Swal.fire({ icon: 'error', title: 'SERVER ERROR', text: 'Gagal menghubungi server.', background: '#1e293b', color: '#fff' });
                });
            }
        });
    }
</script>

</body>
</html>