<%- include('../../partials/header') %>
<body class="bg-[#0f172a] text-slate-300 font-sans antialiased selection:bg-blue-500 selection:text-white">

<div class="no-print">
    <%- include('../../partials/admin-header') %>
    <%- include('../../partials/billing-sidebar', { page: 'invoices', settings: settings }) %>
</div>

<main class="p-4 sm:ml-64 pt-20 min-h-screen transition-all duration-300">

    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tighter uppercase leading-none">
                Kelola <span class="text-blue-500">Tagihan</span>
            </h1>
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[4px] mt-2 italic">Daftar Invoice & Pembayaran</p>
        </div>
        
        <button onclick="openModal('addInvoiceModal')" class="group relative inline-flex items-center justify-center px-6 py-2.5 text-xs font-black text-white bg-blue-600 rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-500/20 transition-all uppercase tracking-wider active:scale-95">
            <i class="bi bi-plus-lg text-lg me-2"></i> Buat Tagihan
        </button>
    </div>

    <div class="bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden mb-10">
        
        <div class="px-6 py-5 border-b border-slate-700 bg-[#111827]/50 flex flex-col md:flex-row justify-between items-center gap-4">
            <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center gap-2">
                <i class="bi bi-receipt text-blue-500 text-lg"></i> Invoice List
            </h3>
            
            <div class="relative w-full md:w-64">
                <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-500">
                    <i class="bi bi-search"></i>
                </div>
                <input type="text" id="customSearch" class="block w-full p-2.5 pl-10 text-xs font-bold text-white border border-slate-700 rounded-xl bg-[#1e293b] focus:ring-blue-500 focus:border-blue-500 placeholder-slate-600 uppercase tracking-wider" placeholder="Cari No. Tagihan atau Nama...">
            </div>
        </div>

        <div class="overflow-x-auto">
            <table id="invoicesTable" class="w-full text-left text-slate-400">
                <thead class="text-[10px] text-slate-500 uppercase bg-[#111827]/30 border-b border-slate-700">
                    <tr>
                        <th class="px-6 py-4 font-black tracking-wider">No. Tagihan</th>
                        <th class="px-6 py-4 font-black tracking-wider">Pelanggan</th>
                        <th class="px-6 py-4 font-black tracking-wider">Paket</th>
                        <th class="px-6 py-4 font-black tracking-wider text-right">Jumlah</th>
                        <th class="px-6 py-4 font-black tracking-wider text-amber-500">Jatuh Tempo</th>
                        <th class="px-6 py-4 font-black tracking-wider text-center">Status</th>
                        <th class="px-6 py-4 font-black tracking-wider text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700/50">
                </tbody>
            </table>
        </div>
    </div>
</main>

<%- include('../../partials/footer') %>

<div id="addInvoiceModal" tabindex="-1" class="fixed inset-0 z-50 hidden justify-center items-center bg-black/80 backdrop-blur-sm p-4">
    <div class="relative w-full max-w-lg bg-[#1e293b] rounded-2xl shadow-2xl border border-slate-700">
        <div class="flex items-center justify-between p-5 border-b border-slate-700 bg-[#111827] rounded-t-2xl">
            <h3 class="text-lg font-black text-white uppercase">Buat Tagihan Baru</h3>
            <button onclick="closeModal('addInvoiceModal')" class="text-slate-400 hover:text-white"><i class="bi bi-x-lg text-lg"></i></button>
        </div>
        <form id="addInvoiceForm" class="p-6 space-y-4">
            <div>
                <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Pilih Pelanggan</label>
                <select name="customer_id" id="customer_id" required class="select2-sultan w-full bg-[#0f172a] border border-slate-700 text-white text-sm rounded-xl p-3 font-bold">
                    <option value="">-- Cari Nama atau Username --</option>
                    <% customers.forEach(function(c) { %><option value="<%= c.id %>" data-package="<%= c.package_id %>"><%= c.name %> (<%= c.username %>)</option><% }); %>
                </select>
            </div>
            <div>
                <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Pilih Paket</label>
                <select name="package_id" id="package_id" class="w-full bg-[#0f172a] border border-slate-700 text-white text-sm rounded-xl p-3 font-bold">
                    <option value="">-- Pilih --</option>
                    <% packages.forEach(function(p) { %><option value="<%= p.id %>" data-price="<%= p.price %>"><%= p.name %></option><% }); %>
                </select>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Nominal (Rp)</label>
                    <input type="number" name="amount" id="amount" class="w-full bg-[#0f172a] border border-slate-700 text-white text-sm rounded-xl p-3 font-bold" required>
                </div>
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Jatuh Tempo</label>
                    <input type="date" name="due_date" id="due_date" class="w-full bg-[#0f172a] border border-slate-700 text-white text-sm rounded-xl p-3 font-bold" required>
                </div>
            </div>
            <div class="pt-4 flex justify-end space-x-2">
                <button type="button" onclick="closeModal('addInvoiceModal')" class="px-5 py-2.5 text-xs font-bold text-slate-500 uppercase">Batal</button>
                <button type="submit" class="px-5 py-2.5 text-xs font-black text-white bg-blue-600 rounded-xl hover:bg-blue-700 shadow-lg uppercase">Simpan</button>
            </div>
        </form>
    </div>
</div>

<div id="editInvoiceModal" tabindex="-1" class="fixed inset-0 z-50 hidden justify-center items-center bg-black/80 backdrop-blur-sm p-4">
    <div class="relative w-full max-w-lg bg-[#1e293b] rounded-2xl shadow-2xl border border-slate-700">
        <div class="flex items-center justify-between p-5 border-b border-slate-700 bg-[#111827] rounded-t-2xl">
            <h3 class="text-lg font-black text-white uppercase text-amber-500">Edit Invoice</h3>
            <button onclick="closeModal('editInvoiceModal')" class="text-slate-400 hover:text-white"><i class="bi bi-x-lg text-lg"></i></button>
        </div>
        <form id="editInvoiceForm" class="p-6 space-y-4">
            <input type="hidden" name="id" id="edit_inv_id_asli">
            <input type="hidden" name="customer_id" id="edit_inv_customer_id">
            <div>
                <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">No. Invoice</label>
                <input type="text" id="edit_inv_number" class="w-full bg-[#111827] border border-slate-700 text-slate-500 text-sm rounded-xl p-3 font-mono font-bold" readonly>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Jumlah (Rp)</label>
                    <input type="number" name="amount" id="edit_inv_amount" class="w-full bg-[#0f172a] border border-slate-700 text-white text-sm rounded-xl p-3 font-bold" required>
                </div>
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Jatuh Tempo</label>
                    <input type="date" name="due_date" id="edit_inv_date" class="w-full bg-[#0f172a] border border-slate-700 text-white text-sm rounded-xl p-3 font-bold" required>
                </div>
            </div>
            <div>
                <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Status Pembayaran</label>
                <select name="status" id="edit_inv_status" class="w-full bg-[#0f172a] border border-slate-700 text-white text-sm rounded-xl p-3 font-bold">
                    <option value="unpaid">BELUM LUNAS</option>
                    <option value="paid">LUNAS</option>
                    <option value="cancelled">DIBATALKAN</option>
                </select>
            </div>
            <div>
                <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Catatan</label>
                <textarea name="notes" id="edit_inv_notes" rows="2" class="w-full bg-[#0f172a] border border-slate-700 text-white text-sm rounded-xl p-3"></textarea>
            </div>
            <div class="pt-4 flex justify-end space-x-2">
                <button type="button" onclick="closeModal('editInvoiceModal')" class="px-5 py-2.5 text-xs font-bold text-slate-500 uppercase">Batal</button>
                <button type="submit" class="px-5 py-2.5 text-xs font-black text-white bg-amber-600 rounded-xl uppercase">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<div id="paymentChoiceModal" tabindex="-1" class="fixed inset-0 z-50 hidden justify-center items-center bg-black/80 backdrop-blur-sm p-4">
    <div class="relative w-full max-w-sm bg-[#1e293b] rounded-2xl shadow-2xl border border-slate-700 p-8 text-center">
        <input type="hidden" id="target_inv_id">
        <h6 class="text-lg font-black text-white mb-6 uppercase">Bayar: <span id="target_name" class="text-blue-500"></span></h6>
        <div class="space-y-4">
            <button onclick="payManual()" class="w-full p-5 rounded-2xl border border-emerald-500/30 bg-[#111827] hover:bg-emerald-600/10 text-emerald-400 transition-all active:scale-95">
                <i class="bi bi-cash-stack text-3xl mb-2 block"></i><span class="text-xs font-black uppercase">Bayar Tunai (Manual)</span>
            </button>
            <button onclick="generateLinkManual(this)" class="w-full p-5 rounded-2xl border border-blue-500/30 bg-[#111827] hover:bg-blue-600/10 text-blue-400 transition-all active:scale-95">
                <i class="bi bi-link-45deg text-3xl mb-2 block"></i><span class="text-xs font-black uppercase">Buat Link Tripay</span>
            </button>
        </div>
        <button onclick="closeModal('paymentChoiceModal')" class="mt-6 text-[10px] font-bold text-slate-500 uppercase tracking-widest">Batal</button>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

