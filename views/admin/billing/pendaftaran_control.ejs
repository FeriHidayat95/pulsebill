<%- include('../../partials/header') %>
<body class="bg-[#0f172a] text-slate-300 font-sans antialiased selection:bg-blue-500 selection:text-white">
<%- include('../../partials/admin-header') %>
<%- include('../../partials/billing-sidebar', { page: 'pendaftaran', settings: settings }) %>
<main class="p-4 sm:ml-64 pt-20 min-h-screen">
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tighter uppercase leading-none">
                Control <span class="text-blue-500">Pasukan & Pendaftaran</span>
            </h1>
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[4px] mt-2">Validasi Instalasi & Manajemen Personil</p>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
        <div class="bg-[#1e293b] border-l-4 border-l-amber-500 border-y border-r border-slate-700/60 rounded-2xl p-5 shadow-lg group hover:-translate-y-1 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-[10px] font-black text-amber-500 uppercase tracking-widest mb-1">Menunggu Validasi</p>
                    <h3 class="text-3xl font-black text-white uppercase"><%= pendingCount %> <span class="text-xs text-slate-600 font-bold tracking-normal uppercase">Permintaan</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-500 border border-amber-500/20">
                    <i class="bi bi-hourglass-split text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-[#1e293b] border-l-4 border-l-blue-500 border-y border-r border-slate-700/60 rounded-2xl p-5 shadow-lg group hover:-translate-y-1 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-[10px] font-black text-blue-500 uppercase tracking-widest mb-1">Pasukan Lapangan</p>
                    <h3 class="text-3xl font-black text-white uppercase"><%= techCount %> <span class="text-xs text-slate-600 font-bold tracking-normal uppercase">Personil</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 border border-blue-500/20">
                    <i class="bi bi-person-badge text-2xl"></i>
                </div>
            </div>
        </div>
        <div class="bg-[#1e293b] border-l-4 border-l-emerald-500 border-y border-r border-slate-700/60 rounded-2xl p-5 shadow-lg group hover:-translate-y-1 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-[10px] font-black text-emerald-500 uppercase tracking-widest mb-1">Hasil Terpasang</p>
                    <h3 class="text-3xl font-black text-emerald-400 uppercase"><%= totalInstalled %> <span class="text-xs text-slate-600 font-bold tracking-normal uppercase">Aktif</span></h3>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 border border-emerald-500/20">
                    <i class="bi bi-check-circle-fill text-2xl"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden mb-10">
        <div class="px-6 py-5 border-b border-slate-700 bg-[#111827]/50">
            <div class="flex flex-wrap gap-2" id="pendaftaranTabs">
                <button onclick="switchTab('tab_validasi', this)" class="tab-btn px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all bg-blue-600 text-white shadow-lg shadow-blue-500/20 active-tab">
                    <i class="bi bi-list-check me-2 text-lg"></i>Antrean Validasi
                </button>
                <button onclick="switchTab('tab_aktif', this)" class="tab-btn px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all text-slate-500 hover:bg-slate-800 hover:text-white">
                    <i class="bi bi-people-fill me-2 text-lg"></i>Data Pelanggan Aktif
                </button>
                <button onclick="switchTab('tab_pasukan', this)" class="tab-btn px-5 py-2.5 rounded-xl text-xs font-black uppercase tracking-widest transition-all text-slate-500 hover:bg-slate-800 hover:text-white">
                    <i class="bi bi-shield-lock me-2 text-lg"></i>Manajemen Pasukan
                </button>
            </div>
        </div>
        <div class="p-6">
            <div id="tab_validasi" class="tab-content block animate-fade-in">
                <% if(pendingList.length === 0) { %>
                    <div class="text-center py-20">
                        <i class="bi bi-check2-circle text-6xl text-emerald-500/20 block mb-4"></i>
                        <h5 class="text-lg font-black text-white uppercase tracking-tighter">Semua Bersih!</h5>
                        <p class="text-xs font-bold text-slate-500 uppercase tracking-widest">Tidak ada antrean pendaftaran baru saat ini.</p>
                    </div>
                <% } else { %>
                    <div class="overflow-x-auto">
                        <table id="tablePending" class="w-full text-left text-slate-400">
                            <thead class="text-[10px] text-slate-500 uppercase bg-[#111827]/30 border-b border-slate-700">
                                <tr>
                                    <th class="px-6 py-4 font-black tracking-wider">Waktu Input</th>
                                    <th class="px-6 py-4 font-black tracking-wider">Teknisi / Sales</th>
                                    <th class="px-6 py-4 font-black tracking-wider">Data Calon Pelanggan</th>
                                    <th class="px-6 py-4 font-black tracking-wider text-center">Rencana Paket</th>
                                    <th class="px-6 py-4 font-black tracking-wider text-right">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-700/50">
                                <% pendingList.forEach(row => { %>
                                <tr class="hover:bg-slate-800/50 transition-colors group">
                                    <td class="px-6 py-4">
                                        <div class="font-bold text-white text-xs"><%= new Date(row.created_at).toLocaleDateString('id-ID') %></div>
                                        <div class="text-[10px] text-slate-500 font-bold uppercase mt-1"><%= new Date(row.created_at).toLocaleTimeString('id-ID') %></div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[9px] font-black bg-amber-500/10 text-amber-500 border border-amber-500/20 uppercase tracking-widest">
                                            <i class="bi bi-person me-1"></i><%= row.technician_name %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-col">
                                            <span class="font-black text-white text-sm group-hover:text-blue-400 transition-colors"><%= row.customer_name %></span>
                                            <span class="text-[10px] text-slate-500 font-bold italic mt-1"><i class="bi bi-geo-alt me-1"></i><%= row.address %></span>
                                            <span class="text-[10px] text-blue-400 font-mono mt-1"><i class="bi bi-whatsapp me-1"></i><%= row.whatsapp_no %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <span class="inline-block px-3 py-1 rounded-lg text-[10px] font-black bg-blue-500/10 text-blue-400 border border-blue-500/20 uppercase tracking-widest">
                                            <%= row.package_name %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex flex-col gap-1 items-end">
                                            <button onclick="lihatDetail('<%= row.id %>', '<%= row.customer_name %>', '<%= row.pppoe_user %>', '<%= row.pppoe_pass %>')" class="px-4 py-1.5 bg-[#111827] hover:bg-blue-600 text-blue-400 hover:text-white text-[10px] font-black rounded-lg border border-blue-500/20 transition-all uppercase tracking-widest w-28">
                                                <i class="bi bi-eye me-1"></i> Cek Data
                                            </button>
                                            <div class="flex gap-1 w-28">
                                                <button onclick="prosesValidasi('<%= row.id %>', '<%= row.customer_name %>')" class="flex-grow py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-[10px] font-black rounded-lg transition-all shadow-lg shadow-emerald-500/20">OK</button>
                                                <button onclick="tolakUser('<%= row.id %>')" class="px-2 py-1.5 bg-red-600 hover:bg-red-700 text-white text-[10px] font-black rounded-lg transition-all shadow-lg shadow-red-500/20"><i class="bi bi-trash"></i></button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
            <div id="tab_aktif" class="tab-content hidden animate-fade-in">
                <div class="flex flex-col md:flex-row justify-between items-center mb-4 gap-4">
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Show</span>
                        <select id="showEntries" onchange="changeEntries(this.value)" class="bg-[#111827] border border-slate-700 text-white text-[10px] font-black rounded-lg focus:ring-blue-500 p-1 px-2">
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="500">500</option>
                        </select>
                    </div>
                    <div class="relative w-full md:w-64">
                        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-500">
                            <i class="bi bi-search text-xs"></i>
                        </div>
                        <input type="text" id="searchAktif" class="block w-full p-2 pl-8 text-[10px] font-bold text-white border border-slate-700 rounded-xl bg-[#111827] focus:ring-blue-500 placeholder-slate-600 uppercase" placeholder="Cari Pelanggan...">
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table id="tableAktif" class="w-full text-left text-slate-400">
                        <thead class="text-[10px] text-slate-500 uppercase bg-[#111827]/30 border-b border-slate-700">
                            <tr>
                                <th class="px-6 py-4 font-black"><input type="checkbox" id="checkAll" class="rounded border-slate-700 bg-slate-800 text-blue-600 focus:ring-blue-500"></th>
                                <th class="px-6 py-4 font-black">Nama Pelanggan</th>
                                <th class="px-6 py-4 font-black">No. WA</th>
                                <th class="px-6 py-4 font-black">Tanggal PSB</th>
                                <th class="px-6 py-4 font-black">Alamat</th>
                                <th class="px-6 py-4 font-black">ODP & Port</th>
                                <th class="px-6 py-4 font-black">Paket</th>
                                <th class="px-6 py-4 font-black">Teknisi</th>
                                <th class="px-6 py-4 font-black text-right">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-700/50">
                            <% if(typeof validatedList !== 'undefined') { %>
                                <% validatedList.forEach(v => { %>
                                <tr class="hover:bg-slate-800/50 transition-colors group text-xs">
                                    <td class="px-6 py-4"><input type="checkbox" class="customer-check rounded border-slate-700 bg-slate-800 text-blue-600"></td>
                                    <td class="px-6 py-4 font-black text-white"><%= v.customer_name %></td>
                                    <td class="px-6 py-4 font-mono text-blue-400"><%= v.whatsapp_no %></td>
                                    <td class="px-6 py-4 font-bold"><%= new Date(v.created_at).toLocaleDateString('id-ID') %></td>
                                    <td class="px-6 py-4 truncate max-w-[150px] italic"><%= v.address %></td>
                                    <td class="px-6 py-4">
                                        <span class="text-[10px] font-black text-amber-500"><%= v.odp_data || '-' %></span>
                                        <span class="text-[10px] text-slate-500">/</span>
                                        <span class="text-[10px] font-black text-blue-400">P.<%= v.port_data || '-' %></span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 font-black uppercase text-[9px]"><%= v.package_name %></span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-1">
                                            <div class="w-1.5 h-1.5 rounded-full bg-emerald-500"></div>
                                            <span class="font-bold uppercase text-[10px] text-slate-300"><%= v.technician_name %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex justify-end gap-2">
                                            <button onclick="editAktif('<%= v.id %>', '<%= v.customer_name %>', '<%= v.address.replace(/\r?\n|\r/g, ' ') %>', '<%= v.odp_data %>', '<%= v.port_data %>')" 
                                                    class="p-2 text-amber-500 hover:bg-amber-500/20 rounded-xl transition-all" title="Koreksi Data">
                                                <i class="bi bi-pencil-square text-lg"></i>
                                            </button>
                                            <button onclick="hapusAktif('<%= v.id %>', '<%= v.customer_name %>')" class="p-2 text-red-500 hover:bg-red-500/20 rounded-xl transition-all" title="Hapus Riwayat">
                                                <i class="bi bi-trash text-lg"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <div id="tab_pasukan" class="tab-content hidden animate-fade-in">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                    <div class="lg:col-span-4">
                        <div class="bg-[#111827]/50 border border-slate-700 rounded-3xl p-6 relative overflow-hidden">
                            <div class="absolute top-0 right-0 p-4 opacity-5 text-white">
                                <i class="bi bi-person-plus-fill text-6xl"></i>
                            </div>
                            <h4 class="text-sm font-black text-white uppercase tracking-widest mb-6 border-b border-slate-700 pb-2 flex items-center gap-2">
                                <i class="bi bi-person-plus text-blue-500"></i> Rekrut Pasukan
                            </h4>
                            <form id="formTeknisi" class="space-y-4 relative z-10">
                                <div>
                                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Nama Lengkap</label>
                                    <input type="text" name="name" required placeholder="Contoh: Asep Kabeh" class="w-full bg-[#0f172a] border border-slate-700 rounded-xl p-3 text-sm text-white focus:ring-blue-500 font-bold placeholder-slate-700">
                                </div>
                                <div>
                                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">No. WhatsApp (Username)</label>
                                    <input type="number" name="phone" required placeholder="0812xxxx" class="w-full bg-[#0f172a] border border-slate-700 rounded-xl p-3 text-sm text-white focus:ring-blue-500 font-mono font-bold placeholder-slate-700">
                                    <p class="text-[9px] text-red-500 font-bold uppercase mt-1 tracking-tighter">*Digunakan untuk login aplikasi personil.</p>
                                </div>
                                <div>
                                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Buat Password</label>
                                    <input type="text" name="password" required placeholder="Password login..." class="w-full bg-[#0f172a] border border-slate-700 rounded-xl p-3 text-sm text-white focus:ring-blue-500 font-bold placeholder-slate-700">
                                </div>
                                <div class="pt-4">
                                    <button type="submit" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-black rounded-xl transition-all uppercase tracking-widest shadow-lg shadow-blue-500/20">
                                        <i class="bi bi-save2 me-2"></i> Simpan Personil
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                    <div class="lg:col-span-8">
                        <div class="overflow-x-auto">
                            <table id="tableTeknisi" class="w-full text-left text-slate-400">
                                <thead class="text-[10px] text-slate-500 uppercase bg-[#111827]/30 border-b border-slate-700">
                                    <tr>
                                        <th class="px-6 py-4 font-black">Nama Pasukan</th>
                                        <th class="px-6 py-4 font-black">Login (WA)</th>
                                        <th class="px-6 py-4 font-black">Sandi</th>
                                        <th class="px-6 py-4 font-black">Status</th>
                                        <th class="px-6 py-4 font-black text-right">Opsi</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-700/50">
                                    <% technicianList.forEach(t => { %>
                                    <tr class="hover:bg-slate-800/50 transition-colors">
                                        <td class="px-6 py-4 font-black text-white text-sm"><%= t.name %></td>
                                        <td class="px-6 py-4 font-mono text-xs text-slate-300 font-bold"><%= t.phone %></td>
                                        <td class="px-6 py-4 text-xs font-bold text-slate-600 tracking-widest">******</td>
                                        <td class="px-6 py-4">
                                            <span class="px-2.5 py-0.5 rounded-full text-[9px] font-black bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 uppercase">Active</span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <button onclick="hapusTeknisi('<%= t.id %>', '<%= t.name %>')" class="p-1.5 rounded-lg text-red-400 hover:bg-red-500/20 transition-all" title="Hapus"><i class="bi bi-trash-fill text-lg"></i></button>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>
<%- include('../../partials/footer') %>
<div id="modalDetail" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-full bg-black/80 backdrop-blur-sm transition-opacity">
    <div class="relative w-full max-w-sm mx-auto mt-40">
        <div class="relative bg-[#1e293b] rounded-2xl shadow-2xl border border-slate-700 overflow-hidden">
            <div class="p-6 text-center">
                <h3 class="text-lg font-black text-white uppercase tracking-tight mb-1">Akses Login Pelanggan</h3>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-6">Konfigurasi di Modem/Router</p>
                
                <div class="bg-[#111827] rounded-2xl p-6 border border-slate-700/50 mb-6 space-y-4">
                    <div class="flex flex-col">
                        <span class="text-[10px] font-black text-blue-500 uppercase tracking-widest mb-1 opacity-70">Username</span>
                        <span class="text-xl font-black text-white font-mono tracking-wider" id="detailUser"></span>
                    </div>
                    <div class="w-full h-px bg-slate-800"></div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-black text-amber-500 uppercase tracking-widest mb-1 opacity-70">Password</span>
                        <span class="text-xl font-black text-white font-mono tracking-wider" id="detailPass"></span>
                    </div>
                </div>
                <div class="bg-blue-600/10 border border-blue-500/20 rounded-xl p-3 mb-6">
                    <p class="text-[9px] text-blue-400 font-bold leading-relaxed">
                        <i class="bi bi-info-circle-fill me-1"></i> 
                        PASTIKAN DATA DI ATAS SUDAH DI-SETTING DI MODEM SEBELUM MENEKAN TOMBOL <strong>VALIDASI</strong>.
                    </p>
                </div>
                
                <button onclick="closeModal('modalDetail')" class="w-full py-3 bg-slate-800 hover:bg-slate-700 text-white text-[10px] font-black rounded-xl transition-all uppercase tracking-widest">Tutup Jendela</button>
            </div>
        </div>
    </div>
</div>
<div id="modalEditAktif" tabindex="-1" aria-hidden="true" class="fixed top-0 left-0 right-0 z-50 hidden w-full p-4 overflow-x-hidden overflow-y-auto md:inset-0 h-full bg-black/80 backdrop-blur-sm transition-opacity">
    <div class="relative w-full max-w-md mx-auto mt-20">
        <div class="relative bg-[#1e293b] rounded-3xl shadow-2xl border border-slate-700 overflow-hidden">
            <div class="p-6 border-b border-slate-700 bg-[#111827]/50 flex justify-between items-center">
                <h3 class="text-sm font-black text-white uppercase tracking-widest flex items-center gap-2">
                    <i class="bi bi-pencil-square text-amber-500"></i> Koreksi Data Lapangan
                </h3>
                <button onclick="closeModal('modalEditAktif')" class="text-slate-500 hover:text-white"><i class="bi bi-x-lg"></i></button>
            </div>
            <form id="formEditAktif" class="p-6 space-y-4">
                <input type="hidden" id="edit_aktif_id" name="id">
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase">Nama Pelanggan</label>
                    <input type="text" id="edit_aktif_name" class="w-full bg-[#111827] border border-slate-700 rounded-xl p-3 text-xs text-white font-bold opacity-60" readonly>
                </div>
                <div>
                    <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase">Alamat Pemasangan</label>
                    <textarea id="edit_aktif_address" name="address" rows="2" class="w-full bg-[#111827] border border-slate-700 rounded-xl p-3 text-xs text-white font-bold"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block mb-2 text-[10px] font-black text-amber-500 uppercase">Data ODP</label>
                        <input type="text" id="edit_aktif_odp" name="odp_data" class="w-full bg-[#111827] border border-slate-700 rounded-xl p-3 text-xs text-white font-bold uppercase">
                    </div>
                    <div>
                        <label class="block mb-2 text-[10px] font-black text-blue-400 uppercase">Nomor Port</label>
                        <input type="number" id="edit_aktif_port" name="port_data" class="w-full bg-[#111827] border border-slate-700 rounded-xl p-3 text-xs text-white font-bold">
                    </div>
                </div>
                <button type="submit" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-black rounded-xl transition-all uppercase tracking-[2px] shadow-lg shadow-blue-500/20">
                    SIMPAN PERUBAHAN
                </button>
            </form>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
<style>
    /* DataTables Dark Styling */
    .dataTables_wrapper .dataTables_filter { display: none; }
    .dataTables_wrapper .dataTables_length { display: none; }
    .dataTables_info { color: #64748b !important; font-size: 0.7rem; font-weight: 800; margin-top: 1rem; text-transform: uppercase; padding-left: 1rem; }
    .dataTables_paginate { margin-top: 1rem; display: flex; justify-content: flex-end; gap: 5px; padding-right: 1rem; }
    .paginate_button { padding: 4px 12px; border-radius: 8px; background: #111827; color: #94a3b8 !important; cursor: pointer; border: 1px solid #334151; font-size: 0.7rem; font-weight: 800; }
    .paginate_button.current { background: #3b82f6; color: white !important; border-color: #3b82f6; }
    .paginate_button:hover:not(.current) { background: #1f2937; color: white !important; }
    
    @keyframes fade-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .animate-fade-in { animation: fade-in 0.4s ease-out forwards; }
</style>
<script>
    let tableAktif;
    $(document).ready(function() {
        // Init DataTables
        $('#tablePending').DataTable({ pageLength: 10 });
        $('#tableTeknisi').DataTable({ searching: false, paging: false, info: false });
        
        tableAktif = $('#tableAktif').DataTable({ 
            pageLength: 25,
            language: {
                zeroRecords: "Data pelanggan tidak ditemukan",
                info: "Menampilkan _START_ sampai _END_ dari _TOTAL_ pelanggan"
            }
        });
        // Search Custom Box for Tab Aktif
        $('#searchAktif').on('keyup', function() {
            tableAktif.search(this.value).draw();
        });
        // Check All Logic
        $('#checkAll').change(function() {
            $('.customer-check').prop('checked', $(this).prop('checked'));
        });
        $('#formEditAktif').submit(function(e) {
            e.preventDefault();
            const btn = $(this).find('button[type="submit"]');
            btn.prop('disabled', true).text('MENYIMPAN...');
            $.post('/admin/pendaftaran/api/update-validated', $(this).serialize(), function(res) {
                if(res.success) { location.reload(); }
                else { alert("Gagal: " + res.message); btn.prop('disabled', false).text('SIMPAN PERUBAHAN'); }
            });
        });
    });
    // --- TAB SWITCHER ---
    function switchTab(tabId, btn) {
        $('.tab-content').addClass('hidden').removeClass('block');
        $('#' + tabId).removeClass('hidden').addClass('block');
        
        $('.tab-btn').removeClass('bg-blue-600 text-white shadow-lg shadow-blue-500/20 active-tab').addClass('text-slate-500 hover:bg-slate-800 hover:text-white');
        $(btn).addClass('bg-blue-600 text-white shadow-lg shadow-blue-500/20 active-tab').removeClass('text-slate-500 hover:bg-slate-800 hover:text-white');
    }
    // --- DATATABLE UTILS ---
    function changeEntries(val) {
        tableAktif.page.len(parseInt(val)).draw();
    }
    // --- MODAL CONTROLLER ---
    function openModal(id) {
        const m = document.getElementById(id);
        m.classList.remove('hidden'); m.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }
    function closeModal(id) {
        const m = document.getElementById(id);
        m.classList.add('hidden'); m.classList.remove('flex');
        document.body.style.overflow = '';
    }
    // --- LOGIC TAB 1: VALIDASI ---
    function lihatDetail(id, nama, user, pass) {
        $('#detailUser').text(user);
        $('#detailPass').text(pass);
        openModal('modalDetail');
    }
    function prosesValidasi(id, nama) {
        if(confirm(`Yakin validasi pelanggan ${nama}?\n\nSistem akan otomatis:\n1. Membuat Customer Baru\n2. Mendaftarkan ke Radius & MikroTik\n3. Mengirim WA Sambutan`)) {
            $.post('/admin/pendaftaran/api/validate', { id: id }, function(res) {
                if(res.success) {
                    alert('? SUKSES! Pelanggan kini sudah Aktif.');
                    location.reload();
                } else {
                    alert('? Gagal: ' + res.message);
                }
            });
        }
    }
    function tolakUser(id) {
        if(confirm("Tolak pendaftaran ini? Data akan dipindahkan ke arsip sampah.")) {
            $.post('/admin/pendaftaran/api/reject', { id: id }, function(res) {
                if(res.success) location.reload();
            });
        }
    }
    function editAktif(id, nama, alamat, odp, port) {
        $('#edit_aktif_id').val(id);
        $('#edit_aktif_name').val(nama);
        $('#edit_aktif_address').val(alamat);
        $('#edit_aktif_odp').val(odp);
        $('#edit_aktif_port').val(port);
        openModal('modalEditAktif');
    }
    function hapusAktif(id, nama) {
        if(confirm(`Warning\n\nYakin ingin menghapus riwayat pendaftaran ${nama}?`)) {
            $.post('/admin/pendaftaran/api/delete-validated', { id: id }, function(res) {
                if(res.success) location.reload();
                else alert("Gagal: " + res.message);
            });
        }
    }
    // --- LOGIC TAB: MANAJEMEN TEKNISI ---
    $('#formTeknisi').submit(function(e) {
        e.preventDefault();
        $.post('/admin/pendaftaran/api/save-tech', $(this).serialize(), function(res) {
            if(res.success) {
                alert('? Pasukan baru berhasil ditambahkan!');
                location.reload();
            } else {
                alert('? Gagal: ' + res.message);
            }
        });
    });
    function hapusTeknisi(id, nama) {
        if(confirm(`PERINGATAN!\n\nAnda akan mencabut akses untuk: ${nama}.\nTeknisi ini tidak akan bisa login lagi.\nLanjutkan?`)) {
            $.post('/admin/pendaftaran/api/delete-tech', { id: id }, function(res) {
                if(res.success) location.reload();
                else alert(res.message);
            });
        }
    }
</script>
</body>
</html>
