            </html>
        `);
        w.document.close();
        w.focus();
        setTimeout(() => { w.print(); w.close(); }, 500);
    }
    function simpanSemua() {
        Swal.fire({
            title: 'Simpan Perubahan?',
            text: "Data mediator dan komisi akan diperbarui",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3b82f6',
            cancelButtonColor: '#475569',
            confirmButtonText: 'Ya, Simpan!',
            background: '#0f172a',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                var dt = $('#tableUtama').DataTable();
                var data = [];
                
                dt.rows().every(function () {
                    var row = $(this.node());
                    var id = row.find('.v-id').val();
                    var med = row.find('.v-agent').val();
                    var comm = row.find('.v-comm').val();
                    
                    if (id && med && med !== "" && med !== "null") { 
                        data.push({ 
                            id: parseInt(id), 
                            mediator_id: parseInt(med), 
                            comm: parseFloat(comm) || 0 
                        }); 
                    }
                });
    
                // Proteksi jika user belum memilih satu pun mediator di tabel
                if (data.length === 0) {
                    Swal.fire({
                        icon: 'info', 
                        title: 'Tidak Ada Perubahan', 
                        text: 'Please select a mediator for the selected transaction row.', 
                        background: '#0f172a', 
                        color: '#fff'
                    });
                    return;
                }
    
                $.ajax({ 
                    url: '/admin/finance/api/bulk-update', 
                    method: 'POST', 
                    contentType: 'application/json', 
                    data: JSON.stringify(data), 
                    success: function(res) { 
                        if(res.success) { 
                            Swal.fire({icon: 'success', title: 'Tersimpan!', background: '#0f172a', color: '#fff', timer:1500, showConfirmButton: false})
                            .then(() => location.reload());
                        } else {
                            Swal.fire({icon: 'error', title: 'Gagal', text: res.message, background: '#0f172a', color: '#fff'});
                        }
                    },
                    error: function(xhr) {
                        Swal.fire({icon: 'error', title: 'Gagal', text: 'Server menolak data. Pastikan format angka komisi benar.', background: '#0f172a', color: '#fff'});
                    }
                });
            }
        });
    }
    function hapusMasal() {
        const ids = []; 
        $('.cb-pilih:checked').each(function() { ids.push($(this).val()); });
        if (ids.length === 0) return;
        
        Swal.fire({
            title: 'Yakin Hapus Data?',
            text: `${ids.length} Laporan akan dimusnahkan permanen!`,
            icon: 'error',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#475569',
            confirmButtonText: 'Musnahkan!',
            background: '#0f172a',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({ 
                    url: '/admin/finance/api/bulk-delete-reports', 
                    method: 'POST', 
                    contentType: 'application/json', 
                    data: JSON.stringify({ ids: ids }), 
                    success: function(res) { 
                        if(res.success) { 
                            Swal.fire({icon: 'success', title: 'Dihapus!', background: '#0f172a', color: '#fff', timer:1500, showConfirmButton: false})
                            .then(() => location.reload());
                        } else {
                            Swal.fire({icon: 'error', title: 'Gagal', text: res.message, background: '#0f172a', color: '#fff'});
                        }
                    } 
                });
            }
        });
    }
    $('#formMediator').submit(function(e) {
        e.preventDefault();
        const btn = $(this).find('button[type="submit"]');
        const originalText = btn.text();
        btn.prop('disabled', true).text('PROCESSING...');
        $.post('/admin/finance/api/mediator-save', $(this).serialize())
        .done(function(res) {
            if(res.success) {
                Swal.fire({
                    icon: 'success', title: 'BERHASIL!', text: res.message || 'Data Mediator Berhasil Disimpan.',
                    background: '#0a0f1e', color: '#fff', timer: 2000, showConfirmButton: false
                }).then(() => { location.reload(); });
            } else {
                Swal.fire({ icon: 'error', title: 'GAGAL SIMPAN', text: res.message, background: '#0a0f1e', color: '#fff' });
                btn.prop('disabled', false).text(originalText);
            }
        })
        .fail(function(xhr) {
            Swal.fire({ icon: 'error', title: 'KONEKSI GAGAL', text: 'Error ' + xhr.status, background: '#0a0f1e', color: '#fff' });
            btn.prop('disabled', false).text(originalText);
        });
    });
    function editMediator(id, name, comm) { 
        $('#med_id').val(id); $('#med_name').val(name); $('#med_comm').val(comm); 
        $('#btnBatal').removeClass('hidden'); 
        switchTab('tab_mediator', $('.tab-btn').eq(1)); 
    }
    
    function resetForm() { 
        $('#formMediator')[0].reset(); $('#med_id').val(0); $('#btnBatal').addClass('hidden'); 
    }
    
    function hapusMediator(id) { 
        Swal.fire({
            title: 'Hapus Mediator?', icon: 'warning', showCancelButton: true,
            confirmButtonColor: '#dc2626', cancelButtonColor: '#475569', confirmButtonText: 'Hapus',
            background: '#0f172a', color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                $.post('/admin/finance/api/mediator-delete', {id: id}, function(res) { 
                    if(res.success) location.reload(); 
                }); 
            }
        });
    }
</script>
</body>
</html>
