                    <button onclick="testTemplate('service_restoration')" class="mt-4 px-4 py-2 text-[10px] font-black text-amber-400 border border-amber-500/30 rounded-xl hover:bg-amber-500 hover:text-white transition-all uppercase tracking-widest">
