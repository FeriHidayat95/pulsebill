                        <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Nomor Tujuan</label>
                        <input type="text" id="testPhoneNumber" placeholder="62812345xxx" class="w-full bg-[#0f172a] border border-slate-700 rounded-xl p-3 text-sm text-white focus:ring-blue-500 focus:border-blue-500 font-mono">
                    </div>
                    <div>
                        <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Template</label>
                        <select id="testTemplateSelect" class="w-full bg-[#0f172a] border border-slate-700 rounded-xl p-3 text-sm text-white focus:ring-blue-500 font-bold uppercase tracking-tighter">
                            <option value="invoice_created">Tagihan Baru</option>
                            <option value="payment_received">Pembayaran</option>
                            <option value="due_date_reminder">Pengingat</option>
                            <option value="service_suspension">Isolir</option>
