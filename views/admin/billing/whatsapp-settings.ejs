                        <span class="bg-blue-500/10 text-blue-400 text-[10px] px-2 py-1 rounded border border-blue-500/20 font-mono cursor-pointer hover:bg-blue-500 hover:text-white transition-colors" onclick="copyVar('{amount}')">{amount}</span>
                        <span class="bg-blue-500/10 text-blue-400 text-[10px] px-2 py-1 rounded border border-blue-500/20 font-mono cursor-pointer hover:bg-blue-500 hover:text-white transition-colors" onclick="copyVar('{due_date}')">{due_date}</span>
                        <span class="bg-blue-500/10 text-blue-400 text-[10px] px-2 py-1 rounded border border-blue-500/20 font-mono cursor-pointer hover:bg-blue-500 hover:text-white transition-colors" onclick="copyVar('{package_name}')">{package_name}</span>
