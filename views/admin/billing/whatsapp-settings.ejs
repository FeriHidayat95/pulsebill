    <div id="toast-container" class="fixed top-24 right-5 z-[9999] flex flex-col gap-3 pointer-events-none"></div>

</main>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    let templates = {};

    // --- TOAST FUNCTION (Tailwind Batman Style) ---
    function showToast(type, title, message) {
        const colors = {
            success: 'bg-emerald-600 border-emerald-500',
            error: 'bg-red-600 border-red-500',
            warning: 'bg-amber-600 border-amber-500'
        };
        const icons = {
            success: 'bi-check-circle-fill',
            error: 'bi-exclamation-triangle-fill',
            warning: 'bi-info-circle-fill'
        };
        
        const id = 'toast-' + Math.random().toString(36).substr(2, 9);
        const html = `
            <div id="${id}" class="toast-item flex items-center w-full max-w-xs p-4 text-white ${colors[type] || 'bg-slate-800'} rounded-2xl shadow-2xl border transition-all duration-500 pointer-events-auto transform translate-x-0" role="alert">
                <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-white rounded-lg bg-white/20">
                    <i class="bi ${icons[type] || 'bi-bell'}"></i>
                </div>
                <div class="ml-3">
                    <span class="text-[10px] font-black uppercase tracking-widest opacity-70 block">${title}</span>
                    <div class="text-xs font-bold">${message}</div>
                </div>
                <button type="button" class="ml-auto -mx-1.5 -my-1.5 p-1.5 inline-flex h-8 w-8 text-white hover:text-slate-200" onclick="this.parentElement.remove()">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>`;
            
        $('#toast-container').append(html);
        setTimeout(() => {
            $(`#${id}`).addClass('translate-x-full opacity-0');
            setTimeout(() => $(`#${id}`).remove(), 500);
        }, 4000);
    }

    // --- HELPER: COPY VARIABLE ---
    function copyVar(text) {
        // Find focused textarea or just show info
        showToast('warning', 'Info', `Gunakan variabel ${text} di dalam template.`);
    }

    // --- 1. LOAD STATUS ---
    function loadStatus() {
        $.get('/admin/billing/whatsapp-settings/status')
        .done(function(data) {
            if (data.success) {
                if(data.connected) {
                    $('#whatsappStatus').html('<span class="text-emerald-400 font-black animate-pulse"><i class="bi bi-check-circle-fill me-1"></i> Connected</span>');
                } else {
                    $('#whatsappStatus').html('<span class="text-red-500 font-black"><i class="bi bi-x-circle-fill me-1"></i> Disconnected</span>');
                }
                
                if(data.info) {
                    $('#activeCustomers').text(data.info.activeCustomers || '0');
                    $('#pendingInvoices').text(data.info.pendingInvoices || '0');
                } else {
                    $('#activeCustomers').text(data.activeCustomers || '0');
                    $('#pendingInvoices').text(data.pendingInvoices || '0');
                }
            }
        })
        .fail(function() {
            $('#whatsappStatus').html('<span class="text-slate-600">Error Status</span>');
        });
    }

    loadStatus();
    setInterval(loadStatus, 10000); 

    // --- 2. LOAD TEMPLATES ---
    async function loadTemplates() {
        try {
            const response = await fetch('/admin/billing/whatsapp-settings/templates');
            const data = await response.json();
            if (data.success) {
                templates = data.templates;
                Object.keys(templates).forEach(key => {
                    const textarea = document.getElementById(`${key}_template`);
                    const toggle = document.getElementById(`${key}_enabled`);
                    if (textarea) textarea.value = templates[key].template || '';
                    if (toggle) toggle.checked = templates[key].enabled !== false;
                });
            }
        } catch (error) { console.error('Error loading templates:', error); }
    }
    loadTemplates();

    // --- 3. SAVE TEMPLATES ---
    async function saveAllTemplates() {
        const templateData = {};
        const keys = ['invoice_created', 'payment_received', 'due_date_reminder', 'service_suspension', 'service_restoration'];
        
        keys.forEach(key => {
            const textarea = document.getElementById(`${key}_template`);
            const toggle = document.getElementById(`${key}_enabled`);
            if (textarea) {
                templateData[key] = {
                    template: textarea.value,
                    enabled: toggle ? toggle.checked : true
                };
            }
        });
        
        try {
            const response = await fetch('/admin/billing/whatsapp-settings/templates', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(templateData)
            });
            const data = await response.json();
            if (data.success) showToast('success', 'Berhasil', 'Semua template tersimpan!');
            else showToast('error', 'Gagal', 'Gagal menyimpan template');
        } catch (error) { showToast('error', 'Error', 'Terjadi kesalahan sistem'); }
    }

    // --- 4. TEST TEMPLATE ---
    function testTemplate(templateKey) {
        const phoneNumber = prompt('Masukkan nomor tujuan untuk test (628xxx):');
        if (!phoneNumber) return;
        sendTestRequest(phoneNumber, templateKey);
    }

    // --- 5. TEST FORM ---
    $('#testForm').submit(function(e) {
        e.preventDefault();
        const phoneNumber = $('#testPhoneNumber').val();
        const templateKey = $('#testTemplateSelect').val();
        if (!phoneNumber) { alert('Masukkan nomor tujuan'); return; }
        sendTestRequest(phoneNumber, templateKey);
    });

    function sendTestRequest(phone, key) {
        showToast('warning', 'Sedang Mengirim', 'Tunggu sebentar...');
        $.post('/admin/billing/whatsapp-settings/test', {
            phoneNumber: phone,
            templateKey: key
        })
        .done(res => {
            if(res.success) showToast('success', 'Berhasil', 'Pesan test terkirim!');
            else showToast('error', 'Gagal', res.message || 'Gagal mengirim pesan');
        })
        .fail(() => showToast('error', 'Error', 'Gagal menghubungi server gateway'));
    }

    // --- 6. BROADCAST ---
    function sendBroadcast() {
        const type = $('#broadcastType').val();
        const msg = $('#broadcastMsg').val();
        if(!msg) { alert("Isi pesan broadcast dulu!"); return; }
        if(!confirm("?? PERINGATAN: Kirim broadcast ke SELURUH pelanggan?")) return;

        showToast('warning', 'Processing', 'Memulai pengiriman massal...');
        $.post('/admin/billing/whatsapp-settings/broadcast', { type: type, message: msg })
        .done(res => {
             if(res.success) showToast('success', 'Selesai', `Sukses: ${res.sent}, Gagal: ${res.failed}`);
             else showToast('error', 'Gagal', res.message);
        })
        .fail(() => alert("Broadcast dijalankan di background server."));
    }

    // --- HELPER TOGGLE ---
    function enableAllTemplates() {
        $('input[type="checkbox"][id$="_enabled"]').prop('checked', true);
        showToast('success', 'Info', 'Semua diaktifkan (Klik Simpan untuk permanen)');
    }
    function disableAllTemplates() {
        $('input[type="checkbox"][id$="_enabled"]').prop('checked', false);
        showToast('warning', 'Info', 'Semua dinonaktifkan (Klik Simpan untuk permanen)');
    }
</script>

</body>
</html>