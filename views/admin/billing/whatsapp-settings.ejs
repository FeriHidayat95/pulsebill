                </div>
                <div class="bg-[#1e293b] border border-slate-700 rounded-2xl p-4 text-center shadow-lg group hover:border-cyan-500/50 transition-all">
                    <i class="bi bi-calendar-event text-2xl text-cyan-500 mb-1 block group-hover:scale-110 transition-transform"></i>
