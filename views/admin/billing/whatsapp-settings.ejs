<%- include('../../partials/header') %>
<body class="bg-[#0f172a] text-slate-300 font-sans antialiased selection:bg-blue-500 selection:text-white">

<%- include('../../partials/admin-header') %>

<%- include('../../partials/billing-sidebar', { page: 'whatsapp-settings', settings: settings }) %>

<main class="p-4 sm:ml-64 pt-20 min-h-screen">

    <div class="bg-[#1e293b] border-l-4 border-l-[#25D366] border-y border-r border-slate-700/60 rounded-2xl p-6 mb-8 shadow-2xl flex flex-col md:flex-row justify-between items-center gap-4">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tighter uppercase leading-none">
                WhatsApp <span class="text-[#25D366]">Notification</span>
            </h1>
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[4px] mt-2">Pusat Pengaturan Notifikasi & Broadcast</p>
        </div>
        
