                    <textarea id="invoice_created_template" rows="4" class="w-full bg-[#0f172a] border border-slate-700 rounded-2xl p-4 text-sm text-slate-300 focus:ring-blue-500 focus:border-blue-500 placeholder-slate-600 font-medium"></textarea>
