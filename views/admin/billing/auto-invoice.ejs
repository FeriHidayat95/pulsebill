<%- include('../../partials/header') %>
<body class="bg-[#0f172a] text-slate-300 font-sans antialiased selection:bg-blue-500 selection:text-white">
<%- include('../../partials/admin-header') %>
<%- include('../../partials/billing-sidebar', { page: 'auto-invoice', settings: settings }) %>
<main class="p-4 sm:ml-64 pt-20 min-h-screen" id="main-content-area">
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
        <div>
            <h1 class="text-3xl font-black text-white tracking-tighter uppercase leading-none">
                Auto <span class="text-blue-500">Invoice</span>
            </h1>
            <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[4px] mt-2">Sistem Tagihan Otomatis Terintegrasi</p>
        </div>
        
        <div class="flex items-center gap-3 bg-[#1e293b] border border-slate-700 px-5 py-2.5 rounded-2xl shadow-xl">
            <span class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Status Sistem:</span>
            
            <div id="status-container">
                <% if (typeof autoInvoiceEnabled !== 'undefined' && autoInvoiceEnabled) { %>
                    <span class="flex items-center text-emerald-400 font-black text-xs uppercase animate-pulse">
                        <span class="w-2 h-2 bg-emerald-500 rounded-full me-2 shadow-[0_0_10px_rgba(16,185,129,0.5)]"></span> AKTIF
                    </span>
                <% } else { %>
                    <span class="flex items-center text-red-400 font-black text-xs uppercase">
                        <span class="w-2 h-2 bg-red-500 rounded-full me-2 shadow-[0_0_10px_rgba(239,68,68,0.5)]"></span> NON-AKTIF
                    </span>
                <% } %>
            </div>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
        <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-5 shadow-lg group hover:border-blue-500/50 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Jadwal Berjalan</p>
                    <h3 class="text-lg font-black text-white">
                        Tgl <%= typeof invoiceDay !== 'undefined' ? invoiceDay : '1' %> 
                        <span class="text-[10px] text-slate-500">Bulanan</span>
                    </h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 border border-blue-500/20">
                    <i class="bi bi-calendar-check text-lg"></i>
                </div>
            </div>
        </div>
        <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-5 shadow-lg group hover:border-emerald-500/50 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Pelanggan Aktif</p>
                    <h3 class="text-2xl font-black text-emerald-400"><%= typeof activeCustomersCount !== 'undefined' ? activeCustomersCount : '0' %> <span class="text-xs text-slate-600">User</span></h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-500 border border-emerald-500/20">
                    <i class="bi bi-person-check text-lg"></i>
                </div>
            </div>
        </div>
        <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-5 shadow-lg group hover:border-cyan-500/50 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Invoice Bulan Ini</p>
                    <h3 class="text-2xl font-black text-cyan-400"><%= typeof thisMonthInvoicesCount !== 'undefined' ? thisMonthInvoicesCount : '0' %> <span class="text-xs text-slate-600">Terbit</span></h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-500 border border-cyan-500/20">
                    <i class="bi bi-receipt text-lg"></i>
                </div>
            </div>
        </div>
        <div class="bg-[#1e293b] border border-slate-700/60 rounded-2xl p-5 shadow-lg group hover:border-amber-500/50 transition-all">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Eksekusi Berikutnya</p>
                    <h3 class="text-sm font-black text-amber-400 uppercase tracking-tight"><%= typeof nextRunDate !== 'undefined' ? nextRunDate : '-' %></h3>
                </div>
                <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-500 border border-amber-500/20">
                    <i class="bi bi-clock-history text-lg"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mb-8">
        <div class="bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-700 bg-[#111827]/50">
                <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center gap-2">
                    <i class="bi bi-lightning-fill text-blue-500"></i> Kendali Manual
                </h3>
            </div>
            <div class="p-6 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <button id="generateInvoicesBtn" class="flex flex-col items-center justify-center p-6 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl transition-all shadow-lg shadow-blue-500/20 group">
                        <i class="bi bi-calendar-plus text-3xl mb-2 group-hover:scale-110 transition-transform"></i>
                        <span class="text-xs font-black uppercase tracking-widest">Generate Invoice</span>
                    </button>
                    
                    <button id="previewInvoicesBtn" class="flex flex-col items-center justify-center p-6 bg-[#111827] border border-slate-700 hover:border-cyan-500/50 text-cyan-400 rounded-2xl transition-all group">
                        <i class="bi bi-eye-fill text-3xl mb-2 group-hover:scale-110 transition-transform"></i>
                        <span class="text-xs font-black uppercase tracking-widest">Preview List</span>
                    </button>
                </div>
                <div class="p-4 bg-[#0f172a] rounded-xl border border-slate-700/50">
                    <p class="text-[10px] text-slate-500 font-bold leading-relaxed">
                        <i class="bi bi-info-circle text-blue-500 me-1"></i> 
                        Tombol generate akan membuat invoice untuk semua pelanggan aktif yang belum memiliki tagihan di bulan berjalan. Gunakan Preview terlebih dahulu untuk memastikan data.
                    </p>
                </div>
            </div>
        </div>
        <div class="bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden">
            <div class="px-6 py-5 border-b border-slate-700 bg-[#111827]/50">
                <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center gap-2">
                    <i class="bi bi-gear-fill text-amber-500"></i> Konfigurasi Otomatis
                </h3>
            </div>
            <form id="autoInvoiceSettingsForm" class="p-6 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Aktifkan Auto Invoice</label>
                        <select name="auto_invoice_enabled" class="bg-[#111827] border border-slate-700 text-white text-sm rounded-xl focus:ring-blue-500 block w-full p-2.5 font-bold">
                            <option value="true" <%= (typeof settings !== 'undefined' && settings.auto_invoice_enabled === 'true') ? 'selected' : '' %>>YA (AKTIF)</option>
                            <option value="false" <%= (typeof settings !== 'undefined' && settings.auto_invoice_enabled === 'false') ? 'selected' : '' %>>TIDAK (MATI)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Kirim Notifikasi WA</label>
                        <select name="send_notification" class="bg-[#111827] border border-slate-700 text-white text-sm rounded-xl focus:ring-blue-500 block w-full p-2.5 font-bold">
                            <option value="true" <%= (typeof settings !== 'undefined' && settings.send_notification === 'true') ? 'selected' : '' %>>YA (KIRIM)</option>
                            <option value="false" <%= (typeof settings !== 'undefined' && settings.send_notification === 'false') ? 'selected' : '' %>>TIDAK</option>
                        </select>
                    </div>
                    <div>
                        <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Tanggal Eksekusi (1-31)</label>
                        <input type="number" name="invoice_day" value="<%= (typeof settings !== 'undefined') ? settings.invoice_day : 1 %>" min="1" max="31" class="bg-[#111827] border border-slate-700 text-white text-sm rounded-xl focus:ring-blue-500 block w-full p-2.5 font-black">
                    </div>
                    <div>
                        <label class="block mb-2 text-[10px] font-black text-slate-500 uppercase tracking-widest">Masa Berlaku (Hari)</label>
                        <input type="number" name="due_date_days" value="<%= (typeof settings !== 'undefined') ? settings.due_date_days : 30 %>" min="1" max="90" class="bg-[#111827] border border-slate-700 text-white text-sm rounded-xl focus:ring-blue-500 block w-full p-2.5 font-black">
                    </div>
                </div>
                <div class="pt-2">
                    <button type="submit" class="w-full py-3 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-black rounded-xl transition-all uppercase tracking-widest shadow-lg shadow-emerald-500/20">
                        <i class="bi bi-save2 me-2"></i> Simpan Pengaturan
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div id="previewSection" class="hidden bg-[#1e293b] border border-slate-700/60 rounded-3xl shadow-2xl overflow-hidden mb-10 animate-fade-in">
        <div class="px-6 py-5 border-b border-slate-700 bg-[#111827]/50 flex justify-between items-center">
            <h3 class="text-xs font-black text-white uppercase tracking-widest flex items-center gap-2">
                <i class="bi bi-list-columns-reverse text-cyan-400"></i> Preview Invoice Terdeteksi
            </h3>
            <div class="flex gap-2">
                <button id="confirmGenerateBtn" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-[10px] font-black rounded-lg uppercase tracking-tighter transition-all">Konfirmasi Generate</button>
                <button id="cancelPreviewBtn" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white text-[10px] font-black rounded-lg uppercase tracking-tighter transition-all">Batal</button>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table id="previewTable" class="w-full text-left text-slate-400">
                <thead class="text-[10px] text-slate-500 uppercase bg-[#111827]/30 border-b border-slate-700">
                    <tr>
                        <th class="px-6 py-4 font-black">Username</th>
                        <th class="px-6 py-4 font-black">Nama Pelanggan</th>
                        <th class="px-6 py-4 font-black">Paket</th>
                        <th class="px-6 py-4 font-black">Harga</th>
                        <th class="px-6 py-4 font-black text-center">Status</th>
                    </tr>
                </thead>
                <tbody id="previewTableBody" class="divide-y divide-slate-700/50">
                </tbody>
            </table>
        </div>
    </div>
</main>
<%- include('../../partials/footer') %>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/socket.io/socket.io.js"></script>
<script>
    $(document).ready(function() {
        const socket = io();
        // Real-time Update Lampu Indikator
        socket.on('autoInvoiceStatusUpdate', (data) => {
            console.log("[SOCKET] System event received:", data);
            const container = $('#status-container');
            
            if (data.enabled) {
                container.html(`
                    <span class="flex items-center text-emerald-400 font-black text-xs uppercase animate-pulse">
                        <span class="w-2 h-2 bg-emerald-500 rounded-full me-2 shadow-[0_0_10px_rgba(16,185,129,0.5)]"></span> AKTIF
                    </span>
                `);
                showAlert('success', 'SISTEM AKTIF: Tagihan akan berjalan sesuai jadwal.');
            } else {
                container.html(`
                    <span class="flex items-center text-red-400 font-black text-xs uppercase">
                        <span class="w-2 h-2 bg-red-500 rounded-full me-2 shadow-[0_0_10px_rgba(239,68,68,0.5)]"></span> NON-AKTIF
                    </span>
                `);
                showAlert('warning', 'SISTEM MATI: Tagihan otomatis dinonaktifkan.');
            }
        });
        // --- ??? 2. HELPER: NOTIFIKASI ---
        function showAlert(type, message) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: type === 'danger' ? 'error' : (type === 'warning' ? 'warning' : 'success'),
                title: message,
                showConfirmButton: false,
                timer: 3000,
                background: '#1e293b',
                color: '#fff',
                timerProgressBar: true
            });
        }
        // --- ?? 3. FITUR: GENERATE INVOICES ---
        $('#generateInvoicesBtn').on('click', function() {
            Swal.fire({
                title: 'Generate Invoice?',
                text: "Invoice akan dibuat untuk semua pelanggan aktif bulan ini.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Jalankan!',
                background: '#1e293b',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    const btn = $(this);
                    const originalContent = btn.html();
                    btn.prop('disabled', true).html('<i class="bi bi-arrow-repeat animate-spin text-2xl"></i>');
                    
                    fetch('/admin/billing/auto-invoice/generate', { 
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({ 
                                icon: 'success', 
                                title: 'Berhasil!', 
                                text: `${data.count} invoice telah dibuat.`, 
                                background: '#1e293b', 
                                color: '#fff' 
                            }).then(() => location.reload());
                        } else {
                            showAlert('danger', data.message || 'Gagal generate invoice');
                        }
                    })
                    .catch(() => showAlert('danger', 'Terjadi kesalahan koneksi server'))
                    .finally(() => {
                        btn.prop('disabled', false).html(originalContent);
                    });
                }
            });
        });
        // --- ?? 4. FITUR: PREVIEW LIST ---
        $('#previewInvoicesBtn').on('click', function() {
            const btn = $(this);
            const originalContent = btn.html();
            btn.prop('disabled', true).html('<i class="bi bi-arrow-repeat animate-spin text-2xl"></i>');
            
            fetch('/admin/billing/auto-invoice/preview')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    displayPreview(data.customers);
                    const section = $('#previewSection');
                    section.removeClass('hidden');
                    $('html, body').animate({ scrollTop: section.offset().top }, 800);
                } else {
                    showAlert('danger', data.message || 'Gagal memuat preview');
                }
            })
            .catch(() => showAlert('danger', 'Gagal memuat preview: Cek rute server'))
            .finally(() => {
                btn.prop('disabled', false).html(originalContent);
            });
        });
        function displayPreview(customers) {
            const tbody = $('#previewTableBody');
            tbody.empty();
            if (!customers || customers.length === 0) {
                tbody.html('<tr><td colspan="5" class="px-6 py-10 text-center text-slate-500 font-bold uppercase tracking-widest text-[10px]">Semua pelanggan sudah memiliki invoice bulan ini</td></tr>');
                return;
            }
            customers.forEach(customer => {
                const row = `
                    <tr class="hover:bg-slate-800/50 transition-colors">
                        <td class="px-6 py-4 font-mono text-xs font-bold text-blue-400">${customer.username}</td>
                        <td class="px-6 py-4 font-bold text-white text-sm">${customer.name}</td>
                        <td class="px-6 py-4"><span class="px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-[10px] font-bold text-slate-400 uppercase">${customer.package_name || '-'}</span></td>
                        <td class="px-6 py-4 font-mono text-xs font-bold text-emerald-400">Rp ${parseFloat(customer.package_price || 0).toLocaleString('id-ID')}</td>
                        <td class="px-6 py-4 text-center"><span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-500 text-[9px] font-black border border-emerald-500/20">READY</span></td>
                    </tr>
                `;
                tbody.append(row);
            });
        }
        // --- ?? 5. FITUR: SAVE SETTINGS (FIXED LOGIC) ---
        $('#autoInvoiceSettingsForm').on('submit', function(e) {
            e.preventDefault();
            const btn = $(this).find('button[type="submit"]');
            const originalText = btn.html();
            btn.prop('disabled', true).html('<i class="bi bi-arrow-repeat animate-spin me-2"></i> MENYIMPAN...');
            // ?? PERBAIKAN DI SINI: Membaca Dropdown (bukan Checkbox)
            const statusVal = $('select[name="auto_invoice_enabled"]').val(); 
            const notifyVal = $('select[name="send_notification"]').val();
            const dayVal = $('input[name="invoice_day"]').val();
            const dueVal = $('input[name="due_date_days"]').val();
            
            const data = {
                auto_invoice_enabled: statusVal, 
                send_notification: notifyVal,
                invoice_day: dayVal,
                due_date_days: dueVal
            };
            
            console.log("?? Mengirim data ke server:", data);
            fetch('/admin/billing/auto-invoice/settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showAlert('success', 'Pengaturan berhasil disimpan');
                    // Lampu indikator akan berubah otomatis via sinyal Socket.io dari server
                } else {
                    showAlert('danger', data.message || 'Gagal menyimpan');
                }
            })
            .catch((err) => {
                console.error("Fetch Error:", err);
                showAlert('danger', 'Terjadi kesalahan koneksi server');
            })
            .finally(() => {
                btn.prop('disabled', false).html(originalText);
            });
        });
        
        // --- ?? 6. EVENT TOMBOL LAINNYA ---
        $('#confirmGenerateBtn').on('click', () => $('#generateInvoicesBtn').click());
        $('#cancelPreviewBtn').on('click', () => $('#previewSection').addClass('hidden'));
    });
</script>
<style>
    @keyframes fade-in { 
        from { opacity: 0; transform: translateY(10px); } 
        to { opacity: 1; transform: translateY(0); } 
    }
    .animate-fade-in { animation: fade-in 0.4s ease-out forwards; }
    .overflow-x-auto::-webkit-scrollbar { height: 5px; }
    .overflow-x-auto::-webkit-scrollbar-track { background: #0f172a; }
    .overflow-x-auto::-webkit-scrollbar-thumb { background: #334155; border-radius: 10px; }
</style>
</body>
</html>
