<div class="modal fade" id="restartMikrotikModal" tabindex="-1" aria-labelledby="restartMikrotikModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #1f2937; color: #e5e7eb; border: 1px solid #374151; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
            
            <div class="modal-header" style="border-bottom: 1px solid #374151;">
                <h5 class="modal-title font-weight-bold text-white" id="restartMikrotikModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Konfirmasi Restart
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body text-center py-4">
                <p class="mb-3">Apakah Anda yakin ingin melakukan <b>RESTART MIKROTIK</b>?</p>
                <div class="alert alert-danger d-inline-block text-start" style="background: rgba(220, 38, 38, 0.1); border: 1px solid rgba(220, 38, 38, 0.3); color: #fca5a5; font-size: 0.9rem;">
                    <i class="bi bi-info-circle me-1"></i> 
                    Koneksi internet seluruh pelanggan akan <strong>terputus sementara</strong> selama proses reboot berlangsung.
                </div>
            </div>
            
            <div class="modal-footer" style="border-top: 1px solid #374151;">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="background-color: #374151; border: none;">
                    BATAL
                </button>
                <button type="button" class="btn btn-danger btn-sm fw-bold" id="confirmRestartMikrotik" style="box-shadow: 0 4px 6px rgba(220, 38, 38, 0.3);">
                    <i class="bi bi-power me-1"></i> YA, RESTART SEKARANG
                </button>
            </div>
            
        </div>
    </div>
</div>

<div id="restartNotif" class="alert d-none position-fixed top-0 end-0 m-4 shadow-lg" 
     style="z-index: 9999; min-width: 320px; border-radius: 12px; font-weight: 600;">
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
$(function() {
    // Trigger Modal saat tombol di Sidebar diklik
    $(document).on('click', '#restartMikrotikBtn', function(e) {
        e.preventDefault();
        $('#restartMikrotikModal').modal('show');
    });

    // Eksekusi Restart
    $('#confirmRestartMikrotik').on('click', function() {
        // Efek Loading di Tombol
        let btn = $(this);
        let originalText = btn.html();
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span>Rebooting...');

        // Kirim Request
        $.ajax({
            url: '/admin/mikrotik/restart',
            method: 'POST',
            success: function(res) {
                $('#restartMikrotikModal').modal('hide');
                
                let notif = $('#restartNotif');
                let bgClass = res.success ? 
                    'background-color: #1f2937; color: #34d399; border: 1px solid #059669;' : // Sukses (Hijau Gelap)
                    'background-color: #1f2937; color: #f87171; border: 1px solid #dc2626;'; // Gagal (Merah Gelap)
                
                let icon = res.success ? '<i class="bi bi-check-circle-fill me-2"></i>' : '<i class="bi bi-x-circle-fill me-2"></i>';

                notif.attr('style', `z-index: 9999; min-width: 320px; border-radius: 12px; font-weight: 600; ${bgClass}`)
                     .html(icon + (res.message || 'Proses selesai!'))
                     .removeClass('d-none').fadeIn();

                setTimeout(function() { notif.fadeOut(); }, 5000);
            },
            error: function() {
                $('#restartMikrotikModal').modal('hide');
                let notif = $('#restartNotif');
                notif.attr('style', 'z-index: 9999; min-width: 320px; border-radius: 12px; font-weight: 600; background-color: #1f2937; color: #f87171; border: 1px solid #dc2626;')
                     .html('<i class="bi bi-wifi-off me-2"></i> Gagal menghubungi server!')
                     .removeClass('d-none').fadeIn();
                setTimeout(function() { notif.fadeOut(); }, 5000);
            },
            complete: function() {
                // Kembalikan tombol (walaupun modal sudah tutup, untuk jaga-jaga)
                btn.prop('disabled', false).html(originalText);
            }
        });
    });
});
</script>