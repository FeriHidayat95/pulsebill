<%- include('partials/header') %>
<%- include('partials/admin-header') %>
<%- include('partials/admin-sidebar', { page: 'nas' }) %>
<main class="p-4 sm:ml-64 pt-20 bg-gray-900 min-h-screen text-gray-300">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 border-b border-gray-800 pb-4">
        <div>
            <h1 class="text-2xl font-black text-white tracking-tight uppercase">Router Mikrotik (NAS)</h1>
            <p class="text-sm text-gray-400 font-bold tracking-widest uppercase">Koneksi Radius & API Management</p>
        </div>
        
        <button data-modal-target="modalTambahNas" data-modal-toggle="modalTambahNas" class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-black px-5 py-2.5 rounded-xl shadow-lg transition-all border border-blue-500 flex items-center">
            <i class="bi bi-plus-circle me-2 text-lg"></i> TAMBAH ROUTER
        </button>
    </div>
    <div class="bg-gray-800 rounded-3xl shadow-2xl overflow-hidden border border-gray-700">
        <div class="p-4 bg-gray-900/50 border-b border-gray-700 flex justify-between items-center">
            <h5 class="font-black text-white text-xs uppercase tracking-widest flex items-center">
                <i class="bi bi-router-fill me-2 text-purple-500"></i> Terdaftar di Network
            </h5>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left text-gray-300">
                <thead class="text-[10px] text-gray-500 uppercase bg-gray-900 font-black">
                    <tr>
                        <th class="px-6 py-4">Nama Router</th>
                        <th class="px-6 py-4">IP Address</th>
                        <th class="px-6 py-4 text-center">API Status</th>
                        <th class="px-6 py-4 text-right">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-700">
                    <% if (locals.nasList && nasList.length > 0) { %>
                        <% nasList.forEach(nas => { %>
                        <tr class="hover:bg-gray-700/50 transition-all group">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <div class="w-10 h-10 bg-gray-900 rounded-xl flex items-center justify-center text-blue-500 border border-gray-700 shadow-inner group-hover:border-blue-500/50 transition-all">
                                        <i class="bi bi-router"></i>
                                    </div>
                                    <div class="ms-3">
                                        <div class="font-black text-white text-base"><%= nas.shortname %></div>
                                        <div class="text-[10px] font-bold text-gray-500 uppercase tracking-tighter">Port: <%= nas.api_port || '8728' %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span class="bg-gray-900 border border-gray-700 text-blue-400 px-3 py-1.5 rounded-lg font-mono text-xs font-bold shadow-inner">
                                    <%= nas.nasname %>
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center" id="status-<%= nas.id %>">
                                <div class="flex justify-center">
                                    <div class="h-2.5 w-2.5 bg-gray-600 rounded-full animate-pulse"></div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="inline-flex shadow-sm rounded-xl overflow-hidden border border-gray-700">
                                    <button class="p-2 bg-gray-900 hover:bg-yellow-900/50 text-yellow-500 border-r border-gray-700 btn-edit" 
                                            data-id="<%= nas.id %>"
                                            data-shortname="<%= nas.shortname %>"
                                            data-nasname="<%= nas.nasname %>"
                                            data-secret="<%= nas.secret %>"
                                            data-user="<%= nas.api_user %>"
                                            data-port="<%= nas.api_port %>">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <form action="/admin/nas/delete" method="POST" class="inline" onsubmit="return confirm('Hapus router?')">
                                        <input type="hidden" name="id" value="<%= nas.id %>">
                                        <button type="submit" class="p-2 bg-gray-900 hover:bg-red-900/50 text-red-500">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="4" class="text-center py-10 text-gray-600 font-bold uppercase tracking-widest">Belum ada router terdaftar</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</main>
<div id="modalTambahNas" tabindex="-1" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
    <div class="bg-gray-800 w-full max-w-md rounded-3xl border border-gray-700 shadow-2xl overflow-hidden">
        <div class="p-5 bg-gray-900 border-b border-gray-800 flex justify-between items-center">
            <h3 class="text-white font-black uppercase tracking-tighter">Tambah Router Baru</h3>
            <button data-modal-hide="modalTambahNas" class="text-gray-500 hover:text-white"><i class="bi bi-x-lg"></i></button>
        </div>
        <form action="/admin/nas/add" method="POST" class="p-6 space-y-4">
            <div>
                <label class="block mb-1 text-[10px] font-black text-gray-500 uppercase">Nama Identitas</label>
                <input type="text" name="shortname" class="w-full bg-gray-900 border-gray-700 rounded-xl p-3 text-white text-sm" placeholder="Mikrotik-Pusat" required>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block mb-1 text-[10px] font-black text-gray-500 uppercase">IP Mikrotik</label>
                    <input type="text" name="nasname" class="w-full bg-gray-900 border-gray-700 rounded-xl p-3 text-white text-sm font-mono" placeholder="192.168.1.1" required>
                </div>
                <div>
                    <label class="block mb-1 text-[10px] font-black text-gray-500 uppercase">Radius Secret</label>
                    <input type="text" name="secret" class="w-full bg-gray-900 border-gray-700 rounded-xl p-3 text-white text-sm font-mono" placeholder="rahasia123" required>
                </div>
            </div>
            <div class="p-4 bg-gray-900/50 rounded-2xl border border-gray-700 space-y-3">
                <p class="text-[10px] font-black text-blue-500 uppercase tracking-widest"><i class="bi bi-cpu-fill me-1"></i> API Connection Settings</p>
                <div class="grid grid-cols-2 gap-3">
                    <input type="text" name="api_user" class="bg-gray-800 border-gray-700 text-white text-xs rounded-lg p-2.5" value="admin" placeholder="User">
                    <input type="number" name="api_port" class="bg-gray-800 border-gray-700 text-white text-xs rounded-lg p-2.5" value="8728">
                </div>
                <input type="password" name="api_password" class="w-full bg-gray-800 border-gray-700 text-white text-xs rounded-lg p-2.5" placeholder="Password API">
            </div>
            <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black py-3.5 rounded-2xl shadow-lg shadow-blue-900/30">SIMPAN ROUTER</button>
        </form>
    </div>
</div>
<div id="modalEditNas" tabindex="-1" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 backdrop-blur-sm p-4">
    <div class="bg-gray-800 w-full max-w-md rounded-3xl border border-gray-700 shadow-2xl overflow-hidden">
        <div class="p-5 bg-gray-900 border-b border-gray-800 flex justify-between items-center text-yellow-500">
            <h3 class="font-black uppercase tracking-tighter">Edit Data Router</h3>
            <button onclick="closeModal('modalEditNas')" class="text-gray-500 hover:text-white"><i class="bi bi-x-lg"></i></button>
        </div>
        <form action="/admin/nas/edit" method="POST" class="p-6 space-y-4">
            <input type="hidden" name="id" id="edit_id">
            <div>
                <label class="block mb-1 text-[10px] font-black text-gray-500 uppercase">Nama Router</label>
                <input type="text" name="shortname" id="edit_shortname" class="w-full bg-gray-900 border-gray-700 rounded-xl p-3 text-white text-sm" required>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <input type="text" name="nasname" id="edit_nasname" class="w-full bg-gray-900 border-gray-700 rounded-xl p-3 text-white font-mono" placeholder="IP">
                <input type="text" name="secret" id="edit_secret" class="w-full bg-gray-900 border-gray-700 rounded-xl p-3 text-white font-mono" placeholder="Secret">
            </div>
            <div class="p-4 bg-gray-900/50 rounded-2xl border border-gray-700 space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <input type="text" name="api_user" id="edit_api_user" class="bg-gray-800 border-gray-700 text-white text-xs rounded-lg p-2.5">
                    <input type="number" name="api_port" id="edit_api_port" class="bg-gray-800 border-gray-700 text-white text-xs rounded-lg p-2.5">
                </div>
                <input type="password" name="api_password" class="w-full bg-gray-800 border-gray-700 text-white text-xs rounded-lg p-2.5" placeholder="Ganti Password API?">
            </div>
            <button type="submit" class="w-full bg-yellow-600 hover:bg-yellow-500 text-white font-black py-3.5 rounded-2xl shadow-lg">UPDATE DATA</button>
        </form>
    </div>
</div>
<%- include('partials/footer') %>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
    function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
    $(document).ready(function() {
        // Toggle Modal Flowbite Manual
        $('[data-modal-toggle]').click(function() {
            const id = $(this).data('modal-target');
            openModal(id);
        });
        $('[data-modal-hide]').click(function() {
            const id = $(this).data('modal-hide');
            closeModal(id);
        });
        // Edit Logic
        $('.btn-edit').on('click', function() {
            const btn = $(this);
            $('#edit_id').val(btn.data('id'));
            $('#edit_shortname').val(btn.data('shortname'));
            $('#edit_nasname').val(btn.data('nasname'));
            $('#edit_secret').val(btn.data('secret'));
            $('#edit_api_user').val(btn.data('user'));
            $('#edit_api_port').val(btn.data('port'));
            openModal('modalEditNas');
        });
    // Synchronize subscriber account state
        <% if (locals.nasList && nasList.length > 0) { %>
            <% nasList.forEach(nas => { %>
                checkStatus('<%= nas.id %>');
            <% }) %>
        <% } %>
        function checkStatus(id) {
            const el = $(`#status-${id}`);
            $.get(`/admin/nas/check-status/${id}`)
                .done(function(data) {
                    if(data.online) {
                        el.html('<span class="bg-green-900/30 text-green-400 text-[10px] font-black px-2 py-1 rounded border border-green-800"><i class="bi bi-check-circle-fill me-1"></i> CONNECTED</span>');
                    } else {
                        el.html('<span class="bg-red-900/30 text-red-400 text-[10px] font-black px-2 py-1 rounded border border-red-800"><i class="bi bi-x-circle-fill me-1"></i> OFFLINE</span>');
                    }
                })
                .fail(function() {
                    el.html('<span class="text-gray-600 text-xs">Error</span>');
                });
        }
    });
</script>
