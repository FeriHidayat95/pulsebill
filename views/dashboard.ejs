<!DOCTYPE html>
<html lang="id" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Dashboard Pelanggan | Portal ISP</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" rel="stylesheet">
  <link href="https://cdn.datatables.net/responsive/2.5.0/css/dataTables.responsive.min.css" rel="stylesheet">
  <link href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
  
  <style>
    :root {
      --primary-color: #4361ee;
      --secondary-color: #3f37c9;
      --accent-color: #4895ef;
      --success-color: #10b981;
      --warning-color: #f59e0b;
      --danger-color: #ef4444;
      --card-border-radius: 16px;
      --btn-border-radius: 12px;
      --transition-speed: 0.3s;
      font-family: 'Inter', sans-serif;
    }
    
    body {
      background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
      font-family: var(--font-family);
      min-height: 100vh;
      color: #1e293b;
      line-height: 1.6;
    }
    
    /* Desktop Navbar Glassmorphism */
    .desktop-layout .navbar {
      background: rgba(255, 255, 255, 0.85) !important;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      position: sticky; top: 0; z-index: 1020;
    }
    .desktop-layout .navbar-brand { font-weight: 800; color: var(--primary-color) !important; letter-spacing: -0.5px; }
    .desktop-layout .navbar-brand img { height: 40px; border-radius: 10px; transition: transform var(--transition-speed); }
    .desktop-layout .navbar-brand:hover img { transform: scale(1.05); }
    
    .desktop-layout .btn-nav { border-radius: var(--btn-border-radius); font-size: 14px; font-weight: 600; padding: 8px 16px; }
    
    /* Desktop Cards */
    .desktop-layout .main-container { padding: 30px 0; display: flex; flex-direction: column; }
    .desktop-layout .form-section[style*="order: -1"], .desktop-layout .table-container[style*="order: -1"] { order: -1; }
    
    .desktop-layout .card, .desktop-layout .form-section, .desktop-layout .table-container {
      background: #ffffff; border: 1px solid rgba(0,0,0,0.05); border-radius: var(--card-border-radius);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02); transition: all var(--transition-speed) ease; margin-bottom: 25px;
    }
    .desktop-layout .card:hover, .desktop-layout .form-section:hover, .desktop-layout .table-container:hover {
      transform: translateY(-3px); box-shadow: 0 15px 35px rgba(0, 0, 0, 0.06);
    }
    
    .desktop-layout .card-header { background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); color: white; border: none; padding: 25px; }
    
    .desktop-layout .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
    .desktop-layout .stat-card { background: white; border-radius: var(--card-border-radius); padding: 20px; border: 1px solid rgba(0,0,0,0.05); display: flex; align-items: center; gap: 15px; }
    .desktop-layout .stat-icon { width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; color: white; }
    
    .desktop-layout .stat-icon.wifi { background: linear-gradient(135deg, #4895ef, #3f37c9); }
    .desktop-layout .stat-icon.cpu { background: linear-gradient(135deg, #f72585, #b5179e); }
    .desktop-layout .stat-icon.clock { background: linear-gradient(135deg, #7209b7, #560bad); }
    .desktop-layout .stat-icon.activity { background: linear-gradient(135deg, #4cc9f0, #4361ee); }
    .desktop-layout .stat-icon.globe { background: linear-gradient(135deg, #10b981, #059669); }
    .desktop-layout .stat-icon.person { background: linear-gradient(135deg, #f59e0b, #d97706); }
    .desktop-layout .stat-icon.people { background: linear-gradient(135deg, #6366f1, #3b82f6); }
    
    .desktop-layout .stat-label { font-size: 11px; color: #64748b; margin-bottom: 5px; font-weight: 700; text-transform: uppercase; }
    .desktop-layout .stat-value { font-size: 16px; font-weight: 800; color: #1e293b; margin: 0; }
    
    .desktop-layout .form-section { padding: 25px; }
    .desktop-layout .form-section h6, .desktop-layout .table-container h6 { font-weight: 800; display: flex; align-items: center; gap: 10px; font-size: 16px; margin-bottom: 20px; }
    .desktop-layout .form-section h6 i, .desktop-layout .table-container h6 i { color: var(--primary-color); font-size: 18px; }
    
    .desktop-layout .form-control { border-radius: 10px; padding: 12px 20px; border: 1px solid rgba(0,0,0,0.1); }
    .desktop-layout .form-control:focus { box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.15); border-color: var(--primary-color); }
    
    .desktop-layout .btn-action { padding: 12px 20px; border-radius: 10px; font-weight: 600; display: flex; align-items: center; gap: 8px; border: none; color: white; }
    .desktop-layout .btn-ssid { background: linear-gradient(135deg, #4895ef, #3f37c9); }
    .desktop-layout .btn-password { background: linear-gradient(135deg, #7209b7, #560bad); }
    .desktop-layout .btn-restart { background: linear-gradient(135deg, #ef4444, #b91c1c); }
    
    .desktop-layout table.dataTable { border-collapse: separate !important; border-spacing: 0; border-radius: 12px; overflow: hidden; }
    .desktop-layout table.dataTable thead th { background: rgba(0,0,0,0.02); border-bottom: 1px solid rgba(0,0,0,0.05); font-weight: 700; padding: 15px; font-size: 13px; text-transform: uppercase; }
    .desktop-layout table.dataTable tbody td { padding: 15px; border-bottom: 1px solid rgba(0,0,0,0.05); font-size: 14px; vertical-align: middle; }
    
    @media (max-width: 991px) { .desktop-layout .stats-grid { grid-template-columns: repeat(2, 1fr); } }
  </style>

  <style id="mobile-ui-styles">
      @media (max-width: 767.98px) {
          /* --- KUNCI LAYAR ANTI BOCOR SAMPING --- */
            html, body {
                overflow-x: hidden !important; /* Potong yang tumpah ke samping */
                width: 100% !important;
                max-width: 100vw !important;
                margin: 0 !important;
                padding: 0 !important;
            }
                    /* Bikin warna dasar layar full ngikutin Dark/Light Mode biar gak bocor putih */
          body { padding-bottom: 90px; min-height: 100vh; }
          html[data-bs-theme="dark"] body { background: #1e1e2d !important; }
          html[data-bs-theme="light"] body { background: #f9fbfd !important; }
          
          
          /* Sembunyikan teks footer yang nyangkut di paling atas layar biar rapi */
          .mob-top-footer { display: none !important; }
          .mobile-layout { color: #1e293b; font-family: 'Inter', sans-serif; }
          /* Mode Terang (Default) */
            .mobile-layout, 
            .mobile-layout[data-theme="light"] { 
                background: #f9fbfd !important; /* Warna kanvas terang */
                min-height: 100vh; /* Kunci biar nutup full ke bawah */
                --card-bg: #ffffff; 
                --border-color: #f1f5f9; 
                --text-muted: #64748b; 
            }
            
            /* Mode Gelap (Dark Mode) */
            .mobile-layout[data-theme="dark"] { 
                background: #1e1e2d !important; /* Warna kanvas gelap nyaru */
                color: #f8fafc; 
                min-height: 100vh; /* Kunci biar nutup full ke bawah */
                --card-bg: #2a2a3c; 
                --border-color: #3b3b54; 
                --text-muted: #a1a1aa; 
            }
          
          .mob-top-footer { font-size: 10px; text-align: center; margin: 15px 0 10px 0; color: var(--text-muted); letter-spacing: 0.5px; }
          /* --- HEADER STICKY MELAYANG --- */
            .mob-header { 
                position: sticky !important; 
                top: 0; 
                z-index: 1020; 
                padding: 20px; 
                display: flex; 
                justify-content: space-between; 
                align-items: center; 
                background-color: #f9fbfd; /* Background terang default */
                margin-left: -20px; /* Reset margin biar full lebar */
                margin-right: -20px;
                padding-left: 40px; /* Balikin padding yang keriset */
                padding-right: 40px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.03); /* Efek bayangan melayang */
                margin-bottom: 20px;
            }

            /* Warna Header pas Dark Mode (Anti Bocor) */
            html[data-bs-theme="dark"] .mob-header,
            .mobile-layout[data-theme="dark"] .mob-header {
                background-color: #1e1e2d !important;
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            }
          .mob-wifi-icon { background: var(--card-bg); color: #4361ee; border-radius: 12px; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 4px 15px rgba(67, 97, 238, 0.15); border: 1px solid var(--border-color); }
          
          /* Hero Section */
          .mob-hero { background: linear-gradient(135deg, #4361ee 0%, #7209b7 100%); color: white; border-radius: 20px; padding: 22px; margin: 0 20px 20px 20px; position: relative; overflow: hidden; box-shadow: 0 12px 25px rgba(63, 55, 201, 0.25); }
          .mob-hero::after { content: ''; position: absolute; right: -30px; bottom: -30px; width: 120px; height: 120px; background: rgba(255,255,255,0.1); border-radius: 50%; }
          .mob-hero-badge { background: rgba(255,255,255,0.2); backdrop-filter: blur(5px); font-size: 10px; padding: 4px 10px; border-radius: 12px; font-weight: 700; }
          
          /* Grid 8 Ikon */
          .mob-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 0 20px 25px 20px; }
          .mob-grid-item { background: var(--card-bg); border-radius: 16px; padding: 15px 5px; text-align: center; text-decoration: none; color: inherit; border: 1px solid var(--border-color); box-shadow: 0 4px 10px rgba(0,0,0,0.02); display: flex; flex-direction: column; align-items: center; transition: 0.2s; }
          .mob-grid-icon { font-size: 24px; color: #4895ef; margin-bottom: 6px; }
          .mob-grid-text { font-size: 10px; font-weight: 600; }

          /* Card Global Mobile */
          .mob-card { background: var(--card-bg); border-radius: 20px; padding: 20px; margin: 0 20px 20px 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); border: 1px solid var(--border-color); }
          
          /* Form Inputs Mobile */
          .mob-input-group { display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px; }
          .mob-input { background: rgba(0,0,0,0.02); border: 1px solid var(--border-color); padding: 12px 15px; border-radius: 12px; font-size: 13px; color: inherit; width: 100%; outline: none; }
          .mob-layout[data-theme="dark"] .mob-input { background: rgba(255,255,255,0.05); }
          .mob-btn { padding: 12px; border-radius: 12px; font-weight: 600; font-size: 13px; text-align: center; border: none; color: white; width: 100%; }
          .mob-btn-primary { background: #4361ee; }
          .mob-btn-danger { background: #ef4444; }
          
          /* List Perangkat */
          .mob-device-list { display: flex; flex-direction: column; gap: 10px; }
          .mob-device-item { padding: 12px; border: 1px solid var(--border-color); border-radius: 12px; display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.01); }

          /* Bottom Nav */
          .mob-nav { position: fixed; bottom: 0; left: 0; width: 100%; background: var(--card-bg); display: flex; justify-content: space-around; align-items: center; padding: 10px 5px 15px 5px; box-shadow: 0 -5px 25px rgba(0,0,0,0.05); z-index: 1000; border-top: 1px solid var(--border-color); }
          .mob-nav-item { display: flex; flex-direction: column; align-items: center; color: var(--text-muted); font-size: 10px; text-decoration: none; flex: 1; font-weight: 500; }
          .mob-nav-item.active { color: #4361ee; font-weight: 700; }
          .mob-nav-fab { background: linear-gradient(135deg, #4361ee 0%, #3f37c9 100%); color: white; width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; transform: translateY(-22px); box-shadow: 0 8px 20px rgba(67, 97, 238, 0.4); border: 5px solid #f9fbfd; }
          .mobile-layout[data-theme="dark"] .mob-nav-fab { border-color: #1e1e2d; }
      }
  </style>
</head>
<body>

  <div class="desktop-layout d-none d-md-block">
    <nav class="navbar navbar-expand-lg">
      <div class="container d-flex justify-content-between align-items-center">
        <a class="navbar-brand text-decoration-none" href="/customer/dashboard">
          <img id="logoImage" src="/img/<%= typeof settings !== 'undefined' && settings.logo_filename ? settings.logo_filename : 'logo.png' %>?v=<%= new Date().getTime() %>" alt="Logo"> 
          <span class="d-none d-sm-inline ms-2"><%= typeof settings !== 'undefined' && settings.companyHeader ? settings.companyHeader : 'Portal Pelanggan' %></span>
        </a>
        <div class="navbar-nav ms-auto d-flex align-items-center gap-2">
          <a href="/customer/billing/dashboard" class="btn btn-outline-primary btn-nav">
            <i class="bi bi-receipt me-1"></i>Billing
          </a>
          <a href="/customer/trouble/report" class="btn btn-outline-warning btn-nav">
            <i class="bi bi-exclamation-triangle me-1"></i>Lapor Gangguan
          </a>
          <a href="/customer/logout" class="btn btn-outline-danger btn-nav">
            <i class="bi bi-box-arrow-right me-1"></i>Logout
          </a>
          <span class="navbar-text ms-2 fw-bold text-dark d-flex align-items-center">
            <i class="bi bi-person-circle fs-5 me-2 text-primary"></i>
            <%= typeof billingData !== 'undefined' && billingData.customer ? billingData.customer.name : 'Pelanggan' %>
          </span>
        </div>
      </div>
    </nav>

    <div class="main-container">
      <div class="container">
        <% if (typeof notif !== 'undefined' && notif) { %>
          <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" id="notif-alert">
            <i class="bi bi-check-circle-fill me-2"></i><%= notif %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
        
        <script>
          setTimeout(function() {
            var notif = document.getElementById('notif-alert');
            if (notif) notif.classList.remove('show');
          }, 3000);
        </script>

        <div class="row">
          <div class="col-12">

            <% if (typeof billingData !== 'undefined' && billingData && billingData.customer) { %>
            <div class="form-section" style="order: -1;">
              <h6><i class="bi bi-receipt"></i>Informasi Tagihan</h6>
              <div class="row">
                <div class="col-md-6">
                  <div class="card border-0 bg-light h-100 shadow-sm">
                    <div class="card-body p-4">
                      <h6 class="card-title text-primary fw-bold mb-3"><i class="bi bi-person-circle me-2"></i>Data Pelanggan</h6>
                      <div class="mb-2"><strong>Nama:</strong> <%= billingData.customer.name %></div>
                      <div class="mb-2"><strong>Username:</strong> <%= billingData.customer.username %></div>
                      <div class="mb-2">
                        <strong>Paket:</strong> 
                        <% if (billingData.customer.package_name) { %>
                          <span class="badge bg-info text-dark rounded-pill px-2"><%= billingData.customer.package_name %> - Rp <%= parseFloat(billingData.customer.package_price).toLocaleString('id-ID') %></span>
                        <% } else { %>
                          <span class="text-muted">Belum ada paket</span>
                        <% } %>
                      </div>
                      <div class="mb-2">
                        <strong>Status Pembayaran:</strong>
                        <% if (billingData.customer.payment_status === 'paid') { %>
                          <span class="badge bg-success">Lunas</span>
                        <% } else if (billingData.customer.payment_status === 'unpaid' || billingData.customer.payment_status === 'overdue') { %>
                          <span class="badge bg-warning text-dark">Belum Lunas</span>
                        <% } else { %>
                          <span class="badge bg-secondary">Belum Ada Tagihan</span>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="card border-0 bg-light h-100 shadow-sm">
                    <div class="card-body p-4">
                      <h6 class="card-title text-primary fw-bold mb-3"><i class="bi bi-calculator me-2"></i>Ringkasan Tagihan</h6>
                      <div class="mb-2 d-flex justify-content-between border-bottom pb-1">
                        <span class="text-muted">Total Tagihan:</span> <strong><%= billingData.invoices.length %></strong>
                      </div>
                      <div class="mb-2 d-flex justify-content-between border-bottom pb-1">
                        <span class="text-muted">Tagihan Lunas:</span> <span class="badge bg-success"><%= billingData.invoices.filter(inv => inv.status === 'paid').length %></span>
                      </div>
                      <div class="mb-2 d-flex justify-content-between border-bottom pb-1">
                        <span class="text-muted">Tagihan Belum Lunas:</span> <span class="badge bg-warning text-dark"><%= billingData.invoices.filter(inv => inv.status === 'unpaid').length %></span>
                      </div>
                      <div class="mb-3 d-flex justify-content-between pt-1">
                        <span class="fw-bold">Total Tagihan Belum Lunas:</span> 
                        <span class="text-danger fw-bold fs-5">Rp <%= billingData.invoices.filter(inv => inv.status === 'unpaid').reduce((sum, inv) => sum + parseFloat(inv.amount), 0).toLocaleString('id-ID') %></span>
                      </div>
                      <div class="mt-3">
                        <a href="/customer/billing/dashboard" class="btn btn-primary btn-sm me-2 fw-semibold rounded-pill px-3"><i class="bi bi-eye me-1"></i>Detail Tagihan</a>
                        <% if (billingData.invoices.filter(inv => inv.status === 'unpaid').length > 0) { %>
                          <button class="btn btn-success btn-sm quick-pay-btn fw-semibold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#quickPayModal">
                            <i class="bi bi-credit-card me-1"></i>Bayar Cepat
                          </button>
                        <% } %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <% if (billingData.invoices && billingData.invoices.length > 0) { %>
            <div class="table-container" style="order: -1;">
              <h6><i class="bi bi-receipt-cutoff"></i>Riwayat Tagihan</h6>
              <div class="table-responsive">
                <table class="table table-hover align-middle" id="invoicesTable" style="width:100%">
                  <thead class="bg-light">
                    <tr>
                      <th>No. Tagihan</th>
                      <th>Jumlah</th>
                      <th>Jatuh Tempo</th>
                      <th>Status</th>
                      <th>Tanggal Dibuat</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% billingData.invoices.forEach(function(invoice) { %>
                      <tr>
                        <td><span class="fw-bold text-primary"><%= invoice.invoice_number %></span></td>
                        <td><span class="fw-bold">Rp <%= parseFloat(invoice.amount).toLocaleString('id-ID') %></span></td>
                        <td>
                          <span class="fw-bold"><%= new Date(billingData.customer.expired_date).toLocaleDateString('id-ID') %></span>
                        </td>
                        <td>
                          <% if (invoice.status === 'paid') { %>
                            <span class="badge bg-success rounded-pill px-3 py-2">Lunas</span>
                          <% } else if (invoice.status === 'unpaid') { %>
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Belum Lunas</span>
                          <% } %>
                        </td>
                        <td class="text-muted small"><%= new Date(invoice.created_at).toLocaleDateString('id-ID') %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
            <% } %>
            <% } else { %>
            <div class="form-section" style="order: -1;">
              <h6><i class="bi bi-receipt"></i>Informasi Tagihan</h6>
              <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i> Data tagihan belum tersedia. Silakan hubungi admin untuk mendaftarkan nomor telepon Anda ke sistem billing.
              </div>
            </div>
            <% } %>

            <div class="form-section">
              <h6><i class="bi bi-router"></i>Informasi Perangkat</h6>
              <div class="row">
                <div class="col-12">
                  <div class="stats-grid">
                    <div class="stat-card wifi">
                      <div class="stat-icon wifi"><i class="bi bi-circle-fill"></i></div>
                      <div class="stat-content">
                        <div class="stat-label">Status Perangkat</div>
                        <div class="stat-value">
                          <% if (customer.status === 'Online') { %>
                            <span class="badge bg-success stat-badge rounded-pill"><i class="bi bi-check-circle-fill"></i> Online</span>
                          <% } else { %>
                            <span class="badge bg-secondary stat-badge rounded-pill"><i class="bi bi-x-circle-fill"></i> <%= customer.status %></span>
                          <% } %>
                        </div>
                      </div>
                    </div>
                    <div class="stat-card wifi">
                      <div class="stat-icon wifi"><i class="bi bi-wifi"></i></div>
                      <div class="stat-content">
                        <div class="stat-label">SSID Saat Ini</div>
                        <div class="stat-value text-truncate" title="<%= customer.ssid %>"><%= customer.ssid %></div>
                      </div>
                    </div>
                    <div class="stat-card cpu">
                      <div class="stat-icon cpu"><i class="bi bi-cpu"></i></div>
                      <div class="stat-content">
                        <div class="stat-label">Software Version</div>
                        <div class="stat-value text-truncate"><%= customer.softwareVersion %></div>
                      </div>
                    </div>
                    <div class="stat-card clock">
                      <div class="stat-icon clock"><i class="bi bi-clock-history"></i></div>
                      <div class="stat-content">
                        <div class="stat-label">Last Inform</div>
                        <div class="stat-value fs-6 fw-medium"><%= customer.lastInform %></div>
                      </div>
                    </div>
                    <div class="stat-card activity">
                      <div class="stat-icon activity"><i class="bi bi-activity"></i></div>
                      <div class="stat-content">
                        <div class="stat-label">RX Power</div>
                        <div class="stat-value"><%= customer.rxPower %></div>
                      </div>
                    </div>
                    <div class="stat-card globe">
                      <div class="stat-icon globe"><i class="bi bi-globe"></i></div>
                      <div class="stat-content">
                        <div class="stat-label">PPPoE IP</div>
                        <div class="stat-value"><%= customer.pppoeIP %></div>
                      </div>
                    </div>
                    <div class="stat-card person">
                      <div class="stat-icon person"><i class="bi bi-person"></i></div>
                      <div class="stat-content">
                        <div class="stat-label">PPPoE Username</div>
                        <div class="stat-value text-truncate"><%= customer.pppoeUsername %></div>
                      </div>
                    </div>
                    <div class="stat-card people">
                      <div class="stat-icon people"><i class="bi bi-people"></i></div>
                      <div class="stat-content">
                        <div class="stat-label">User Terhubung</div>
                        <div class="stat-value"><%= customer.totalAssociations %> Device</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="form-section">
              <h6><i class="bi bi-gear-fill"></i>Pengaturan Perangkat Jarak Jauh</h6>
              <% if (customer.status !== 'Unknown' && customer.status !== 'Error' && customer.ssid !== '-') { %>
                <div class="row g-4 mt-2">
                  <div class="col-md-6">
                    <div class="card border-0 bg-light h-100 shadow-sm">
                      <div class="card-body p-4">
                        <h6 class="card-title text-primary fw-bold"><i class="bi bi-wifi me-2"></i>Ganti Nama WiFi (SSID)</h6>
                        <div class="input-group-responsive mt-3">
                          <input type="text" class="form-control" id="newSsid" placeholder="Nama WiFi baru" maxlength="32">
                          <button class="btn btn-action btn-ssid" type="button" id="changeSsidBtn">
                            <i class="bi bi-check-lg me-1"></i>Terapkan
                          </button>
                        </div>
                        <small class="text-muted mt-2 d-block"><i class="bi bi-info-circle me-1"></i>SSID harus 3-32 karakter.</small>
                      </div>
                    </div>
                  </div>

                  <div class="col-md-6">
                    <div class="card border-0 bg-light h-100 shadow-sm">
                      <div class="card-body p-4">
                        <h6 class="card-title text-primary fw-bold"><i class="bi bi-shield-lock me-2"></i>Ganti Password WiFi</h6>
                        <div class="input-group-responsive mt-3">
                          <input type="text" class="form-control" id="newPassword" placeholder="Password baru" maxlength="63">
                          <button class="btn btn-action btn-password" type="button" id="changePasswordBtn">
                            <i class="bi bi-check-lg me-1"></i>Terapkan
                          </button>
                        </div>
                        <small class="text-muted mt-2 d-block"><i class="bi bi-info-circle me-1"></i>Password minimal 8 karakter.</small>
                      </div>
                    </div>
                  </div>

                  <div class="col-12">
                    <div class="card border-0 shadow-sm" style="background: rgba(247, 37, 133, 0.05); border: 1px solid rgba(247, 37, 133, 0.2) !important;">
                      <div class="card-body p-4 d-flex justify-content-between align-items-center">
                        <div>
                          <h6 class="card-title text-danger fw-bold m-0"><i class="bi bi-arrow-clockwise me-2"></i>Restart Perangkat</h6>
                          <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Internet akan terputus sementara (1-2 menit).</small>
                        </div>
                        <button class="btn btn-action btn-restart rounded-pill px-4" type="button" id="restartDeviceBtn">
                          <i class="bi bi-power me-1"></i>Restart Router
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              <% } else { %>
                <div class="alert alert-warning border-0 shadow-sm rounded-4 mt-3">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  Perangkat tidak terdeteksi atau tidak terhubung. Fitur pengaturan WiFi hanya tersedia ketika perangkat online.
                </div>
              <% } %>
            </div>

            <div class="table-container">
              <h6><i class="bi bi-devices"></i>Perangkat Terhubung</h6>
              <% if (connectedUsers && connectedUsers.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle" id="connectedDevicesTable" style="width:100%">
                    <thead class="bg-light">
                      <tr>
                        <th>Hostname</th>
