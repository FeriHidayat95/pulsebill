                        <th>MAC</th>
                        <th>Interface</th>
                        <th>Waktu</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% connectedUsers.forEach(function(user) { %>
                        <tr>
                          <td class="fw-medium"><i class="bi bi-phone me-2 text-secondary"></i><%= user.hostname %></td>
                          <td class="text-primary"><%= user.ip %></td>
                          <td class="font-monospace small text-muted"><%= user.mac %></td>
                          <td><span class="badge bg-secondary-subtle text-secondary border"><%= user.iface %></span></td>
                          <td class="small"><%= user.waktu %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="alert alert-warning mb-0 border-0 rounded-4 shadow-sm">
                  <i class="bi bi-exclamation-triangle me-2"></i>
                  Tidak ada perangkat yang sedang terhubung.
                </div>
