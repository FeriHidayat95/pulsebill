  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
  <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
  <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

  <script>
  $(document).ready(function() {
    // Inisialisasi DataTables
    if ($('#connectedDevicesTable').length) {
      $('#connectedDevicesTable').DataTable({
        responsive: true, language: { url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/id.json' },
        dom: '<"top"f>rt<"bottom"lip><"clear">', ordering: true, info: true, paging: true, pageLength: 5,
        lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "Semua"]], columnDefs: [{ targets: '_all', className: 'align-middle' }]
      });
    }
    if ($('#invoicesTable').length) {
      $('#invoicesTable').DataTable({
        responsive: true, language: { url: '//cdn.datatables.net/plug-ins/1.13.4/i18n/id.json' },
        dom: '<"top"f>rt<"bottom"lip><"clear">', ordering: true, info: true, paging: true, pageLength: 5,
        lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "Semua"]], columnDefs: [{ targets: '_all', className: 'align-middle' }]
      });
    }

    // Animasi Desktop
    $('.stat-card').each(function(index) { $(this).addClass('animate__animated animate__fadeInUp').css('animation-delay', (index * 0.1) + 's'); });
    $('.form-section').each(function(index) { $(this).addClass('animate__animated animate__fadeInUp').css('animation-delay', ((index + 8) * 0.1) + 's'); });
    $('.table-container').each(function(index) { $(this).addClass('animate__animated animate__fadeInUp').css('animation-delay', (1.3 + (index * 0.1)) + 's'); });

    // Toast Function (Modern)
    function showToast(type, title, message, duration = 5000) {
      const toastId = 'toast-' + Date.now();
      const iconClass = type === 'success' ? 'bi-check-circle' : type === 'error' ? 'bi-x-circle' : 'bi-info-circle';
      const bgClass = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-primary';
      const toastHtml = `
        <div id="${toastId}" class="toast align-items-center text-white ${bgClass} border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="position: fixed; top: 20px; right: 20px; z-index: 9999; min-width: 300px; border-radius: 12px;">
          <div class="d-flex"><div class="toast-body"><i class="bi ${iconClass} me-2 fs-5 align-middle"></i><strong>${title}</strong><br><small class="opacity-75">${message}</small></div><button type="button" class="btn-close btn-close-white me-3 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>
        </div>`;
      $('body').append(toastHtml);
      const toastElement = document.getElementById(toastId);
      const toast = new bootstrap.Toast(toastElement, { delay: duration });
      toast.show();
      toastElement.addEventListener('hidden.bs.toast', () => toastElement.remove());
    }

    // ==========================================
    // AJAX LOGIC (JALAN DI DESKTOP & MOBILE)
    // ==========================================

    // GANTI SSID
    $('#changeSsidBtn, .changeSsidBtnMob').on('click', function(e) {
      e.preventDefault();
      // Cek apakah yg diklik itu mobile atau desktop
      const isMobile = $(this).hasClass('changeSsidBtnMob');
      const newSsid = isMobile ? $('#newSsidMob').val().trim() : $('#newSsid').val().trim();
      
      if (!newSsid || newSsid.length < 3 || newSsid.length > 32) {
        showToast('error', 'Error', 'SSID harus berisi 3-32 karakter!');
        return;
      }
      
      const $btn = $(this);
      const originalText = $btn.html();
      $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Proses...');
      
      $.ajax({
        url: '/customer/api/change-ssid', method: 'POST', data: { ssid: newSsid },
        success: function(res) {
          if (res.success) {
            showToast('success', 'Berhasil!', `WiFi 2.4GHz: ${res.newSSID} sedang diupdate.`);
            if(isMobile) $('#newSsidMob').val(''); else $('#newSsid').val('');
            
            $('.stat-value').each(function() {
              if ($(this).prev('.stat-label').text() === 'SSID Saat Ini' || $(this).prev('.mob-text-muted').text() === 'Nama WiFi (SSID)') {
                $(this).text(res.newSSID);
              }
            });
            setTimeout(() => $btn.prop('disabled', false).html(originalText), 2000);
          } else {
            showToast('error', 'Gagal', res.message || 'Gagal mengubah SSID!');
            $btn.prop('disabled', false).html(originalText);
          }
        },
        error: function(err) {
          showToast('error', 'Error Server', err.responseJSON?.message || 'Gagal mengubah SSID!');
          $btn.prop('disabled', false).html(originalText);
        }
      });
    });

    // GANTI PASSWORD
    $('#changePasswordBtn, .changePasswordBtnMob').on('click', function(e) {
      e.preventDefault();
      const isMobile = $(this).hasClass('changePasswordBtnMob');
      const newPassword = isMobile ? $('#newPasswordMob').val().trim() : $('#newPassword').val().trim();
      
      if (!newPassword || newPassword.length < 8 || newPassword.length > 63) {
        showToast('error', 'Error', 'Password harus minimal 8 karakter!');
        return;
      }
      
      const $btn = $(this);
      const originalText = $btn.html();
      $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Proses...');
      
      $.ajax({
        url: '/customer/api/change-password', method: 'POST', data: { password: newPassword },
        success: function(res) {
          if (res.success) {
            showToast('success', 'Berhasil!', `Password WiFi sedang diupdate.`);
            if(isMobile) $('#newPasswordMob').val(''); else $('#newPassword').val('');
            setTimeout(() => $btn.prop('disabled', false).html(originalText), 2000);
          } else {
            showToast('error', 'Gagal', res.message || 'Gagal mengubah password!');
            $btn.prop('disabled', false).html(originalText);
          }
        },
        error: function(err) {
          showToast('error', 'Error Server', err.responseJSON?.message || 'Gagal mengubah password!');
          $btn.prop('disabled', false).html(originalText);
        }
      });
    });

    // RESTART MODAL & LOGIC
    const restartModalEl = document.getElementById('restartModal');
    let restartModal = null;
    if(restartModalEl) restartModal = new bootstrap.Modal(restartModalEl);

    // Buka modal restart (berlaku buat tombol desktop & mobile)
    $('#restartDeviceBtn, .restartDeviceBtnMob').on('click', function() {
      if(restartModal) restartModal.show();
    });

    $('#confirmRestart').on('click', function() {
      if(restartModal) restartModal.hide();
      showToast('info', 'Memproses...', 'Sedang mengirim perintah restart ke router...');
      
      $.post('/customer/restart-device', function(response) {
        showToast('success', 'Berhasil!', response.message);
      }).fail(function(error) {
        showToast('error', 'Gagal', error.responseJSON ? error.responseJSON.message : 'Terjadi kesalahan sistem');
      });
    });

    // Quick Pay Logic
    $('input[name="selectedInvoice"]').on('change', function() {
      $('#proceedPayBtn').prop('disabled', false);
    });
    $('#proceedPayBtn').on('click', function() {
      const selectedInvoice = $('input[name="selectedInvoice"]:checked');
      if (selectedInvoice.length === 0) { showToast('error', 'Error', 'Pilih tagihan dulu!'); return; }
      window.location.href = `/customer/billing/invoices/${selectedInvoice.val()}`;
    });

  });

  // Dark Mode Mobile
  const mobLayout = document.querySelector('.mobile-layout');
  const themeIconMob = document.getElementById('themeIconMob');
  const savedMobTheme = localStorage.getItem('mobTheme') || 'light';
  setThemeMob(savedMobTheme);

  function toggleThemeMob() {
      const currentTheme = mobLayout.getAttribute('data-theme');
      setThemeMob(currentTheme === 'light' ? 'dark' : 'light');
  }

  function setThemeMob(theme) {
      mobLayout.setAttribute('data-theme', theme);
      localStorage.setItem('mobTheme', theme);
      if(theme === 'dark') {
          themeIconMob.className = 'bi bi-sun-fill text-warning fs-4';
      } else {
          themeIconMob.className = 'bi bi-moon-fill fs-4';
      }
  }
  </script>
  
  <div class="modal fade" id="qrisModal" tabindex="-1" aria-labelledby="qrisModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content border-0 shadow-lg rounded-4" style="background-color: var(--surface-color, #fff);">
        <div class="modal-header border-bottom-0 pb-0">
          <h6 class="modal-title fw-bold text-primary" id="qrisModalLabel"><i class="bi bi-qr-code-scan me-2"></i>Scan QRIS</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-center pt-2 pb-4">
            
            <div class="bg-white p-3 rounded-4 border d-inline-block shadow-sm mb-3 mt-2">
                <img src="/img/ewallet.jpg" onerror="this.onerror=null; this.src='/img/logo.png';" alt="QR Code Pembayaran" class="img-fluid rounded-3" style="max-width: 180px;">
            </div>
            
            <h6 class="fw-bold mb-1">A/N: <%= typeof appSettings !== 'undefined' ? appSettings.payment_account_holder : 'PulseBill Technologies Inc.' %></h6>
            <p class="small text-muted mb-0" style="font-size: 11px;">Gunakan aplikasi M-Banking atau E-Wallet (DANA, OVO, GoPay) untuk scan kode di atas.</p>
        </div>
      </div>
    </div>
  </div>
  
</body>
</html>